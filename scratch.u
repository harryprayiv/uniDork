Subs.subtitleExtensions : [Text]
Subs.subtitleExtensions = [".srt", ".ass", ".ssa", ".sub", ".idx", ".vtt", ".sup"]

Subs.isSubtitleFile : Text -> Boolean
Subs.isSubtitleFile name =
  lower = Text.toLowercase name
  List.any (e -> endsWith e lower) subtitleExtensions

Subs.subExt : Text -> Text
Subs.subExt name =
  lower = Text.toLowercase name
  match List.find (e -> endsWith e lower) subtitleExtensions with
    Some e        -> e
    Optional.None -> ""

Subs.subDirNames : [Text]
Subs.subDirNames = ["subs", "subtitles", "sub"]

Subs.langAliasSet : Text -> [Text]
Subs.langAliasSet l =
  use List +:
  low = normLang l
  match Relang.toIso6392 low with
    Some iso3     -> List.distinctText (low +: (iso3 +: titleAliases iso3))
    Optional.None -> [low]

Subs.detectLang : [Text] -> Text -> Optional Text
Subs.detectLang langs name =
  use Universal eq
  tokens = splitMany titleSeparators (Text.toLowercase (basenameNoExt name))
  hit l = List.any (t -> List.any (a -> eq a t) (langAliasSet l)) tokens
  List.find hit langs

Subs.freeUndPath : FilePath -> Text -> Text ->{IO, Exception} Optional FilePath
Subs.freeUndPath targetFolder base ext =
  use Nat + >=
  use Text ++
  go n =
    name =
      if Universal.eq n 1 then base ++ ".und" ++ ext
      else base ++ ".und." ++ Nat.toText n ++ ext
    fp = pathJoin targetFolder name
    if pathExists fp then (if n >= 9 then Optional.None else go (n + 1))
    else Some fp
  go 1

Subs.harvestLocal :
  [Text] -> Text -> FilePath -> Text ->{IO, Exception} [Text]
Subs.harvestLocal langs sourceFolderText targetFolder base =
  use List :+
  use Text ++
  use Universal eq
  sourceFolder = FilePath sourceFolderText
  subs = collectLocalSubs sourceFolder
  step acc = cases
    (fp, name) ->
      ext = subExt name
      match detectLang langs name with
        Some l ->
          code = normLang l
          dest = pathJoin targetFolder (base ++ "." ++ code ++ ext)
          already = List.any (s -> eq s code) acc
          if pathExists dest then (if already then acc else acc :+ code)
          else
            match catch do renameFile fp dest with
              Right _ ->
                _ =
                  printLine
                    ("    SUB local " ++ code ++ " -> " ++ filePathText dest)
                if already then acc else acc :+ code
              Left f ->
                _ =
                  printLine
                    ("    SUB local move failed: " ++ Failure.message f)
                acc
        Optional.None ->
          match freeUndPath targetFolder base ext with
            Optional.None -> acc
            Some dest     ->
              match catch do renameFile fp dest with
                Right _ ->
                  _ =
                    printLine
                      ("    SUB local (unknown lang) -> "
                        ++ filePathText dest)
                  acc
                Left f ->
                  _ =
                    printLine
                      ("    SUB local move failed: " ++ Failure.message f)
                  acc
  List.foldLeft step [] subs

Subs.looksRateLimited : Text -> Boolean
Subs.looksRateLimited e =
  lower = Text.toLowercase e
  containsText "429" lower
    || containsText "too many" lower
    || containsText "rate" lower

Subs.withThrottle :
  Nat -> '{IO, Exception} Either Text a ->{IO, Exception} Either Text a
Subs.withThrottle delayMs op =
  use Nat * + 
  go attempt waitMs =
    _ = concurrent.sleepMicroseconds (waitMs * 1000)
    match op() with
      Right v -> Right v
      Left e  ->
        if looksRateLimited e && (attempt < 3) then go (attempt + 1) (waitMs * 4)
        else Left e
  go 1 delayMs

Subs.saveOneLanguage :
  Nat -> FilePath -> Text -> [UnpackFile] -> Text ->{IO, Exception} SaveOutcome
Subs.saveOneLanguage delayMs targetDir baseName allFiles lang =
  use Text ++
  langCode = normLang lang
  match pickUnpackForLanguage lang allFiles with
    Optional.None -> SaveOutcome.NotFound langCode
    Some uf       ->
      match withThrottle delayMs (do downloadUnpackRaw uf) with
        Left err   -> Errored langCode err
        Right body ->
          ext = normLang (UnpackFile.format uf)
          filename = baseName ++ "." ++ langCode ++ "." ++ ext
          path = pathJoin targetDir filename
          match catch do writeFileUtf8 path body with
            Left f  -> Errored langCode (Failure.message f)
            Right _ -> Saved langCode (filePathText path)

Subs.fetchAndSaveByImdb :
  Text
  -> Nat
  -> Text
  -> FilePath
  -> Text
  -> [Text]
  ->{IO, Exception} [SaveOutcome]
Subs.fetchAndSaveByImdb apiKey delayMs imdbId targetDir baseName langs =
  use List map
  langsParam = languagesParam langs
  match withThrottle delayMs (do searchByImdb apiKey imdbId langsParam) with
    Left err   -> map (l -> Errored (normLang l) err) langs
    Right resp ->
      allFiles = allUnpackFiles resp
      map (saveOneLanguage delayMs targetDir baseName allFiles) langs

Subs.fetchAndSaveByTmdb :
  Text
  -> Nat
  -> Nat
  -> FilePath
  -> Text
  -> [Text]
  ->{IO, Exception} [SaveOutcome]
Subs.fetchAndSaveByTmdb apiKey delayMs tmdbId targetDir baseName langs =
  use List map
  langsParam = languagesParam langs
  match withThrottle delayMs (do searchByTmdb apiKey tmdbId langsParam) with
    Left err   -> map (l -> Errored (normLang l) err) langs
    Right resp ->
      allFiles = allUnpackFiles resp
      map (saveOneLanguage delayMs targetDir baseName allFiles) langs

Rename.maybeFetchSubsM :
  Optional Text
  -> Nat
  -> [Text]
  -> MovieRecord
  -> FilePath
  -> Text
  ->{IO, Exception} ()
Rename.maybeFetchSubsM maybeToken delayMs missingLangs m targetFolder base =
  match maybeToken with
    Optional.None -> ()
    Some token ->
      if Universal.eq (List.size missingLangs) 0 then ()
      else
        outcomes =
          match MovieRecord.imdbId m with
            Some imdb ->
              fetchAndSaveByImdb
                token delayMs imdb targetFolder base missingLangs
            Optional.None ->
              fetchAndSaveByTmdb
                token
                delayMs
                (MovieRecord.tmdbId m)
                targetFolder
                base
                missingLangs
        logSubOutcomes outcomes

Rename.executeOne :
  Boolean
  -> Text
  -> Text
  -> [FormatPart]
  -> [FormatPart]
  -> Optional Text
  -> [Text]
  -> Nat
  -> RenameRow
  ->{IO, Exception, RenameCatalog} Rename.Outcome
Rename.executeOne
  dryRun
  targetRootText
  intakeRootText
  folderFmt
  fileFmt
  subsToken
  subLangs
  delayMs
  row =
  use Failure message
  use Optional None
  use ProbeResult sizeBytes
  use Text ++
  use Universal eq
  use unison_json_1_4_2.Decoder run
  crc = RenameRow.crc32 row
  sourceText = RenameRow.originalPath row
  sourceVideo = FilePath sourceText
  sourceFolderText = filePathText (parentDir sourceVideo)
  m = toMovieRecord row
  prParsed = catch do run ProbeResult.fromJson (RenameRow.probeJson row)
  match prParsed with
    Left f -> RenameError sourceText (message f)
    Right pr ->
      nfoText = match catch do run Details.fromJson (detailsJson row) with
        Right d -> Nfo.generate (resultFromDetails d) d pr
        Left _  -> minimalNfoM m crc
      videoExt = fileExt sourceText
      base = renderName fileFmt m pr
      targetFolderText = targetRootText ++ "/" ++ renderName folderFmt m pr
      targetFolder = FilePath targetFolderText
      targetVideo = pathJoin targetFolder (base ++ videoExt)
      targetNfo = pathJoin targetFolder (nfoBase base ++ ".nfo")
      targetVideoText = filePathText targetVideo
      tagged = crcTaggedEntries targetFolder crc
      match tagged with
        _ +: _ ->
          match firstSizeMatch targetFolder (sizeBytes pr) tagged with
            Some actualName ->
              actualPath = filePathText (pathJoin targetFolder actualName)
              if dryRun then WouldRemoveDuplicate sourceText actualPath
              else
                actualBase = basenameNoExt actualName
                _ =
                  if eq sourceFolderText intakeRootText then ()
                  else
                    _ = 
                      catch do
                        harvestLocal
                          subLangs sourceFolderText targetFolder actualBase
                    ()
                _ = catch do removeFile sourceVideo
                szInt = Nat.toInt (sizeBytes pr)
                _ =
                  promoteToBuffer
                    actualPath actualName actualBase targetFolderText crc szInt
                _ = match fileStat actualPath with
                  Some (mt, _) ->
                    upsertProbeCache
                      actualPath (effectiveMtime actualPath mt) pr
                  None -> ()
                _ = deleteProbeCache sourceText
                DuplicateRemoved sourceText actualPath
            None -> Conflict sourceText targetVideoText
        [] ->
          if Boolean.not (pathExists sourceVideo) then
            _ = match deviceOf intakeRootText with
              Some _ -> retireMissing sourceText
              None   -> ()
            NoVideo sourceText
          else
            if pathExists targetVideo then Conflict sourceText targetVideoText
            else
              if dryRun then WouldRename sourceText targetVideoText
              else
                fsOutcome = catch do
                  _ =
                    if isDirectory targetFolder then ()
                    else
                      _ = createDirectory targetFolder
                      ()
                  _ = writeFileUtf8 targetNfo nfoText
                  renameFile sourceVideo targetVideo
                match fsOutcome with
                  Right _ ->
                    localLangs =
                      if eq sourceFolderText intakeRootText then []
                      else
                        match 
                          catch do
                            harvestLocal
                              subLangs sourceFolderText targetFolder base
                         with
                          Right ls -> ls
                          Left _   -> []
                    missing =
                      List.filter
                        (l ->
                          Boolean.not
                            (List.any
                              (s -> eq s (normLang l)) localLangs))
                        subLangs
                    _ = 
                      catch do
                        maybeFetchSubsM
                          subsToken delayMs missing m targetFolder base
                    newName = base ++ videoExt
                    szInt = Nat.toInt (sizeBytes pr)
                    _ =
                      promoteToBuffer
                        targetVideoText newName base targetFolderText crc szInt
                    _ = match fileStat targetVideoText with
                      Some (mt, _) ->
                        upsertProbeCache
                          targetVideoText
                          (effectiveMtime targetVideoText mt)
                          pr
                      None -> ()
                    _ = deleteProbeCache sourceText
                    Renamed sourceText targetVideoText
                  Left f -> RenameError sourceText (message f)

Rename.runStep :
  Boolean
  -> Text
  -> Text
  -> [FormatPart]
  -> [FormatPart]
  -> Optional Text
  -> [Text]
  -> Nat
  -> RenameRow
  ->{IO, Exception, RenameCatalog} ()
Rename.runStep
  dryRun
  targetRootText
  intakeRootText
  folderFmt
  fileFmt
  subsToken
  subLangs
  delayMs
  row =
  use Text ++
  crc = RenameRow.crc32 row
  sourceText = RenameRow.originalPath row
  _ = printLine ("processing: " ++ sourceText)
  _ =
    match priorTargetForCrc crc with
      Some prior ->
        printLine ("  note: previously renamed this file -> " ++ prior)
      Optional.None -> ()
  outcome =
    executeOne
      dryRun
      targetRootText
      intakeRootText
      folderFmt
      fileFmt
      subsToken
      subLangs
      delayMs
      row
  match outcome with
    Renamed _ tgt -> printLine ("  RENAMED -> " ++ tgt)
    WouldRename _ tgt -> printLine ("  DRY-RUN: would rename -> " ++ tgt)
    DuplicateRemoved _ tgt ->
      printLine ("  DUPLICATE -> source removed (already at " ++ tgt ++ ")")
    WouldRemoveDuplicate _ tgt ->
      printLine
        ("  DRY-RUN: would remove source as verified duplicate of " ++ tgt)
    NoVideo src -> printLine ("  RETIRED (source gone): " ++ src)
    NoProbe src -> printLine ("  SKIP: no probe for " ++ src)
    NoMatch src reason ->
      printLine ("  SKIP: no match for " ++ src ++ " (" ++ reason ++ ")")
    Conflict _ t -> printLine ("  SKIP: different file already at " ++ t)
    AlreadyDone src -> printLine ("  SKIP: already done " ++ src)
    RenameError _ msg -> printLine ("  ERROR: " ++ msg)

Rename.runNew : Config -> Text -> Text -> Boolean -> '{IO, Exception} ()
Rename.runNew cfg folderFmtText fileFmtText dryRun =
  do
    use Nat + toText
    use Text ++
    folderFmt = parseFormat folderFmtText
    fileFmt = parseFormat fileFmtText
    subsToken = match catch do readSubToken cfg with
      Right t -> Some t
      Left _  -> Optional.None
    targetRootText = buffer (paths cfg)
    intakeRootText = intake (paths cfg)
    subLangs = Tuning.subLangs (tuning cfg)
    delayMs = subDelayMs (tuning cfg)
    _ =
      if dryRun then
        printLine
          "[rename] DRY RUN: no files will be created, moved, or deleted"
      else
        if isDirectory (FilePath targetRootText) then ()
        else
          _ = catch do createDirectory (FilePath targetRootText)
          ()
    runChunk lastId = 
      myPg.singleIO (toClientConfig cfg) do
        pqRows = prepareQuery selectRenamableChunkSql
        pcPromote = prepareCommand promoteToBufferSql
        pcCache = prepareCommand upsertProbeCacheSql
        pcDelCache = prepareCommand deleteProbeCacheSql
        pcRetire = prepareCommand retireMissingSql
        pqProposed = prepareQuery selectProposedSql
        rowsResult = catch do
          portal = bindQuery pqRows (pobi (Some lastId))
          (rs, _) = executeQueryPortal portal 0
          rs
        rows = match rowsResult with
          Left f   ->
            _ = printLine ("[rename] QUERY FAILED: " ++ Failure.message f)
            []
          Right rs -> List.map rowToRenameRowK rs
        let
          use List ++
          renameGo = cases
            { r } -> r
            { priorTargetForCrc crc -> k } ->
              handle k (findPriorTargetForCrcWith pqProposed crc) with renameGo
            { promoteToBuffer path name base folder crc size -> k } ->
              _ = 
                catch do
                  bindAndExecuteCommand
                    pcPromote
                    (pt path
                      ++ pt name
                      ++ pt base
                      ++ pt folder
                      ++ pt crc
                      ++ pobi (Some size))
              handle k() with renameGo
            { upsertProbeCache path mt pr -> k } ->
              _ = upsertProbeCacheWith pcCache path mt pr
              handle k() with renameGo
            { deleteProbeCache path -> k } ->
              _ = catch do bindAndExecuteCommand pcDelCache (pt path)
              handle k() with renameGo
            { retireMissing path -> k } ->
              _ = catch do bindAndExecuteCommand pcRetire (pt path)
              handle k() with renameGo
          runOne = cases
            (_, row) ->
              handle
                runStep
                  dryRun
                  targetRootText
                  intakeRootText
                  folderFmt
                  fileFmt
                  subsToken
                  subLangs
                  delayMs
                  row
              with renameGo
          _ = Db.foreach_ runOne rows
          _ = PreparedQuery.close pqRows
          _ = PreparedCommand.close pcPromote
          _ = PreparedCommand.close pcCache
          _ = PreparedCommand.close pcDelCache
          _ = PreparedCommand.close pcRetire
          _ = PreparedQuery.close pqProposed
          match lastOf rows with
            Some (fid, _) -> Some (fid, List.size rows)
            Optional.None -> Optional.None
    loop lastId done = match runChunk lastId with
      Optional.None    -> done
      Some (nextId, n) ->
        _ =
          printLine
            ("[rename] chunk done ("
              ++ toText n
              ++ " file(s), cursor at file_id "
              ++ Int.toText nextId
              ++ ")")
        loop nextId (done + n)
    total = loop +0 0
    printLine ("[rename] done (" ++ toText total ++ " file(s))")

Tv.Rename.executeEpisode :
  Boolean
  -> PreparedQuery r1 a1 Text
  -> PreparedQuery r a Text
  -> Text
  -> Text
  -> [FormatPart]
  -> [FormatPart]
  -> [FormatPart]
  -> [Text]
  -> EpisodeJob
  ->{IO, Exception, Postgres, RenameCatalog} TvRenameOutcome
Tv.Rename.executeEpisode
  dryRun
  pqShow
  pqSeason
  intakeRoot
  bufferRoot
  showFmt
  seasonFmt
  fileFmt
  subLangs
  job =
  use Boolean not
  use Failure message
  use Optional None
  use ProbeResult sizeBytes
  use Text ++
  use Universal eq
  use unison_json_1_4_2.Decoder run
  crc = EpisodeJob.crc32 job
  sourceText = EpisodeJob.originalPath job
  sourceFolderText = filePathText (parentDir (FilePath sourceText))
  showId = EpisodeJob.showId job
  if not (enforceUnderRoot intakeRoot sourceText) then
    EpOutsideRoot sourceText intakeRoot
  else
    pjson = EpisodeJob.probeJson job
    match catch do run ProbeResult.fromJson pjson with
      Left f -> EpBadProbe sourceText (message f)
      Right pr ->
        showFolder = renderEpisode showFmt job pr
        seasonFolder = renderEpisode seasonFmt job pr
        base = renderEpisode fileFmt job pr
        showDirText = bufferRoot ++ "/" ++ showFolder
        seasonDirText = showDirText ++ "/" ++ seasonFolder
        videoExt = fileExt sourceText
        targetVideoText = seasonDirText ++ "/" ++ base ++ videoExt
        sourceVideo = FilePath sourceText
        if not (enforceUnderRoot bufferRoot seasonDirText) then
          EpOutsideRoot targetVideoText bufferRoot
        else
          tagged = crcTaggedEntries (FilePath seasonDirText) crc
          match tagged with
            _ +: _ ->
              match firstSizeMatch
                (FilePath seasonDirText) (sizeBytes pr) tagged with
                Some actualName ->
                  actualPath = seasonDirText ++ "/" ++ actualName
                  if dryRun then
                    EpWouldRemoveDuplicate sourceText actualPath
                  else
                    actualBase = basenameNoExt actualName
                    _ =
                      if eq sourceFolderText intakeRoot then ()
                      else
                        _ = 
                          catch do
                            harvestLocal
                              subLangs
                              sourceFolderText
                              (FilePath seasonDirText)
                              actualBase
                        ()
                    _ = catch do removeFile sourceVideo
                    szInt = Nat.toInt (sizeBytes pr)
                    _ =
                      promoteToBuffer
                        actualPath
                        actualName
                        actualBase
                        seasonDirText
                        crc
                        szInt
                    _ = match fileStat actualPath with
                      Some (mt, _) ->
                        upsertProbeCache
                          actualPath (effectiveMtime actualPath mt) pr
                      None -> ()
                    _ = deleteProbeCache sourceText
                    EpDuplicateRemoved sourceText actualPath
                None -> EpConflict sourceText targetVideoText
            [] ->
              if not (pathExists sourceVideo) then
                _ = match deviceOf intakeRoot with
                  Some _ -> retireMissing sourceText
                  None   -> ()
                EpNoVideo sourceText
              else
                if pathExists (FilePath targetVideoText) then
                  EpConflict sourceText targetVideoText
                else
                  if dryRun then EpWouldRename sourceText targetVideoText
                  else
                    seasonBody =
                      readSeasonBodyWith
                        pqSeason showId (EpisodeJob.season job)
                    seasonOpt = match seasonBody with
                      None      -> None
                      Some body ->
                        match catch do run Season.fromJson body with
                          Right s -> Some s
                          Left _  -> None
                    showNfoText = match readShowBodyWith pqShow showId with
                      None      -> minimalShowNfo showId (showName job)
                      Some body ->
                        match catch do run ShowDetails.fromJson body with
                          Right d -> generateShowNfo d
                          Left _  -> minimalShowNfo showId (showName job)
                    epNfoText = episodeNfoFor seasonOpt job pr
                    fsOutcome = 
                      catch do
                        _ = ensureDir showDirText
                        _ = ensureDir seasonDirText
                        tvshowNfo = FilePath (showDirText ++ "/tvshow.nfo")
                        _ =
                          if pathExists tvshowNfo then ()
                          else writeFileUtf8 tvshowNfo showNfoText
                        _ =
                          writeFileUtf8
                            (FilePath (seasonDirText ++ "/" ++ base ++ ".nfo"))
                            epNfoText
                        renameFile sourceVideo (FilePath targetVideoText)
                    match fsOutcome with
                      Right _ ->
                        _ =
                          if eq sourceFolderText intakeRoot then ()
                          else
                            _ = 
                              catch do
                                harvestLocal
                                  subLangs
                                  sourceFolderText
                                  (FilePath seasonDirText)
                                  base
                            ()
                        newName = base ++ videoExt
                        szInt = Nat.toInt (sizeBytes pr)
                        _ =
                          promoteToBuffer
                            targetVideoText
                            newName
                            base
                            seasonDirText
                            crc
                            szInt
                        _ =
                          match fileStat targetVideoText with
                            Some (mt, _) ->
                              upsertProbeCache
                                targetVideoText
                                (effectiveMtime targetVideoText mt)
                                pr
                            None -> ()
                        _ = deleteProbeCache sourceText
                        EpRenamed sourceText targetVideoText
                      Left f -> EpError sourceText (message f)

Tv.Rename.applyTv : Config -> Boolean -> '{IO, Exception} ()
Tv.Rename.applyTv cfg dryRun =
  do
    use Nat + toText
    use Optional None
    use Text ++
    intakeRoot = tvIntake (paths cfg)
    bufferRoot = tvBuffer (paths cfg)
    subLangs = Tuning.subLangs (tuning cfg)
    match splitTvFormat (tvFormat (paths cfg)) with
      None ->
        printLine
          "[tv-rename] tvFormat must be exactly show/season/file (two '/')"
      Some (showFmt, seasonFmt, fileFmt) ->
        _ =
          if dryRun then
            printLine
              "[tv-rename] DRY RUN: no files will be created, moved, or deleted"
          else
            if isDirectory (FilePath bufferRoot) then ()
            else
              _ = catch do createDirectory (FilePath bufferRoot)
              ()
        runChunk lastId = 
          myPg.singleIO (toClientConfig cfg) do
            pqIds = prepareQuery selectEpisodeFileIdsSql
            pqRows = prepareQuery selectEpisodeRenamableChunkSql
            pqShow = prepareQuery selectShowSql
            pqSeason = prepareQuery selectSeasonSql
            pcPromote = prepareCommand promoteToBufferSql
            pcCache = prepareCommand upsertProbeCacheSql
            pcDelCache = prepareCommand deleteProbeCacheSql
            pcRetire = prepareCommand retireMissingSql
            closeAll _u =
              _ = PreparedQuery.close pqIds
              _ = PreparedQuery.close pqRows
              _ = PreparedQuery.close pqShow
              _ = PreparedQuery.close pqSeason
              _ = PreparedCommand.close pcPromote
              _ = PreparedCommand.close pcCache
              _ = PreparedCommand.close pcDelCache
              PreparedCommand.close pcRetire
            idsResult = catch do
              portal = bindQuery pqIds (pobi (Some lastId))
              (rs, _) = executeQueryPortal portal 0
              rs
            ids = match idsResult with
              Left f   ->
                _ =
                  printLine
                    ("[tv-rename] ID QUERY FAILED: " ++ Failure.message f)
                []
              Right rs -> rs
            match lastOf ids with
              None ->
                _ = closeAll()
                None
              Some upperId ->
                rowsResult = catch do
                  use List ++
                  portal =
                    bindQuery
                      pqRows (pobi (Some lastId) ++ pobi (Some upperId))
                  (rs, _) = executeQueryPortal portal 0
                  rs
                rows = match rowsResult with
                  Left f   ->
                    _ =
                      printLine
                        ("[tv-rename] QUERY FAILED: " ++ Failure.message f)
                    []
                  Right rs -> rs
                jobs = groupJobs rows
                let
                  renameGo = cases
                    { r } -> r
                    { priorTargetForCrc _ -> k } -> handle k None with renameGo
                    { promoteToBuffer path name base folder crc size -> k } ->
                      use List ++
                      _ = 
                        catch do
                          bindAndExecuteCommand
                            pcPromote
                            (pt path
                              ++ pt name
                              ++ pt base
                              ++ pt folder
                              ++ pt crc
                              ++ pobi (Some size))
                      handle k() with renameGo
                    { upsertProbeCache path mt pr -> k } ->
                      _ = upsertProbeCacheWith pcCache path mt pr
                      handle k() with renameGo
                    { deleteProbeCache path -> k } ->
                      _ = catch do bindAndExecuteCommand pcDelCache (pt path)
                      handle k() with renameGo
                    { retireMissing path -> k } ->
                      _ = catch do bindAndExecuteCommand pcRetire (pt path)
                      handle k() with renameGo
                  step job =
                    _ =
                      printLine ("processing: " ++ EpisodeJob.originalPath job)
                    outcome =
                      handle
                        executeEpisode
                          dryRun
                          pqShow
                          pqSeason
                          intakeRoot
                          bufferRoot
                          showFmt
                          seasonFmt
                          fileFmt
                          subLangs
                          job
                      with renameGo
                    printTvOutcome outcome
                  _ = Db.foreach_ step jobs
                  _ = closeAll()
                  Some (upperId, List.size jobs)
        loop lastId done = match runChunk lastId with
          None             -> done
          Some (nextId, n) ->
            _ =
              printLine
                ("[tv-rename] chunk done ("
                  ++ toText n
                  ++ " file(s), cursor at file_id "
                  ++ Int.toText nextId
                  ++ ")")
            loop nextId (done + n)
        total = loop +0 0
        printLine ("[tv-rename] done (" ++ toText total ++ " file(s))")

subDemo : '{IO, Exception} ()
subDemo = do
  cfg = fromEnv()
  token = readSubToken cfg
  outcomes =
    fetchAndSaveByImdb
      token 2000 "tt1375666" (FilePath "/tmp/subs-test") "inception"
      ["en", "es", "th"]
  logSubOutcomes outcomes

Subs.subsInDir : FilePath -> Text ->{IO, Exception} [(FilePath, Text)]
Subs.subsInDir folder dirName =
  dfp = pathJoin folder dirName
  match catch do directoryContents.texts dfp with
    Left _    -> []
    Right es2 ->
      List.filterMap
        (n ->
          (if isSubtitleFile n then Some (pathJoin dfp n, n)
          else Optional.None))
        es2

Subs.collectLocalSubs : FilePath ->{IO, Exception} [(FilePath, Text)]
Subs.collectLocalSubs folder =
  use List ++
  use Universal eq
  entries = match catch do directoryContents.texts folder with
    Left _   -> []
    Right es -> es
  real = List.filter (n -> Boolean.not (eq n "." || eq n "..")) entries
  here =
    List.filterMap
      (n ->
        (if isSubtitleFile n && Boolean.not (isDirectory (pathJoin folder n))
        then Some (pathJoin folder n, n)
        else Optional.None))
      real
  subdirs =
    List.filter
      (n ->
        List.any (d -> eq d (Text.toLowercase n)) subDirNames
          && isDirectory (pathJoin folder n))
      real
  deeper = List.flatMap (Subs.subsInDir folder) subdirs
  here ++ deeper