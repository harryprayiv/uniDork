Config.readSubToken : Config ->{IO, Exception} Text
Config.readSubToken cfg =
  Text.trim (readFileUtf8 (FilePath (subToken (paths cfg))))

Config.toClientConfig : Config -> PostgresClientConfig
Config.toClientConfig cfg =
  d = db cfg
  PostgresClientConfig.default
    (HostName (Db.host d)) (UserName (Db.user d)) (DatabaseName (Db.name d))
    |> PostgresClientConfig.port.set (Port (Db.port d))

Subs.Fix.selectBufferMoviesSql :
  postgres.Query
    r r ((((Text, Text), Optional Text), Int), Optional Int)
Subs.Fix.selectBufferMoviesSql =
  use Codec optional text
  sql
    "SELECT f.proposed_folder, f.proposed_name, m.imdb_id, m.tmdb_id, m.year FROM files f JOIN associations a ON a.file_id = f.file_id JOIN movies m ON m.tmdb_id = a.tmdb_id WHERE f.stage = 'buffer' AND f.media_kind = 'movie' AND f.proposed_folder IS NOT NULL AND f.proposed_name IS NOT NULL ORDER BY f.file_id"
    |> typedQuery
      (text ~ text ~ optional text ~ integer ~ optional integer)

Subs.Fix.hasSidecarFor : [Text] -> Text -> Text -> Boolean
Subs.Fix.hasSidecarFor entries base lang =
  use Text ++
  prefix = base ++ "." ++ normLang lang ++ "."
  List.any (n -> startsWith prefix n) entries

Subs.Fix.missingLangs : FilePath -> Text -> [Text] ->{IO} [Text]
Subs.Fix.missingLangs folder base langs =
  match catch do directoryContents.texts folder with
    Left _        -> []
    Right entries ->
      List.filter
        (l -> Boolean.not (hasSidecarFor entries base l)) langs

Subs.Fix.checkOneRow :
  Optional Text
  -> [Text]
  -> Nat
  -> Boolean
  -> ((((Text, Text), Optional Text), Int), Optional Int)
  ->{IO, Exception} Nat
Subs.Fix.checkOneRow tokenOpt subLangs delayMs dryRun row =
  use Optional None
  use Text ++
  ((((folderText, base), imdbOpt), tmdbInt), _yr) = row
  folder = FilePath folderText
  if Boolean.not (isDirectory folder) then
    _ = printLine ("  SKIP (folder gone, run move or sweep): " ++ folderText)
    0
  else
    missing = missingLangs folder base subLangs
    match missing with
      [] -> 0
      _  ->
        _ =
          printLine
            ("  "
              ++ base
              ++ " missing: "
              ++ Text.join ", " (List.map normLang missing))
        if dryRun then 1
        else
          match tokenOpt with
            None -> 0
            Some token ->
              tmdbNat = Optional.getOrElse 0 (Nat.fromInt tmdbInt)
              outcomes = match imdbOpt with
                Some imdb ->
                  fetchAndSaveByImdb token delayMs imdb folder base missing
                None ->
                  fetchAndSaveByTmdb token delayMs tmdbNat folder base missing
              _ = logSubOutcomes outcomes
              1

Subs.Fix.run : Config -> Boolean ->{IO, Exception} ()
Subs.Fix.run cfg dryRun =
  use Nat + toText
  use Optional None
  use Text ++
  bufferRoot = buffer (paths cfg)
  subLangs = Tuning.subLangs (tuning cfg)
  delayMs = subDelayMs (tuning cfg)
  mountUp = match deviceOf bufferRoot with
    Some _ -> true
    None   -> false
  if Boolean.not mountUp then
    printLine ("[subs] buffer root not mounted, refusing: " ++ bufferRoot)
  else
    if Universal.eq (List.size subLangs) 0 then
      printLine "[subs] no languages configured (UNIDORK_TUNE_SUB_LANGS)"
    else
      tokenOpt = match catch do readSubToken cfg with
        Right t -> Some t
        Left _  -> None
      match (dryRun, tokenOpt) with
        (false, None) ->
          printLine
            ("[subs] no sub token readable at " ++ subToken (paths cfg))
        _ ->
          _ =
            if dryRun then
              printLine "[subs] DRY RUN: no files will be created"
            else ()
          myPg.singleIO (toClientConfig cfg) do
            pqRows = prepareQuery selectBufferMoviesSql
            rowsResult = catch do
              portal = bindQuery pqRows []
              (rs, _) = executeQueryPortal portal 0
              rs
            rows = match rowsResult with
              Left f   ->
                _ = printLine ("[subs] QUERY FAILED: " ++ Failure.message f)
                []
              Right rs -> rs
            _ =
              printLine
                ("[subs] "
                  ++ toText (List.size rows)
                  ++ " buffer movie(s) to check")
            step counts row =
              (checked, fetched) = counts
              n = checkOneRow tokenOpt subLangs delayMs dryRun row
              (checked + 1, fetched + n)
            (checked, fetched) = List.foldLeft step (0, 0) rows
            _ = PreparedQuery.close pqRows
            printLine
              ("[subs] done ("
                ++ toText checked
                ++ " checked, "
                ++ toText fetched
                ++ " with missing sidecars)")

type Config
  = { db : Db, cache : Cache, paths : Paths, tuning : Tuning }

type Config.Tuning
  = { probeJobs : Nat, subLangs : [Text], subDelayMs : Nat }

Config.fromEnv : '{IO} Config
Config.fromEnv =
  do
    use Text ++
    home = getEnvOr "HOME" "/home/bismuth"
    db =
      Db
        (getEnvOr "UNIDORK_DB_HOST" "localhost")
        (getEnvOr "UNIDORK_DB_PORT" "5434")
        (getEnvOr "UNIDORK_DB_USER" "postgres")
        (getEnvOr "UNIDORK_DB_NAME" "dork")
