Stage.selectFreshCacheSql : postgres.Query r r ((Text, Int), Int)
Stage.selectFreshCacheSql =
  sql
    "SELECT pc.original_path, pc.mtime, pc.size_bytes FROM probe_cache pc JOIN files f ON f.file_id = pc.file_id WHERE f.stage <> 'missing'"
    |> typedQuery (Codec.text ~ bigint ~ bigint)

Stage.cacheRowToPair : ((Text, Int), Int) -> (Text, (Int, Int))
Stage.cacheRowToPair = cases ((p, m), s) -> (p, (m, s))

Stage.loadFreshCache : Config ->{IO, Exception} Map Text (Int, Int)
Stage.loadFreshCache cfg =
  use Text ++
  myPg.singleIO (toClientConfig cfg) do
    pq = prepareQuery selectFreshCacheSql
    rowsResult = catch do
      portal = bindQuery pq []
      (rs, _) = executeQueryPortal portal 0
      rs
    _ = PreparedQuery.close pq
    match rowsResult with
      Left f   ->
        _ = printLine ("[probe] cache load failed: " ++ Failure.message f)
        Map.fromList []
      Right rs -> Map.fromList (List.map cacheRowToPair rs)

Stage.isCachedLocal : Map Text (Int, Int) -> Text -> Int -> Int -> Boolean
Stage.isCachedLocal cache path eff size =
  use Int >=
  match Map.get path cache with
    Optional.None  -> false
    Some (cm, cs) -> (cm >= eff) && Universal.eq cs size

Stage.sortBySize : [(Nat, (a, Text))] -> [(Nat, (a, Text))]
Stage.sortBySize items =
  bytesOf = cases (b, _) -> b
  List.reverse (List.sortBy bytesOf items)

Stage.partitionWork :
  Map Text (Int, Int) -> [(a, Text)] ->{IO, Exception} [(Nat, (a, Text))]
Stage.partitionWork cache work =
  use List +:
  use Nat % + toText
  use Text ++
  step acc item =
    (n, out) = acc
    (_, videoPath) = item
    n' = n + 1
    _ =
      if Universal.eq (n' % 200) 0 then
        printLine
          ("[probe] partition "
            ++ toText n'
            ++ " file(s), rss "
            ++ toText (rssMb())
            ++ " MB")
      else ()
    match fileStat videoPath with
      Optional.None -> (n', (0, item) +: out)
      Some (mt, sz) ->
        eff = effectiveMtime videoPath mt
        if isCachedLocal cache videoPath eff (Nat.toInt sz) then (n', out)
        else (n', (sz, item) +: out)
  (_, withSizes) = List.foldLeft step (0, []) work
  sortBySize withSizes

Stage.probeConnChunks : Nat
Stage.probeConnChunks = 10

Stage.runProbeAt : Config -> Text -> Text ->{IO, Exception} ()
Stage.runProbeAt cfg rootText stage =
  use List foldLeft size
  use Nat + - toText
  use PreparedCommand close
  use Text ++
  jobs = probeJobs (tuning cfg)
  root = FilePath rootText
  if isDirectory root then
    work = collectWork root
    _ =
      printLine
        ("[probe] "
          ++ rootText
          ++ " ("
          ++ stage
          ++ "): "
          ++ toText (size work)
          ++ " video(s) found")
    cache = loadFreshCache cfg
    toProbe = partitionWork cache work
    sumStep acc = cases (b, _) -> acc + b
    totalBytes = foldLeft sumStep 0 toProbe
    totalFiles = size toProbe
    _ =
      printLine
        (Text.join
          ""
          [ "[probe] to probe: "
          , toText totalFiles
          , " ("
          , gigabytes totalBytes
          , "), cached: "
          , toText (size work - totalFiles)
          ])
    counter = IO.ref (0, 0)
    startEpoch = epochSeconds()
    chunks = List.chunk jobs toProbe
    groups = List.chunk probeConnChunks chunks
    runGroup group = 
      myPg.singleIO (toClientConfig cfg) do
        pcFiles = prepareCommand Stage.upsertFileSql
        pcGate = prepareCommand upsertProbeCacheSql
        probeChunk chunk =
          chunkBytes = foldLeft sumStep 0 chunk
          items = List.map (cases (_, item) -> item) chunk
          _ = Stage.runChunk stage pcFiles pcGate items
          (dF, dB) = mutable.Ref.read counter
          _ = mutable.Ref.write counter (dF + size items, dB + chunkBytes)
          Progress.report "files" totalFiles totalBytes startEpoch counter
        _ = Db.foreach_ probeChunk group
        _ = close pcFiles
        close pcGate
    _ = Db.foreach_ runGroup groups
    printLine "[probe] done"
  else printLine ("[probe] root not found: " ++ rootText)

Tv.Stage.runProbeAtTv : Config -> Text -> Text ->{IO, Exception} ()
Tv.Stage.runProbeAtTv cfg rootText stage =
  use List foldLeft map size
  use Nat + - toText
  use PreparedCommand close
  use Text ++
  jobs = probeJobs (tuning cfg)
  root = FilePath rootText
  if isDirectory root then
    work = map (v -> ((), v)) (collectVideos root 0)
    _ =
      printLine
        ("[tv-probe] "
          ++ rootText
          ++ " ("
          ++ stage
          ++ "): "
          ++ toText (size work)
          ++ " video(s) found")
    cache = loadFreshCache cfg
    toProbe = partitionWork cache work
    sumStep acc = cases (b, _) -> acc + b
    totalBytes = foldLeft sumStep 0 toProbe
    totalFiles = size toProbe
    _ =
      printLine
        (Text.join
          ""
          [ "[tv-probe] to probe: "
          , toText totalFiles
          , " ("
          , gigabytes totalBytes
          , "), cached: "
          , toText (size work - totalFiles)
          ])
    counter = IO.ref (0, 0)
    startEpoch = epochSeconds()
    chunks = List.chunk jobs toProbe
    groups = List.chunk probeConnChunks chunks
    runGroup group = 
      myPg.singleIO (toClientConfig cfg) do
        pcFiles = prepareCommand Tv.Stage.upsertFileSql
        pcGate = prepareCommand upsertProbeCacheSql
        probeChunk chunk =
          chunkBytes = foldLeft sumStep 0 chunk
          items = map (cases (_, item) -> item) chunk
          _ = Tv.Stage.runChunk rootText stage pcFiles pcGate items
          (dF, dB) = mutable.Ref.read counter
          _ = mutable.Ref.write counter (dF + size items, dB + chunkBytes)
          Progress.report "files" totalFiles totalBytes startEpoch counter
        _ = Db.foreach_ probeChunk group
        _ = close pcFiles
        close pcGate
    _ = Db.foreach_ runGroup groups
    printLine "[probe] done"
  else printLine ("[tv-probe] root not found: " ++ rootText)