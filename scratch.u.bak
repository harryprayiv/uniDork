Actor.fromJson : '{unison_json_1_3_5.Decoder} Actor
Actor.fromJson = do
  use Decoder text
  use object at!
  name = at! "name" text
  role = at! "role" text
  Actor.Actor name role

Actor.toJson : Actor -> Json
Actor.toJson a =
  use Json text
  Json.object [("name", text (Actor.name a)), ("role", text (role a))]

Audio.fromJson : '{unison_json_1_3_5.Decoder} Audio
Audio.fromJson = do
  use Decoder text
  use object at!
  codec = at! "codec" text
  language = at! "language" text
  channels = at! "channels" Decoder.nat
  Audio.Audio codec language channels

Audio.toJson : Audio -> Json
Audio.toJson a =
  use Json text
  Json.object
    [ ("codec", text (Audio.codec a))
    , ("language", text (Audio.language a))
    , ("channels", Json.nat (Audio.channels a))
    ]

classifyPiece : Text -> FolderMeta -> FolderMeta
classifyPiece p m =
  if endsWith "min" p then FolderMeta.runtimeMin.set (parseNatBefore "min" p) m
  else
    if endsWith "p" p then resolution.set (Some p) m
    else
      if endsWith "b" p then FolderMeta.bitDepth.set (parseNatBefore "b" p) m
      else
        if endsWith "G" p then rawSize.set (Some p) m
        else
          if endsWith "M" p then rawSize.set (Some p) m
          else
            if startsWith "x" p then videoCodec.set (Some p) m
            else
              if startsWith "h" p then videoCodec.set (Some p) m
              else if startsWith "av" p then videoCodec.set (Some p) m else m

cli : '{IO, Exception} ()
cli =
  do
    use Optional None
    use Resolve runWith
    cfg = fromEnv()
    args = getArgs()
    match args with
      "import-library" +: _ -> batchedRun cfg
      "reconcile" +: _ -> runProbeAt cfg (buffer (paths cfg)) "buffer"
      "import-buffer" +: _ -> runProbeAt cfg (buffer (paths cfg)) "buffer"
      "import-all" +: _ ->
        _ = runProbeAt cfg (buffer (paths cfg)) "buffer"
        batchedRun cfg
      "process" +: rest ->
        dry = hasFlag "--dry-run" rest
        _ = runProbeStage cfg
        _ = runWith false cfg
        _ = renameNewCombined cfg (movieFormat (paths cfg)) dry ()
        doneMsg =
          if dry then
            "[process] dry run done. no files were created, moved, or deleted."
          else "[process] done. review the buffer, then: unidork move"
        printLine doneMsg
      "move" +: rest ->
        use Move run
        dry = hasFlag "--dry-run" rest
        match nonFlags rest with
          name +: _ -> run cfg (Some name) dry
          []        -> run cfg None dry
      "identify" +: _ -> runWith true cfg
      "resolve" +: _ -> runWith false cfg
      "probe-stage" +: _ -> runProbeStage cfg
      "rename" +: rest ->
        dry = hasFlag "--dry-run" rest
        match nonFlags rest with
          format +: _ -> renameNewCombined cfg format dry ()
          []          -> printLine "rename requires a format string"
      "tv-init" +: _ -> Tv.Db.createSchema cfg
      "tv-probe" +: _ -> runProbeTv cfg
      "tv-identify" +: _ -> identify cfg
      "tv-resolve" +: _ -> Resolve.run cfg
      "tv-rename" +: rest -> applyTv cfg (hasFlag "--dry-run" rest) ()
      "tv-move" +: rest ->
        use Tv.Move run
        dry = hasFlag "--dry-run" rest
        match nonFlags rest with
          name +: _ -> run cfg (Some name) dry
          []        -> run cfg None dry
      "tv-process" +: rest ->
        dry = hasFlag "--dry-run" rest
        _ = runProbeTv cfg
        _ = Resolve.run cfg
        _ = applyTv cfg dry ()
        doneMsg =
          if dry then
            "[tv-process] dry run done. no files were created, moved, or deleted."
          else "[tv-process] done. review the TV buffer, then: unidork tv-move"
        printLine doneMsg
      _ ->
        _ =
          printLine
            "usage: unidork-import <process|reconcile|import-library|import-all|move|probe-stage|identify|resolve|rename|tv-init|tv-probe|tv-identify|tv-resolve|tv-rename|tv-move|tv-process> [arg] [--dry-run]"
        ()

Config.fromEnv : '{IO} Config
Config.fromEnv =
  do
    use Text ++
    home = getEnvOr "HOME" "/home/bismuth"
    db =
      Db
        (getEnvOr "UNIDORK_DB_HOST" "localhost")
        (getEnvOr "UNIDORK_DB_PORT" "5434")
        (getEnvOr "UNIDORK_DB_USER" "postgres")
        (getEnvOr "UNIDORK_DB_NAME" "dork")
    cache =
      Cache
        (getEnvOr "UNIDORK_CACHE_FFPROBE" (home ++ "/.cache/uniDork/ffprobe"))
        (getEnvOr "UNIDORK_CACHE_STAGE" (home ++ "/.cache/uniDork/stage"))
    paths =
      Paths
        (getEnvOr "UNIDORK_PATH_CONFIG" "./uniDork.conf")
        (getEnvOr
          "UNIDORK_PATH_INTAKE"
          "/home/bismuth/NAS/video/_Unsorted/torrents/Complete/renameQue/Movies")
        (getEnvOr
          "UNIDORK_PATH_BUFFER"
          "/home/bismuth/NAS/video/_Unsorted/torrents/Complete/AMC/TEST")
        (getEnvOr
          "UNIDORK_FORMAT_MOVIE"
          "{ny} [{gigabytes}.{vf}.{vc}.{bitdepth}b.{minutes}min] ~{crc32}/{ny} [{vc}_{bitdepth}b_{resolution}_{mbps}_{ac}-{channels}] ~{crc32}")
        (getEnvOr "UNIDORK_TOKEN_TMDB" (home ++ "/.config/uniDork/tmdb-token"))
        (getEnvOr "UNIDORK_TOKEN_SUB" (home ++ "/.config/uniDork/sub-token"))
        (getEnvOr
          "UNIDORK_PATH_LIBRARY"
          "/home/bismuth/NAS/video/_Unsorted/torrents/Complete/AMC/Movies")
        (getEnvOr
          "UNIDORK_PATH_TV_INTAKE"
          "/home/bismuth/NAS/video/_Unsorted/torrents/Complete/renameQue/Episodic")
        (getEnvOr
          "UNIDORK_PATH_TV_BUFFER"
          "/home/bismuth/NAS/video/_Unsorted/torrents/Complete/AMC/TEST_TV")
        (getEnvOr
          "UNIDORK_PATH_TV_LIBRARY"
          "/home/bismuth/NAS/video/_Unsorted/torrents/Complete/AMC/TV")
        (getEnvOr
          "UNIDORK_FORMAT_TV"
          "{ny}/Season {s00}/{n} - S{s00}E{e00} - {t} [{vc}_{bitdepth}b_{resolution}_{mbps}_{ac}-{channels}] ~{crc32}")
    tuning =
      Tuning
        (getNatOr "UNIDORK_TUNE_PROBE_JOBS" 8)
        (getLangsOr "UNIDORK_TUNE_SUB_LANGS" ["en", "es", "th"])
    Config.Config db cache paths tuning

Config.getEnvOr : Text -> Text ->{IO} Text
Config.getEnvOr key fallback = match catch do getEnv key with
  Right v ->
    t = Text.trim v
    if Universal.eq (Text.size t) 0 then fallback else t
  Left _  -> fallback

Config.getLangsOr : Text -> [Text] ->{IO} [Text]
Config.getLangsOr key fallback =
  use Universal eq
  raw = getEnvOr key ""
  if eq (Text.size raw) 0 then fallback
  else
    cleaned = List.filterMap nonEmpty (Text.split ?, raw)
    if eq (List.size cleaned) 0 then fallback else cleaned

Config.getNatOr : Text -> Nat ->{IO} Nat
Config.getNatOr key fallback =
  raw = getEnvOr key (Nat.toText fallback)
  Optional.getOrElse fallback (Nat.fromText (Text.trim raw))

Config.nonEmpty : Text -> Optional Text
Config.nonEmpty p =
  t = Text.trim p
  if Universal.eq (Text.size t) 0 then Optional.None else Some t

Config.readSubToken : Config ->{IO, Exception} Text
Config.readSubToken cfg =
  Text.trim (readFileUtf8 (FilePath (subToken (paths cfg))))

Config.readTmdbToken : Config ->{IO, Exception} Text
Config.readTmdbToken cfg =
  Text.trim (readFileUtf8 (FilePath (tmdbToken (paths cfg))))

Config.toClientConfig : Config -> PostgresClientConfig
Config.toClientConfig cfg =
  d = db cfg
  PostgresClientConfig.default
    (HostName (Db.host d)) (UserName (Db.user d)) (DatabaseName (Db.name d))
    |> PostgresClientConfig.port.set (Port (Db.port d))

Db.associationsDdl : Text
Db.associationsDdl =
  Text.join
    ""
    [ "CREATE TABLE IF NOT EXISTS associations ("
    , "  file_id       BIGINT NOT NULL REFERENCES files(file_id) ON DELETE CASCADE,"
    , "  tmdb_id       INTEGER NOT NULL REFERENCES movies(tmdb_id) ON DELETE CASCADE,"
    , "  confidence    INTEGER NOT NULL DEFAULT 0,"
    , "  match_source  TEXT NOT NULL DEFAULT '',"
    , "  associated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),"
    , "  PRIMARY KEY (file_id, tmdb_id)"
    , ")"
    ]

Db.cacheDdl : [Text]
Db.cacheDdl =
  [ "CREATE TABLE IF NOT EXISTS tmdb_search_cache (search_title TEXT NOT NULL, search_year INTEGER NOT NULL, payload TEXT NOT NULL, fetched_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), PRIMARY KEY (search_title, search_year))"
  , "CREATE INDEX IF NOT EXISTS idx_tmdb_search_fetched ON tmdb_search_cache(fetched_at DESC)"
  ]

Db.childDdl : [Text]
Db.childDdl =
  [ "CREATE TABLE IF NOT EXISTS movie_video_streams (id SERIAL PRIMARY KEY, folder_checksum TEXT NOT NULL REFERENCES library_movies(folder_checksum) ON DELETE CASCADE, codec TEXT NOT NULL DEFAULT '', aspect DOUBLE PRECISION NOT NULL DEFAULT 0, width INTEGER NOT NULL DEFAULT 0, height INTEGER NOT NULL DEFAULT 0)"
  , "CREATE TABLE IF NOT EXISTS movie_audio_tracks (id SERIAL PRIMARY KEY, folder_checksum TEXT NOT NULL REFERENCES library_movies(folder_checksum) ON DELETE CASCADE, track_order INTEGER NOT NULL DEFAULT 0, codec TEXT NOT NULL DEFAULT '', language TEXT NOT NULL DEFAULT '', channels INTEGER NOT NULL DEFAULT 0)"
  , "CREATE TABLE IF NOT EXISTS movie_subtitles (id SERIAL PRIMARY KEY, folder_checksum TEXT NOT NULL REFERENCES library_movies(folder_checksum) ON DELETE CASCADE, track_order INTEGER NOT NULL DEFAULT 0, language TEXT NOT NULL DEFAULT '')"
  , "CREATE TABLE IF NOT EXISTS movie_actors (id SERIAL PRIMARY KEY, folder_checksum TEXT NOT NULL REFERENCES library_movies(folder_checksum) ON DELETE CASCADE, sort_order INTEGER NOT NULL DEFAULT 0, name TEXT NOT NULL DEFAULT '', role TEXT NOT NULL DEFAULT '')"
  , "CREATE TABLE IF NOT EXISTS movie_genres (folder_checksum TEXT NOT NULL REFERENCES library_movies(folder_checksum) ON DELETE CASCADE, genre TEXT NOT NULL, PRIMARY KEY (folder_checksum, genre))"
  , "CREATE TABLE IF NOT EXISTS movie_tags (folder_checksum TEXT NOT NULL REFERENCES library_movies(folder_checksum) ON DELETE CASCADE, tag TEXT NOT NULL, PRIMARY KEY (folder_checksum, tag))"
  , "CREATE TABLE IF NOT EXISTS movie_countries (folder_checksum TEXT NOT NULL REFERENCES library_movies(folder_checksum) ON DELETE CASCADE, country TEXT NOT NULL, PRIMARY KEY (folder_checksum, country))"
  , "CREATE TABLE IF NOT EXISTS movie_studios (folder_checksum TEXT NOT NULL REFERENCES library_movies(folder_checksum) ON DELETE CASCADE, studio TEXT NOT NULL, PRIMARY KEY (folder_checksum, studio))"
  , "CREATE TABLE IF NOT EXISTS movie_directors (folder_checksum TEXT NOT NULL REFERENCES library_movies(folder_checksum) ON DELETE CASCADE, director TEXT NOT NULL, PRIMARY KEY (folder_checksum, director))"
  , "CREATE TABLE IF NOT EXISTS movie_credits (folder_checksum TEXT NOT NULL REFERENCES library_movies(folder_checksum) ON DELETE CASCADE, credit TEXT NOT NULL, PRIMARY KEY (folder_checksum, credit))"
  ]

Db.createSchema : Config ->{IO, Exception} ()
Db.createSchema cfg = singleIO (toClientConfig cfg) do
  _ = runDDLList [libraryMoviesDdl]
  _ = runDDLList childDdl
  _ = runDDLList [tmdbMoviesDdl]
  _ = runDDLList [filesDdl]
  _ = runDDLList [probeCacheDdl]
  _ = runDDLList [associationsDdl]
  _ = runDDLList Db.cacheDdl
  runDDLList Db.indexDdl

Db.deleteChildSql : Text -> Command a (Text ->{g, g1} a)
Db.deleteChildSql table =
  q = Text.join "" ["DELETE FROM ", table, " WHERE folder_checksum = "]
  sql q %% StatementBuilder.var Codec.text |> buildCommand

Db.dropDdl : [Text]
Db.dropDdl =
  [ "DROP TABLE IF EXISTS associations        CASCADE"
  , "DROP TABLE IF EXISTS probe_cache         CASCADE"
  , "DROP TABLE IF EXISTS files               CASCADE"
  , "DROP TABLE IF EXISTS rename_log          CASCADE"
  , "DROP TABLE IF EXISTS tmdb_details_cache  CASCADE"
  , "DROP TABLE IF EXISTS tmdb_search_cache   CASCADE"
  , "DROP TABLE IF EXISTS stage_probes        CASCADE"
  , "DROP TABLE IF EXISTS movie_credits       CASCADE"
  , "DROP TABLE IF EXISTS movie_directors     CASCADE"
  , "DROP TABLE IF EXISTS movie_studios       CASCADE"
  , "DROP TABLE IF EXISTS movie_countries     CASCADE"
  , "DROP TABLE IF EXISTS movie_tags          CASCADE"
  , "DROP TABLE IF EXISTS movie_genres        CASCADE"
  , "DROP TABLE IF EXISTS movie_actors        CASCADE"
  , "DROP TABLE IF EXISTS movie_subtitles     CASCADE"
  , "DROP TABLE IF EXISTS movie_audio_tracks  CASCADE"
  , "DROP TABLE IF EXISTS movie_video_streams CASCADE"
  , "DROP TABLE IF EXISTS movies              CASCADE"
  , "DROP TABLE IF EXISTS library_movies      CASCADE"
  ]

Db.filesDdl : Text
Db.filesDdl =
  Text.join
    ""
    [ "CREATE TABLE IF NOT EXISTS files ("
    , "  file_id         BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,"
    , "  crc32           TEXT NOT NULL,"
    , "  size_bytes      BIGINT NOT NULL,"
    , "  original_path   TEXT NOT NULL,"
    , "  original_name   TEXT NOT NULL,"
    , "  duration_sec    DOUBLE PRECISION NOT NULL DEFAULT 0,"
    , "  video_codec     TEXT NOT NULL DEFAULT '',"
    , "  width           INTEGER NOT NULL DEFAULT 0,"
    , "  height          INTEGER NOT NULL DEFAULT 0,"
    , "  bit_depth       INTEGER NOT NULL DEFAULT 8,"
    , "  probe_json      TEXT NOT NULL,"
    , "  hint_title      TEXT,"
    , "  hint_year       INTEGER,"
    , "  hint_tmdb_id    INTEGER,"
    , "  proposed_name   TEXT,"
    , "  proposed_folder TEXT,"
    , "  stage           TEXT NOT NULL DEFAULT 'library',"
    , "  media_kind      TEXT NOT NULL DEFAULT 'movie',"
    , "  probed_at       TIMESTAMPTZ NOT NULL DEFAULT NOW(),"
    , "  UNIQUE (crc32, size_bytes)"
    , ")"
    ]

Db.foreach_ : (a ->{g} b) -> [a] ->{g} ()
Db.foreach_ f xs =
  step acc x =
    _ = f x
    acc
  _ = List.foldLeft step () xs
  ()

