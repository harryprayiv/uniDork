  , "CREATE INDEX IF NOT EXISTS idx_library_movies_collection ON library_movies(collection)"
  , "CREATE INDEX IF NOT EXISTS idx_library_movies_crc        ON library_movies(crc32)"
  , "CREATE INDEX IF NOT EXISTS idx_actors_name               ON movie_actors(name)"
  , "CREATE INDEX IF NOT EXISTS idx_files_crc                 ON files(crc32)"
  , "CREATE INDEX IF NOT EXISTS idx_files_original_path       ON files(original_path)"
