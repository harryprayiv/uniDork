Tv.Tmdb.upsertShowSql :
  Command
    b
    (Int
    ->{g18, g19} Optional Text
    ->{g16, g17} Optional Text
    ->{g14, g15} Text
    ->{g12, g13} Text
    ->{g10, g11} Text
    ->{g8, g9} Optional Int
    ->{g6, g7} Text
    ->{g4, g5} Text
    ->{g2, g3} Text
    ->{g, g1} b)
