Tmdb.singleCertFromJson : '{unison_json_1_3_5.Decoder} Text
Tmdb.singleCertFromJson =
  do
    Optional.getOrElse
      "" (Decoder.optional! (object.at "certification" Decoder.text))

Tmdb.tokenAsYear : Text -> Optional Nat
Tmdb.tokenAsYear t =
  use Nat <= >=
  use Optional None
  if Universal.eq (Text.size t) 4 then
    match Nat.fromText t with
      Some n -> if n >= 1900 && n <= 2030 then Some n else None
      None   -> None
  else None

Tmdb.tokenize : Text -> [Text]
Tmdb.tokenize name =
  use List flatMap
  use Nat >
  use Text split
  s1 = split ?. name
  s2 = flatMap (p -> split ?_ p) s1
  s3 = flatMap (p -> split ?\s p) s2
  List.filter (p -> Text.size p > 0) s3

Tmdb.tokenOverlapPercent : Text -> Text -> Nat
Tmdb.tokenOverlapPercent a b =
  use List filter
  use Nat * / < >
  use Universal eq
  toks t = filter (p -> Text.size p > 0) (Text.split ?\s t)
  ta = toks a
  tb = toks b
  if eq (List.size ta) 0 then 0
  else
    if eq (List.size tb) 0 then 0
    else
      use List size
      smaller = if size ta < size tb then ta else tb
      larger = if size ta < size tb then tb else ta
      matching = filter (tok -> List.any (s -> eq s tok) larger) smaller
      size matching * 100 / size smaller

test> Tmdb.tokenOverlapPercent.test =
  use Universal eq
  List.flatMap
    check
    [ eq
        (tokenOverlapPercent "hot tube time machine" "hot tub time machine") 75
    , eq (tokenOverlapPercent "avatar fire and ash" "avatar fire and ash") 100
    , eq (tokenOverlapPercent "foo bar" "foo baz") 50
    , eq (tokenOverlapPercent "completely different" "totally other") 0
    , eq (tokenOverlapPercent "" "anything") 0
    , eq (tokenOverlapPercent "single" "single word") 100
    ]

Tmdb.upsertDetailsSql :
  Command
    b
    (Int
    ->{g28, g29} Optional Text
    ->{g26, g27} Optional Text
    ->{g24, g25} Text
    ->{g22, g23} Text
    ->{g20, g21} Text
    ->{g18, g19} Optional Int
    ->{g16, g17} Optional Int
    ->{g14, g15} Text
    ->{g12, g13} Text
    ->{g10, g11} Text
    ->{g8, g9} Float
    ->{g6, g7} Int
    ->{g4, g5} Optional Text
    ->{g2, g3} Text
    ->{g, g1} b)
Tmdb.upsertDetailsSql =
  use Codec optional text
  use StatementBuilder var
  sql
    "INSERT INTO movies (tmdb_id, imdb_id, tvdb_id, title, original_title, original_language, year, runtime_min, overview, tagline, mpaa, vote_average, vote_count, collection, details_json) VALUES ("
    %% var integer
    %% sql ", "
    %% var (optional text)
    %% sql ", "
    %% var (optional text)
    %% sql ", "
    %% var text
    %% sql ", "
    %% var text
    %% sql ", "
    %% var text
    %% sql ", "
    %% var (optional integer)
    %% sql ", "
    %% var (optional integer)
    %% sql ", "
    %% var text
    %% sql ", "
    %% var text
    %% sql ", "
    %% var text
    %% sql ", "
    %% var Codec.double
    %% sql ", "
    %% var integer
    %% sql ", "
    %% var (optional text)
    %% sql ", "
    %% var text
    %% sql
         ") ON CONFLICT (tmdb_id) DO UPDATE SET imdb_id = EXCLUDED.imdb_id, tvdb_id = EXCLUDED.tvdb_id, title = EXCLUDED.title, original_title = EXCLUDED.original_title, original_language = EXCLUDED.original_language, year = EXCLUDED.year, runtime_min = EXCLUDED.runtime_min, overview = EXCLUDED.overview, tagline = EXCLUDED.tagline, mpaa = EXCLUDED.mpaa, vote_average = EXCLUDED.vote_average, vote_count = EXCLUDED.vote_count, collection = EXCLUDED.collection, details_json = EXCLUDED.details_json, fetched_at = NOW()"
    |> buildCommand

Tmdb.upsertSearchSql :
  Command b (Text ->{g4, g5} Int ->{g2, g3} Text ->{g, g1} b)
Tmdb.upsertSearchSql =
  use Codec text
  use StatementBuilder var
  sql
    "INSERT INTO tmdb_search_cache (search_title, search_year, payload) VALUES ("
    %% var text
    %% sql ", "
    %% var integer
    %% sql ", "
    %% var text
    %% sql
         ") ON CONFLICT (search_title, search_year) DO UPDATE SET payload = EXCLUDED.payload, fetched_at = NOW()"
    |> buildCommand

Tmdb.writeDetailsBodyWith : PreparedCommand r a -> Nat -> Text ->{Postgres} ()
Tmdb.writeDetailsBodyWith pc tmdbId body =
  match catch do unison_json_1_4_2.Decoder.run Details.fromJson body with
    Left _ -> ()
    Right d ->
      use Db pi
      use Details runtime
      use List ++
      use Nat toInt
      use Optional None
      yearOpt = match releaseYear (Details.releaseDate d) with
        Some y -> Some (toInt y)
        None   -> None
      runtimeOpt =
        if Universal.eq (runtime d) 0 then None else Some (toInt (runtime d))
      _ = 
        catch do
          bindAndExecuteCommand
            pc
            (pi (toInt tmdbId)
              ++ pot (Details.imdbId d)
              ++ pot None
              ++ pt (Details.title d)
              ++ pt (Details.originalTitle d)
              ++ pt (Details.originalLanguage d)
              ++ poi yearOpt
              ++ poi runtimeOpt
              ++ pt (Details.overview d)
              ++ pt (Details.tagline d)
              ++ pt (Details.mpaa d)
              ++ pf (Details.voteAverage d)
              ++ pi (toInt (Details.voteCount d))
              ++ pot (Details.collection d)
              ++ pt body)
      ()

toJsonOpt : (a ->{g} Json) -> Optional a ->{g} Json
toJsonOpt f = cases
  Optional.None -> Json.null
  Some a        -> f a

tryXml : '{Throw XMLError} a -> Optional a
tryXml = Throw.toOptional

Tv.Db.alterFilesDdl : [Text]
Tv.Db.alterFilesDdl =
  [ "ALTER TABLE files ADD COLUMN IF NOT EXISTS media_kind TEXT NOT NULL DEFAULT 'movie'"
  , "ALTER TABLE files ADD COLUMN IF NOT EXISTS hint_show_tmdb_id INTEGER"
  , "ALTER TABLE files ADD COLUMN IF NOT EXISTS hint_imdb_id TEXT"
  , "ALTER TABLE files ADD COLUMN IF NOT EXISTS hint_season INTEGER"
  , "ALTER TABLE files ADD COLUMN IF NOT EXISTS hint_episode INTEGER"
  ]

Tv.Db.cacheDdl : [Text]
Tv.Db.cacheDdl =
  [ "CREATE TABLE IF NOT EXISTS tmdb_tv_search_cache (search_title TEXT NOT NULL, search_year INTEGER NOT NULL, payload TEXT NOT NULL, fetched_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), PRIMARY KEY (search_title, search_year))"
  , "CREATE TABLE IF NOT EXISTS tmdb_season_cache (tmdb_show_id INTEGER NOT NULL, season INTEGER NOT NULL, payload TEXT NOT NULL, fetched_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), PRIMARY KEY (tmdb_show_id, season))"
  ]

Tv.Db.createSchema : Config ->{IO, Exception} ()
Tv.Db.createSchema cfg = singleIO (toClientConfig cfg) do
  _ = runDDLList [showsDdl]
  _ = runDDLList [episodesDdl]
  _ = runDDLList [episodeAssociationsDdl]
  _ = runDDLList Tv.Db.cacheDdl
  _ = runDDLList alterFilesDdl
  runDDLList Tv.Db.indexDdl

Tv.Db.dropDdl : [Text]
Tv.Db.dropDdl =
  [ "DROP TABLE IF EXISTS episode_associations CASCADE"
  , "DROP TABLE IF EXISTS tmdb_season_cache    CASCADE"
  , "DROP TABLE IF EXISTS episodes             CASCADE"
  , "DROP TABLE IF EXISTS shows                CASCADE"
  , "DROP TABLE IF EXISTS tmdb_tv_search_cache CASCADE"
  ]

Tv.Db.episodeAssociationsDdl : Text
Tv.Db.episodeAssociationsDdl =
  Text.join
    ""
    [ "CREATE TABLE IF NOT EXISTS episode_associations ("
    , "  file_id       BIGINT  NOT NULL REFERENCES files(file_id) ON DELETE CASCADE,"
    , "  tmdb_show_id  INTEGER NOT NULL,"
    , "  season        INTEGER NOT NULL,"
    , "  episode       INTEGER NOT NULL,"
    , "  confidence    INTEGER NOT NULL DEFAULT 0,"
    , "  match_source  TEXT NOT NULL DEFAULT '',"
    , "  associated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),"
    , "  PRIMARY KEY (file_id, tmdb_show_id, season, episode),"
    , "  FOREIGN KEY (tmdb_show_id, season, episode)"
    , "    REFERENCES episodes(tmdb_show_id, season, episode) ON DELETE CASCADE"
    , ")"
    ]

Tv.Db.episodesDdl : Text
Tv.Db.episodesDdl =
  Text.join
    ""
    [ "CREATE TABLE IF NOT EXISTS episodes ("
    , "  tmdb_show_id INTEGER NOT NULL REFERENCES shows(tmdb_show_id) ON DELETE CASCADE,"
    , "  season       INTEGER NOT NULL,"
    , "  episode      INTEGER NOT NULL,"
    , "  title        TEXT NOT NULL DEFAULT '',"
    , "  air_date     TEXT,"
    , "  runtime_min  INTEGER,"
    , "  fetched_at   TIMESTAMPTZ NOT NULL DEFAULT NOW(),"
    , "  PRIMARY KEY (tmdb_show_id, season, episode)"
    , ")"
    ]

Tv.Db.indexDdl : [Text]
Tv.Db.indexDdl =
  [ "CREATE INDEX IF NOT EXISTS idx_episodes_show     ON episodes(tmdb_show_id)"
  , "CREATE INDEX IF NOT EXISTS idx_ep_assoc_episode  ON episode_associations(tmdb_show_id, season, episode)"
  , "CREATE INDEX IF NOT EXISTS idx_files_media_kind  ON files(media_kind)"
  , "CREATE INDEX IF NOT EXISTS idx_shows_name        ON shows(name)"
  ]

Tv.Db.resetTvSchema : Config ->{IO, Exception} ()
Tv.Db.resetTvSchema cfg = singleIO (toClientConfig cfg) do
  _ = runDDLList Tv.Db.dropDdl
  _ = runDDLList [showsDdl]
  _ = runDDLList [episodesDdl]
  _ = runDDLList [episodeAssociationsDdl]
  _ = runDDLList Tv.Db.cacheDdl
  _ = runDDLList alterFilesDdl
  runDDLList Tv.Db.indexDdl

Tv.Db.showsDdl : Text
Tv.Db.showsDdl =
  Text.join
    ""
    [ "CREATE TABLE IF NOT EXISTS shows ("
    , "  tmdb_show_id      INTEGER PRIMARY KEY,"
    , "  imdb_id           TEXT,"
    , "  tvdb_id           TEXT,"
    , "  name              TEXT NOT NULL DEFAULT '',"
    , "  original_name     TEXT NOT NULL DEFAULT '',"
    , "  original_language TEXT NOT NULL DEFAULT '',"
    , "  first_air_year    INTEGER,"
    , "  status            TEXT NOT NULL DEFAULT '',"
    , "  rating            TEXT NOT NULL DEFAULT '',"
    , "  details_json      TEXT NOT NULL,"
    , "  fetched_at        TIMESTAMPTZ NOT NULL DEFAULT NOW()"
    , ")"
    ]

Tv.initDb : '{IO, Exception} ()
Tv.initDb = do Tv.Db.createSchema fromEnv()

Tv.Move.collectVideoFiles : FilePath ->{IO, Exception} [Text]
Tv.Move.collectVideoFiles dir =
  use List ++ :+
  use Universal eq
  entries = directoryContents.texts dir
  step acc n =
    if eq n "." then acc
    else
      if eq n ".." then acc
      else
        fp = pathJoin dir n
        if isDirectory fp then acc ++ Tv.Move.collectVideoFiles fp
        else if isVideo n then acc :+ filePathText fp else acc
  List.foldLeft step [] entries

Tv.Move.mergeTree : Text -> Text ->{IO, Exception} ()
Tv.Move.mergeTree src dst =
  use Text ++
  use Universal eq
  ensureDir dst
  entries = directoryContents.texts (FilePath src)
  processEntry n =
    if eq n "." then ()
    else
      if eq n ".." then ()
      else
        srcPath = src ++ "/" ++ n
        dstPath = dst ++ "/" ++ n
        if isDirectory (FilePath srcPath) then
          if isDirectory (FilePath dstPath) then
            Tv.Move.mergeTree srcPath dstPath
          else
            match commitFolder srcPath dstPath with
              Left err ->
                printLine ("    merge dir failed: " ++ n ++ " " ++ err)
              Right _ -> ()
        else
          if pathExists (FilePath dstPath)
            && isVideo n then printLine ("    skip (exists): " ++ n)
          else
            match catch do renameFile (FilePath srcPath) (FilePath dstPath) with
              Left f ->
                printLine
                  ("    file move failed: " ++ n ++ " " ++ Failure.message f)
              Right _ -> ()
  _ = Db.foreach_ processEntry entries
  rmdirFolder src

Tv.Move.moveShow :
  Boolean -> Text -> FilePath ->{IO, Exception, TvMoveCatalog} ()
Tv.Move.moveShow dryRun libraryRoot folder =
  use Boolean not
  use List size
  use Nat - toText
  use Text ++
  showName = filePathBasename folder
  srcText = filePathText folder
  dstText = libraryRoot ++ "/" ++ showName
  _ = printLine ("TV-MOVE: " ++ showName)
  if not (enforceUnderRoot libraryRoot dstText) then
    printLine "  abort: destination not under library root"
  else
    videoPaths = collectVideoFiles folder
    _ = printLine ("  " ++ toText (size videoPaths) ++ " video file(s)")
    verified = List.map verifyEpisode videoPaths
    verifiedCount = size (List.filter (cases (_, ok, _) -> ok) verified)
    _ =
      printLine
        ("  identity verified: "
          ++ toText verifiedCount
          ++ "/"
          ++ toText (size verified))
    sameDev = sameDevice srcText libraryRoot
    merge = isDirectory (FilePath dstText)
    if dryRun then
      mode =
        if merge then "merge into existing show folder"
        else "create new show folder"
      method =
        if merge then if sameDev then "mergeTree" else "rsync into existing"
        else
          if sameDev then "atomic rename" else "rsync to partial then commit"
      _ =
        printLine
          ("  DRY-RUN: would "
            ++ mode
            ++ " at "
            ++ dstText
            ++ " via "
            ++ method)
      printLine
        ("  DRY-RUN: would update "
          ++ toText verifiedCount
          ++ " by identity, "
          ++ toText (size verified - verifiedCount)
          ++ " by name")
    else
      moveOk = transferShow merge sameDev srcText dstText libraryRoot
      if not moveOk then ()
      else
        applyOne = cases
          (oldPath, ok, identOpt) ->
            updateEpisode srcText dstText oldPath ok identOpt
        _ = Db.foreach_ applyOne verified
        printLine ("  promoted -> " ++ dstText)

Tv.Move.rebasePath : Text -> Text -> Text -> Text
Tv.Move.rebasePath oldPrefix newPrefix path =
  use Text ++
  suffix = Text.drop (Text.size oldPrefix) path
  newPrefix ++ suffix

Tv.Move.run : Config -> Optional Text -> Boolean ->{IO, Exception} ()
Tv.Move.run cfg maybeFolderName dryRun =
  use Db foreach_
  use List size
  use Nat +
  use Universal eq
  bufferRoot = tvBuffer (paths cfg)
  libraryRoot = tvLibrary (paths cfg)
  bufferFp = FilePath bufferRoot
  if Boolean.not (isDirectory bufferFp) then
    printLine ("tv buffer not found: " Text.++ bufferRoot)
  else
    _ =
      if dryRun then
        printLine "[tv-move] DRY RUN: no files will be moved or deleted"
      else ()
    folders =
      match maybeFolderName with
        Some name ->
          use Text ++
          trimmed = Text.trim name
          bad = List.any (b -> eq b trimmed) ["", ".", ".."]
          if bad then
            _ =
              printLine
                ("refusing to move: invalid folder name: '" ++ name ++ "'")
            []
          else
            fp = pathJoin bufferFp trimmed
            if isDirectory fp then [fp]
            else
              _ = printLine ("no such buffer folder: " ++ name)
              []
        Optional.None ->
          entries = directoryContents.texts bufferFp
          names =
            List.filter
              (n ->
                (if eq n "." then false
                else
                  if eq n ".." then false
                  else isDirectory (pathJoin bufferFp n)))
              entries
          List.map (n -> pathJoin bufferFp n) names
    _ =
      printLine
        ("[tv-move] "
          Text.++ Nat.toText (size folders)
          Text.++ " show folder(s) to promote")
    if eq (size folders) 0 then ()
    else
      _ = if dryRun then () else sweepPartial libraryRoot
      chunks = List.chunk moveChunkSize folders
      total = size folders
      counter = IO.ref (0, 0)
      startEpoch = epochSeconds()
      runChunk chunk = 
        singleIO (toClientConfig cfg) do
          pqIdent = prepareQuery selectFileByPathSql
          pcById = prepareCommand updateFilePathSql
          pcByName = prepareCommand updatePathSql
          moveGo = cases
            { r } -> r
            { identityForEpisode path -> k } ->
              handle k (loadIdentity pqIdent path) with moveGo
            { updateEpisodePathById newPath newName crc sz -> k } ->
              use List ++
              _ = 
                catch do
                  bindAndExecuteCommand
                    pcById
                    (pt newPath ++ pt newName ++ pt crc ++ pobi (Some sz))
              handle k() with moveGo
            { updateEpisodePathByName newPath newName oldPath -> k } ->
              use List ++
              _ = 
                catch do
                  bindAndExecuteCommand
                    pcByName (pt newPath ++ pt newName ++ pt oldPath)
              handle k() with moveGo
          safeMove folder =
            use Text ++
            outcome = 
              catch do handle moveShow dryRun libraryRoot folder with moveGo
            _ = match outcome with
              Right _ -> ()
              Left f  -> printLine ("  SHOW FAILED: " ++ Failure.message f)
            ()
          _ = foreach_ safeMove chunk
          (dn, _) = mutable.Ref.read counter
          _ = mutable.Ref.write counter (dn + size chunk, 0)
          _ = Move.printProgress total 0 startEpoch counter
          _ = PreparedQuery.close pqIdent
          _ = PreparedCommand.close pcById
          PreparedCommand.close pcByName
      foreach_ runChunk chunks

Tv.Move.transferShow :
  Boolean -> Boolean -> Text -> Text -> Text ->{IO, Exception} Boolean
Tv.Move.transferShow merge sameDev srcText dstText libraryRoot =
  use Text ++
  if merge then
    if sameDev then
      _ = printLine "  merge: same-device, mergeTree"
      _ = mergeTree srcText dstText
      true
    else
      _ = printLine "  merge: cross-device, rsync into existing"
      match rsyncFolder srcText dstText with
        Left err ->
          _ = printLine ("  abort: rsync failed: " ++ err)
          false
        Right _  ->
          _ = match removeFolderTree srcText with
            Left e  -> printLine ("  warn: cleanup failed: " ++ e)
            Right _ -> ()
          true
  else
    if sameDev then
      _ = printLine "  transfer: atomic rename (same filesystem)"
      match commitFolder srcText dstText with
        Left err ->
          _ = printLine ("  abort: move failed: " ++ err)
          false
        Right _  -> true
    else
      _ =
        printLine
          "  transfer: rsync to partial, then commit (cross filesystem)"
      pRoot = partialRoot libraryRoot
      showBase = filePathBasename (FilePath srcText)
      partialDst = pRoot ++ "/" ++ showBase
      _ = ensureDir pRoot
      match rsyncFolder srcText partialDst with
        Left err ->
          _ = printLine ("  abort: rsync to partial failed: " ++ err)
          false
        Right _  ->
          match commitFolder partialDst dstText with
            Left err ->
              _ = printLine ("  abort: commit from partial failed: " ++ err)
              false
            Right _  ->
              _ = match removeFolderTree srcText with
                Left e  -> printLine ("  warn: source cleanup failed: " ++ e)
                Right _ -> ()
              ()
              true

Tv.Move.updateEpisode :
  Text
  -> Text
  -> Text
  -> Boolean
  -> Optional FileIdentity
  ->{IO, Exception, TvMoveCatalog} ()
Tv.Move.updateEpisode srcText dstText oldPath verified identOpt =
  use Text ++
  newPath = rebasePath srcText dstText oldPath
  newName = filePathBasename (FilePath newPath)
  match (verified, identOpt) with
    (true, Some ident) ->
      crc = FileIdentity.crc32 ident
      sz = FileIdentity.sizeBytes ident
      updateEpisodePathById newPath newName crc sz
    _ ->
      _ =
        printLine
          ("  WARN identity-unverified, path updated by name: " ++ oldPath)
      updateEpisodePathByName newPath newName oldPath

Tv.Move.updatePathSql : Command a (Text -> Text -> Text -> a)
Tv.Move.updatePathSql =
  use Codec text
  use StatementBuilder var
  sql "UPDATE files SET original_path = "
    %% var text
    %% sql ", original_name = "
    %% var text
    %% sql ", stage = 'library' WHERE original_path = "
    %% var text
    |> buildCommand

Tv.Move.verifyEpisode :
  Text ->{IO, Exception, TvMoveCatalog} (Text, Boolean, Optional FileIdentity)
Tv.Move.verifyEpisode oldPath =
  use Int toText
  use Optional None
  use Text ==
  identOpt = identityForEpisode oldPath
  match identOpt with
    None -> (oldPath, false, None)
    Some ident ->
      diskOk =
        match fileStat oldPath with
          None -> false
          Some (_, sz) ->
            toText (FileIdentity.sizeBytes ident) == toText (Nat.toInt sz)
      (oldPath, diskOk, Some ident)

Tv.Nfo.episodeBlock :
  Text
  -> Nat
  -> Nat
  -> Text
  -> Optional EpisodeDetails
  -> Boolean
  -> Text
  -> ProbeResult
  -> [Text]
Tv.Nfo.episodeBlock showName seasonNum epNum fallbackTitle details first crc pr =
  use EpisodeDetails voteCount
  use List flatMap
  use Nat >
  use Optional None
  use Text size
  use Universal eq
  use VideoInfo height width
  esc = escapeXml
  title = match details with
    Some d ->
      t = EpisodeDetails.title d
      if eq (size t) 0 then fallbackTitle else t
    None   -> fallbackTitle
  optLine tag value =
    if eq (size value) 0 then []
    else
      [ "  <"
          Text.++ tag
          Text.++ ">"
          Text.++ esc value
          Text.++ "</"
          Text.++ tag
          Text.++ ">"
      ]
  plotLines = match details with
    Some d -> optLine "plot" (EpisodeDetails.overview d)
    None   -> []
  airedLines = match details with
    Some d -> optLine "aired" (airDate d)
    None   -> []
  runtimeLines = match details with
    Some d ->
      match EpisodeDetails.runtimeMin d with
        Some r -> ["  <runtime>" Text.++ Nat.toText r Text.++ "</runtime>"]
        None   -> []
    None   -> []
  ratingLines =
    match details with
      Some d ->
        if voteCount d > 0 then
          [ "  <ratings>"
          , "    <rating name=\"themoviedb\" max=\"10\" default=\"true\">"
          , "      <value>"
              Text.++ Float.toText (EpisodeDetails.voteAverage d)
              Text.++ "</value>"
          , "      <votes>" Text.++ Nat.toText (voteCount d) Text.++ "</votes>"
          , "    </rating>"
          , "  </ratings>"
          ]
        else []
      None -> []
  tmdbIdLines =
    match details with
      Some d ->
        use Text ++
        eid = episodeId d
        if eid > 0 then
          ["  <uniqueid type=\"tmdb\">" ++ Nat.toText eid ++ "</uniqueid>"]
        else []
      None -> []
  vid = ProbeResult.video pr
  durSec = durationSeconds (ProbeResult.durationSec pr)
  videoLines =
    [ "      <video>"
    , "        <codec>" Text.++ esc (VideoInfo.codec vid) Text.++ "</codec>"
    , "        <aspect>"
        Text.++ aspectRatio (width vid) (height vid)
        Text.++ "</aspect>"
    , "        <width>" Text.++ Nat.toText (width vid) Text.++ "</width>"
    , "        <height>" Text.++ Nat.toText (height vid) Text.++ "</height>"
    , "        <durationinseconds>"
        Text.++ Nat.toText durSec
        Text.++ "</durationinseconds>"
    , "      </video>"
    ]
  audioLines = flatMap audioBlock (ProbeResult.audios pr)
  subtitleLines = flatMap subtitleBlock (ProbeResult.subtitles pr)
  fileinfoLines =
    if first then
      ["  <fileinfo>", "    <streamdetails>"]
        List.++ videoLines
        List.++ audioLines
        List.++ subtitleLines
        List.++ ["    </streamdetails>", "  </fileinfo>"]
    else []
  flatMap
    (x -> x)
    [ [ "<episodedetails>"
      , "  <title>" Text.++ esc title Text.++ "</title>"
      , "  <showtitle>" Text.++ esc showName Text.++ "</showtitle>"
      , "  <season>" Text.++ Nat.toText seasonNum Text.++ "</season>"
      , "  <episode>" Text.++ Nat.toText epNum Text.++ "</episode>"
      ]
    , plotLines
    , airedLines
    , runtimeLines
    , ratingLines
    , ["  <uniqueid type=\"crc32\">" Text.++ esc crc Text.++ "</uniqueid>"]
    , tmdbIdLines
    , fileinfoLines
    , ["</episodedetails>"]
    ]

Tv.Nfo.extractImdbId : Text -> Optional Text
Tv.Nfo.extractImdbId raw =
  use Nat + >=
  use Optional None
  use Text size
  needle = "imdb.com/title/"
  match Text.indexOf needle raw with
    None -> None
    Some i ->
      after = Text.drop (i + size needle) raw
      parts = Text.split ?/ after
      match List.head parts with
        None -> None
        Some seg ->
          cleaned = Text.trim seg
          if startsWith "tt" cleaned && size cleaned >= 7 then Some cleaned
          else None

test> Tv.Nfo.extractImdbId.test =
  use Optional None
  use Tv.Nfo extractImdbId
  use Universal eq
  List.flatMap
    check
    [ eq
        (extractImdbId "IMDB: https://www.imdb.com/title/tt34675596/")
        (Some "tt34675596")
    , eq (extractImdbId "http://imdb.com/title/tt1234567") (Some "tt1234567")
    , eq (extractImdbId "no link here") None
    , eq (extractImdbId "imdb.com/title/tt12") None
    , eq (extractImdbId "imdb.com/title/notanid/") None
    ]

Tv.Nfo.generateShowNfo : ShowDetails -> Text
Tv.Nfo.generateShowNfo d =
  use List flatMap
  use Nat >
  use Optional None
  use ShowDetails firstAirDate imdbId tmdbId voteCount
  use Text ++ join
  esc = escapeXml
  optLine tag value =
    if Universal.eq (Text.size value) 0 then []
    else ["  <" ++ tag ++ ">" ++ esc value ++ "</" ++ tag ++ ">"]
  epGuideJson =
    use Nat toText
    use Optional map
    parts =
      List.filterMap
        (x -> x)
        [ Some ("\"tmdb\": \"" ++ toText (tmdbId d) ++ "\"")
        , map (i -> "\"imdb\": \"" ++ i ++ "\"") (imdbId d)
        , map (t -> "\"tvdb\": \"" ++ toText t ++ "\"") (tvdbId d)
        ]
    "{" ++ join ", " parts ++ "}"
  epGuideLine = ["  <episodeguide>" ++ epGuideJson ++ "</episodeguide>"]
  ratingLines =
    if voteCount d > 0 then
      [ "  <ratings>"
      , "    <rating name=\"themoviedb\" max=\"10\" default=\"true\">"
      , "      <value>"
          ++ Float.toText (ShowDetails.voteAverage d)
          ++ "</value>"
      , "      <votes>" ++ Nat.toText (voteCount d) ++ "</votes>"
      , "    </rating>"
      , "  </ratings>"
      ]
    else []
  sortTitle = Nfo.sortTitle (ShowDetails.name d) (firstAirDate d)
  genreLines =
    List.map (g -> "  <genre>" ++ esc g ++ "</genre>") (ShowDetails.genres d)
  networkLines =
    List.map (n -> "  <studio>" ++ esc n ++ "</studio>") (networks d)
  actorLines =
    flatMap
      (a ->
        [ "  <actor>"
        , "    <name>" ++ esc (CastMember.name a) ++ "</name>"
        , "    <role>" ++ esc (character a) ++ "</role>"
        , "    <order>" ++ Nat.toText (CastMember.order a) ++ "</order>"
        , "  </actor>"
        ])
      (List.take 30 (ShowDetails.cast d))
  imdbLines = match imdbId d with
    None   -> []
    Some i -> ["  <uniqueid type=\"imdb\">" ++ esc i ++ "</uniqueid>"]
  tvdbLines = match tvdbId d with
    None   -> []
    Some t -> ["  <uniqueid type=\"tvdb\">" ++ Nat.toText t ++ "</uniqueid>"]
  seasonLine =
    if numberOfSeasons d > 0 then
      ["  <season>" ++ Nat.toText (numberOfSeasons d) ++ "</season>"]
    else []
  allLines =
    flatMap
      (x -> x)
      [ [ "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\" ?>"
        , "<tvshow>"
        , "  <title>" ++ esc (ShowDetails.name d) ++ "</title>"
        , "  <originaltitle>"
            ++ esc (ShowDetails.originalName d)
            ++ "</originaltitle>"
        , "  <sorttitle>" ++ esc sortTitle ++ "</sorttitle>"
        , "  <plot>" ++ esc (ShowDetails.overview d) ++ "</plot>"
        ]
      , ratingLines
      , optLine "mpaa" (ShowDetails.rating d)
      , epGuideLine
      , optLine "premiered" (firstAirDate d)
      , optLine "status" (ShowDetails.status d)
      , seasonLine
      , genreLines
      , networkLines
      , actorLines
      , [ "  <uniqueid type=\"tmdb\" default=\"true\">"
            ++ Nat.toText (tmdbId d)
            ++ "</uniqueid>"
        ]
      , imdbLines
      , tvdbLines
      , optLine "originallanguage" (ShowDetails.originalLanguage d)
      , ["</tvshow>", ""]
      ]
  join "\n" allLines

Tv.Nfo.minimalShowNfo : Nat -> Text -> Text
Tv.Nfo.minimalShowNfo showId name =
  use Text ++
  tmdbText = Nat.toText showId
  Text.join
    "\n"
    [ "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\" ?>"
    , "<tvshow>"
    , "  <title>" ++ escapeXml name ++ "</title>"
    , "  <episodeguide>{\"tmdb\": \"" ++ tmdbText ++ "\"}</episodeguide>"
    , "  <uniqueid type=\"tmdb\" default=\"true\">"
        ++ tmdbText
        ++ "</uniqueid>"
    , "</tvshow>"
    , ""
    ]

Tv.Nfo.parseShowId : Soup ->{Throw XMLError} Optional Nat
Tv.Nfo.parseShowId s = match uniqueIdOfType "tmdb" s with
  Some v        -> Nat.fromText (Text.trim v)
  Optional.None -> Optional.None

Tv.Nfo.readShowTmdbId : FilePath ->{IO, Exception} Optional Nat
Tv.Nfo.readShowTmdbId folder =
  match catch do directoryContents.texts folder with
    Left _ -> Optional.None
    Right files ->
      match List.find
        (n -> Universal.eq (Text.toLowercase n) "tvshow.nfo") files with
        Optional.None -> Optional.None
        Some nfoName  ->
          match catch do readFileUtf8 (pathJoin folder nfoName) with
            Left _    -> Optional.None
            Right xml ->
              match withXML xml parseShowId with
                Right (idOpt +: _) -> idOpt
                _                  -> Optional.None

Tv.Nfo.scanFolderForImdb : FilePath ->{IO, Exception} Optional Text
Tv.Nfo.scanFolderForImdb folder =
  match catch do directoryContents.texts folder with
    Left _      -> Optional.None
    Right files ->
      use Optional None
      nfos = List.filter isNfo files
      go = cases
        []        -> None
        n +: rest ->
          match catch do readFileUtf8 (pathJoin folder n) with
            Left _    -> go rest
            Right raw ->
              match Tv.Nfo.extractImdbId raw with
                Some id -> Some id
                None    -> go rest
      go nfos

Tv.Parse.bareEpisode : Optional Nat -> Text -> Optional Nat
Tv.Parse.bareEpisode seasonOpt fileName =
  use List head
  use Optional None
  tokens = Tmdb.tokenize fileName
  fromConcat = match seasonOpt with
    None        -> None
    Some season -> head (List.filterMap (concatEpisode season) tokens)
  match fromConcat with
    Some e -> Some e
    None   ->
      match episodeAfterMarker tokens with
        Some e -> Some e
        None   ->
          match head tokens with
            None   -> None
            Some t -> plainEpisode t

Tv.Parse.braceTagValue : Text -> Text -> Optional Text
Tv.Parse.braceTagValue key name =
  use Nat +
  use Optional None
  use Text ++ indexOf
  open = "{" ++ key ++ "-"
  match indexOf open name with
    None   -> None
    Some i ->
      afterOpen = Text.drop (i + Text.size open) name
      match indexOf "}" afterOpen with
        None   -> None
        Some j -> Some (Text.trim (Text.take j afterOpen))

Tv.Parse.cleanShowQuery : Text -> (Text, Optional Nat)
Tv.Parse.cleanShowQuery raw = match findEnclosedYearAny raw with
  Some (prefix, y) -> (cutTitle prefix, Some y)
  Optional.None    -> (cutTitle raw, Optional.None)

test> Tv.Parse.cleanShowQuery.test =
  use Optional None
  use Universal eq
  List.flatMap
    check
    [ eq (cleanShowQuery "Yellowstone (2018) -") ("Yellowstone", Some 2018)
    , eq
        (cleanShowQuery "Silicon Valley (2014) -")
        ("Silicon Valley", Some 2014)
    , eq (cleanShowQuery "The Smurfs Collection 1") ("The Smurfs", None)
    , eq (cleanShowQuery "DORAEMON - stagione 1 -TVRip-") ("DORAEMON", None)
    , eq
        (cleanShowQuery "Malcolm in the Middle - The Complete Collection")
        ("Malcolm in the Middle", None)
    , eq (cleanShowQuery "Severance") ("Severance", None)
    ]

Tv.Parse.concatEpisode : Nat -> Text -> Optional Nat
Tv.Parse.concatEpisode season tok =
  use Nat + <= >=
  use Optional None
  use Text size
  if Boolean.not (digitsOnly tok) then None
  else
    seasonStr = Nat.toText season
    sLen = size seasonStr
    tLen = size tok
    if Universal.eq tLen (sLen + 2) && startsWith seasonStr tok then
      epStr = Text.drop sLen tok
      match Nat.fromText epStr with
        None   -> None
        Some e -> if e >= 1 && e <= 99 then Some e else None
    else None

Tv.Parse.cutTitle : Text -> Text
Tv.Parse.cutTitle name =
  use List +: reverse
  tokens = Tmdb.tokenize name
  go acc = cases
    []        -> reverse acc
    t +: rest -> if titleCutToken t then reverse acc else go (t +: acc) rest
  Text.trim (Text.join " " (dropTrailingNoise (go [] tokens)))

Tv.Parse.digitsOnly : Text -> Boolean
Tv.Parse.digitsOnly t =
  if Universal.eq (Text.size t) 0 then false
  else
    match Nat.fromText t with
      Some _        -> true
      Optional.None -> false

Tv.Parse.dropTrailingNoise : [Text] -> [Text]
Tv.Parse.dropTrailingNoise tokens =
  use List +: reverse
  noise t =
    lower = Text.toLowercase t
    List.any
      (w -> Universal.eq w lower)
      ["the", "a", "an", "-", "–", "—", "+", "&", ":", "_"]
  go = cases
    []        -> []
    t +: rest -> if noise t then go rest else t +: rest
  reverse (go (reverse tokens))

Tv.Parse.episodeAfterMarker : [Text] -> Optional Nat
Tv.Parse.episodeAfterMarker tokens =
  use Nat +
  use Optional None
  use Universal eq
  pairs = withIndex tokens
  hits =
    List.filterMap
      (cases
        (i, t) ->
          lower = Text.toLowercase t
          if eq lower "ep" || eq lower "episode" then
            match Tmdb.nth (i + 1) tokens with
              Some next -> plainEpisode next
              None      -> None
          else None) pairs
  List.head hits

Tv.Parse.epSegment : Text -> Optional [Nat]
Tv.Parse.epSegment t =
  use Nat >
  parts = List.filter (p -> Text.size p > 0) (Text.split ?- t)
  nats = List.filterMap Nat.fromText parts
  if Universal.eq (List.size nats) (List.size parts) && List.size parts > 0 then
    Some nats
  else Optional.None

Tv.Parse.folderImdbTag : Text -> Optional Text
Tv.Parse.folderImdbTag name =
  use Optional None
  candidate = match braceTagValue "imdb" name with
    Some v -> Some v
    None   -> braceTagValue "imdbid" name
  match candidate with
    None   -> None
    Some v ->
      t = Text.trim v
      if startsWith "tt" t then Some t else None

Tv.Parse.foldersOfPath : Text -> [Text]
Tv.Parse.foldersOfPath fullPath =
  use List reverse
  use Nat >
  parts = List.filter (p -> Text.size p > 0) (Text.split ?/ fullPath)
  match reverse parts with
    _ +: restRev -> reverse restRev
    []           -> []

test> Tv.Parse.folderTag.test =
  use Optional None
  use Universal eq
  List.flatMap
    check
    [ eq
        (tmdbTagFromFolders ["Six Feet Under {tmdb-1274}", "Season 01"])
        (Some 1274)
    , eq (tmdbTagFromFolders ["Show {tmdbid-555}"]) (Some 555)
    , eq (tmdbTagFromFolders ["Plain Show", "Season 1"]) None
    , eq (imdbTagFromFolders ["The Wire {imdb-tt0306414}"]) (Some "tt0306414")
    , eq (imdbTagFromFolders ["No Tags Here"]) None
    ]

Tv.Parse.folderTmdbTag : Text -> Optional Nat
Tv.Parse.folderTmdbTag name = match braceTagValue "tmdb" name with
  Some v        -> Nat.fromText (Text.trim v)
  Optional.None ->
    match braceTagValue "tmdbid" name with
      Some v        -> Nat.fromText (Text.trim v)
      Optional.None -> Optional.None

Tv.Parse.imdbTagFromFolders : [Text] -> Optional Text
Tv.Parse.imdbTagFromFolders folders =
  List.head (List.filterMap folderImdbTag folders)

Tv.Parse.isCutToken : Text -> Boolean
Tv.Parse.isCutToken t =
  use Optional None
  use Universal eq
  lower = Text.toLowercase t
  match refFromToken t with
    Some _ -> true
    None ->
      if isSeasonOnly t then true
      else
        match tokenAsYear t with
          Some _ -> true
          None -> isQualityToken t || eq lower "season" || eq lower "complete"

Tv.Parse.isSeasonOnly : Text -> Boolean
Tv.Parse.isSeasonOnly t =
  use Nat <=
  lower = Text.toLowercase t
  if startsWith "s" lower then
    match Nat.fromText (Text.drop 1 lower) with
      Some n        -> n <= 99
      Optional.None -> false
  else false

Tv.Parse.natSegment : Text -> Optional Nat
Tv.Parse.natSegment t =
  if Universal.eq (Text.size t) 0 then Optional.None else Nat.fromText t

Tv.Parse.parseEpisodeName : Text -> Optional ParsedEpisode
Tv.Parse.parseEpisodeName name =
  use Optional None
  tokens = Tmdb.tokenize name
  pairs = withIndex tokens
  hits =
    List.filterMap
      (cases (i, t) -> Optional.map (r -> (i, r)) (refFromToken t)) pairs
  match hits with
    [] -> None
    (i, ref) +: _ ->
      titleStr = cleanTitle (Text.join " " (List.take i tokens))
      titlePrefix =
        if Universal.eq (Text.size titleStr) 0 then None else Some titleStr
      Some (ParsedEpisode name titlePrefix ref)

test> Tv.Parse.parseEpisodeName.test =
  use Optional None
  use ParsedEpisode ref
  use Universal eq
  case1 =
    match parseEpisodeName "Severance.S02E03.2160p.WEB-DL.DDP5.1.x265-GROUP" with
      None -> false
      Some p ->
        eq (titlePrefix p) (Some "Severance") && eq (ref p) (EpisodeRef 2 [3])
  case2 =
    match parseEpisodeName "The.Wire.S05E01E02.720p.BluRay" with
      None -> false
      Some p ->
        eq (titlePrefix p) (Some "The Wire")
          && eq (ref p) (EpisodeRef 5 [1, 2])
  case3 = match parseEpisodeName "S01E01" with
    None   -> false
    Some p -> eq (titlePrefix p) None
  case4 = match parseEpisodeName "Inception.2010.1080p.BluRay" with
    None   -> true
    Some _ -> false
  List.flatMap check [case1, case2, case3, case4]

Tv.Parse.parseShowFolder : Text -> Optional (Text, Optional Nat)
Tv.Parse.parseShowFolder name =
  match findEnclosedYearAny name with
    Some (prefix, y) ->
      cleaned = cleanTitle prefix
      if Universal.eq (Text.size cleaned) 0 then Optional.None
      else Some (cleaned, Some y)
    Optional.None ->
      use Optional None
      tokens = titleTokens (Tmdb.tokenize name)
      t = Text.trim (Text.join " " tokens)
      if Universal.eq (Text.size t) 0 then None else Some (t, None)

test> Tv.Parse.parseShowFolder.test =
  use Optional None
  use Universal eq
  List.flatMap
    check
    [ eq (parseShowFolder "Severance (2022)") (Some ("Severance", Some 2022))
    , eq
        (parseShowFolder "Severance.S01.2160p.WEB-DL")
        (Some ("Severance", None))
    , eq
        (parseShowFolder "The.Wire.Season.1.Complete")
        (Some ("The Wire", None))
    , eq (parseShowFolder "Better.Call.Saul") (Some ("Better Call Saul", None))
    ]

Tv.Parse.plainEpisode : Text -> Optional Nat
Tv.Parse.plainEpisode t =
  use Nat <= >=
  use Optional None
  if Boolean.not (digitsOnly t) then None
  else
    match Nat.fromText t with
      None   -> None
      Some n -> if n >= 1 && n <= 999 then Some n else None

Tv.Parse.refFromFolders : [Text] -> Text -> Optional EpisodeRef
Tv.Parse.refFromFolders folders fileName = match seasonFromFolders folders with
  Optional.None -> Optional.None
  Some season   ->
    match bareEpisode (Some season) fileName with
      Optional.None -> Optional.None
      Some ep       -> Some (EpisodeRef season [ep])

