    %% var integer
    %% sql ", "
    %% var integer
    %% sql ", "
    %% var text
    %% sql ", "
    %% var text
    %% sql ", "
    %% var (Codec.optional integer)
    %% sql
         ") ON CONFLICT (tmdb_show_id, season, episode) DO UPDATE SET title = EXCLUDED.title, air_date = EXCLUDED.air_date, runtime_min = EXCLUDED.runtime_min, fetched_at = NOW()"
