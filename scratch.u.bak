Tv.Parse.seasonFromFolders : [Text] -> Optional Nat
Tv.Parse.seasonFromFolders folders =
  use Optional None
  go = cases
    []        -> None
    f +: rest ->
      match seasonOfFolder f with
        Some s -> Some s
        None   -> go rest
  go (List.reverse folders)

Tv.Parse.seasonNat : Text -> Optional Nat
Tv.Parse.seasonNat t =
  match Nat.fromText t with
    Optional.None -> Optional.None
    Some n ->
      if n Nat.<= 99 || n Nat.>= 1900 && n Nat.<= 2030 then Some n
      else Optional.None

Tv.Parse.seasonOfFolder : Text -> Optional Nat
Tv.Parse.seasonOfFolder name =
  use List filterMap head
  use Optional None
  tokens = Tmdb.tokenize name
  pairs = withIndex tokens
  fromWord =
    use Nat +
    hits =
      filterMap
        (cases
          (i, t) ->
            if Universal.eq (Text.toLowercase t) "season" then
              match Tmdb.nth (i + 1) tokens with
                Some next -> seasonNat next
                None      -> None
            else None) pairs
    head hits
  match fromWord with
    Some s -> Some s
    None   -> head (filterMap sTokenSeason tokens)

Tv.Parse.sTokenSeason : Text -> Optional Nat
Tv.Parse.sTokenSeason t =
  use Nat <= >=
  use Optional None
  lower = Text.toLowercase t
  if Boolean.not (startsWith "s" lower) then None
  else
    rest = Text.drop 1 lower
    if Universal.eq (Text.size rest) 0 then None
    else
      match Nat.fromText rest with
        None   -> None
        Some n -> if n <= 99 || n >= 1900 && n <= 2030 then Some n else None

Tv.Parse.titleCutToken : Text -> Boolean
Tv.Parse.titleCutToken t =
  lower = Text.toLowercase t
  words =
    [ "season"
    , "seasons"
    , "stagione"
    , "stagioni"
    , "saison"
    , "saisons"
    , "temporada"
    , "staffel"
    , "collection"
    , "complete"
    , "tvrip"
    ]
  isWord = List.any (w -> Universal.eq w lower) words
  isRef = match refFromToken t with
    Some _        -> true
    Optional.None -> false
  isWord || isSeasonOnly t || isRef
    || isQualityToken t

Tv.Parse.titleTokens : [Text] -> [Text]
Tv.Parse.titleTokens tokens =
  use List +: reverse
  go acc = cases
    []        -> reverse acc
    t +: rest -> if isCutToken t then reverse acc else go (t +: acc) rest
  go [] tokens

Tv.Parse.tmdbTagFromFolders : [Text] -> Optional Nat
Tv.Parse.tmdbTagFromFolders folders =
  List.head (List.filterMap folderTmdbTag folders)

Tv.Rename.applyTv : Config -> Boolean -> '{IO, Exception} ()
Tv.Rename.applyTv cfg dryRun =
  do
    use Optional None
    intakeRoot = tvIntake (paths cfg)
    bufferRoot = tvBuffer (paths cfg)
    match splitTvFormat (tvFormat (paths cfg)) with
      None ->
        printLine
          "[tv-rename] tvFormat must be exactly show/season/file (two '/')"
      Some (showFmt, seasonFmt, fileFmt) ->
        _ =
          if dryRun then
            printLine
              "[tv-rename] DRY RUN: no files will be created, moved, or deleted"
          else
            if isDirectory (FilePath bufferRoot) then ()
            else
              _ = catch do createDirectory (FilePath bufferRoot)
              ()
        singleIO (toClientConfig cfg) do
          pqRows = prepareQuery selectEpisodeRenamableSql
          pqShow = prepareQuery selectShowSql
          pqSeason = prepareQuery selectSeasonSql
          pcPromote = prepareCommand promoteToBufferSql
          pcCache = prepareCommand upsertProbeCacheSql
          pcDelCache = prepareCommand deleteProbeCacheSql
          rowsResult = catch do
            portal = bindQuery pqRows []
            (rs, _) = executeQueryPortal portal 0
            rs
          rows = match rowsResult with
            Left f   ->
              use Text ++
              _ = printLine ("[tv-rename] QUERY FAILED: " ++ Failure.message f)
              []
            Right rs -> rs
          jobs = groupJobs rows
          _ =
            printLine
              ("[tv-rename] "
                Text.++ Nat.toText (List.size jobs)
                Text.++ " resolved episode file(s)")
          let
            renameGo = cases
              { r } -> r
              { priorTargetForCrc _ -> k } -> handle k None with renameGo
              { promoteToBuffer path name base folder crc size -> k } ->
                use List ++
                _ = 
                  catch do
                    bindAndExecuteCommand
                      pcPromote
                      (pt path
                        ++ pt name
                        ++ pt base
                        ++ pt folder
                        ++ pt crc
                        ++ pobi (Some size))
                handle k() with renameGo
              { upsertProbeCache path mt pr -> k } ->
                _ = upsertProbeCacheWith pcCache path mt pr
                handle k() with renameGo
              { deleteProbeCache path -> k } ->
                _ = catch do bindAndExecuteCommand pcDelCache (pt path)
                handle k() with renameGo
            step job =
              use Text ++
              _ = printLine ("processing: " ++ EpisodeJob.originalPath job)
              outcome =
                handle
                  executeEpisode
                    dryRun
                    pqShow
                    pqSeason
                    intakeRoot
                    bufferRoot
                    showFmt
                    seasonFmt
                    fileFmt
                    job
                with renameGo
              printTvOutcome outcome
            _ = Db.foreach_ step jobs
            _ = PreparedQuery.close pqRows
            _ = PreparedQuery.close pqShow
            _ = PreparedQuery.close pqSeason
            _ = PreparedCommand.close pcPromote
            _ = PreparedCommand.close pcCache
            _ = PreparedCommand.close pcDelCache
            printLine "[tv-rename] done"

Tv.Rename.episodeNfoFor : Optional Season -> EpisodeJob -> ProbeResult -> Text
Tv.Rename.episodeNfoFor seasonOpt job pr =
  use List flatMap
  use Optional None
  seasonNum = EpisodeJob.season job
  crc = EpisodeJob.crc32 job
  showName = EpisodeJob.showName job
  indexed = withIndex (EpisodeJob.episodes job)
  blocks =
    flatMap
      (cases
        (i, (epNum, fallbackTitle)) ->
          details = match seasonOpt with
            Some s -> episodeFor s epNum
            None   -> None
          episodeBlock
            showName
            seasonNum
            epNum
            fallbackTitle
            details
            (Universal.eq i 0)
            crc
            pr)
      indexed
  Text.join
    "\n"
    (flatMap
      (x -> x)
      [ ["<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\" ?>"]
      , blocks
      , [""]
      ])

Tv.Rename.executeEpisode :
  Boolean
  -> PreparedQuery r1 a1 Text
  -> PreparedQuery r a Text
  -> Text
  -> Text
  -> [FormatPart]
  -> [FormatPart]
  -> [FormatPart]
  -> EpisodeJob
  ->{IO, Exception, Postgres, RenameCatalog} TvRenameOutcome
Tv.Rename.executeEpisode
  dryRun pqShow pqSeason intakeRoot bufferRoot showFmt seasonFmt fileFmt job =
  use Boolean not
  use Failure message
  use Optional None
  use ProbeResult sizeBytes
  use Text ++
  use unison_json_1_4_2.Decoder run
  crc = EpisodeJob.crc32 job
  sourceText = EpisodeJob.originalPath job
  showId = EpisodeJob.showId job
  if not (enforceUnderRoot intakeRoot sourceText) then
    EpOutsideRoot sourceText intakeRoot
  else
    pjson = EpisodeJob.probeJson job
    match catch do run ProbeResult.fromJson pjson with
      Left f -> EpBadProbe sourceText (message f)
      Right pr ->
        showFolder = renderEpisode showFmt job pr
        seasonFolder = renderEpisode seasonFmt job pr
        base = renderEpisode fileFmt job pr
        showDirText = bufferRoot ++ "/" ++ showFolder
        seasonDirText = showDirText ++ "/" ++ seasonFolder
        videoExt = fileExt sourceText
        targetVideoText = seasonDirText ++ "/" ++ base ++ videoExt
        sourceVideo = FilePath sourceText
        if not (enforceUnderRoot bufferRoot seasonDirText) then
          EpOutsideRoot targetVideoText bufferRoot
        else
          tagged = crcTaggedEntries (FilePath seasonDirText) crc
          match tagged with
            _ +: _ ->
              dupVerified =
                anySizeMatch (FilePath seasonDirText) (sizeBytes pr) tagged
              if dupVerified then
                if dryRun then
                  EpWouldRemoveDuplicate sourceText targetVideoText
                else
                  _ = catch do removeFile sourceVideo
                  EpDuplicateRemoved sourceText targetVideoText
              else EpConflict sourceText targetVideoText
            [] ->
              if not (pathExists sourceVideo) then EpNoVideo sourceText
              else
                if pathExists (FilePath targetVideoText) then
                  EpConflict sourceText targetVideoText
                else
                  if dryRun then EpWouldRename sourceText targetVideoText
                  else
                    seasonBody =
                      readSeasonBodyWith
                        pqSeason showId (EpisodeJob.season job)
                    seasonOpt = match seasonBody with
                      None      -> None
                      Some body ->
                        match catch do run Season.fromJson body with
                          Right s -> Some s
                          Left _  -> None
                    showNfoText = match readShowBodyWith pqShow showId with
                      None      -> minimalShowNfo showId (showName job)
                      Some body ->
                        match catch do run ShowDetails.fromJson body with
                          Right d -> generateShowNfo d
                          Left _  -> minimalShowNfo showId (showName job)
                    epNfoText = episodeNfoFor seasonOpt job pr
                    fsOutcome = 
                      catch do
                        _ = ensureDir showDirText
                        _ = ensureDir seasonDirText
                        tvshowNfo = FilePath (showDirText ++ "/tvshow.nfo")
                        _ =
                          if pathExists tvshowNfo then ()
                          else writeFileUtf8 tvshowNfo showNfoText
                        _ =
                          writeFileUtf8
                            (FilePath (seasonDirText ++ "/" ++ base ++ ".nfo"))
                            epNfoText
                        renameFile sourceVideo (FilePath targetVideoText)
                    match fsOutcome with
                      Right _ ->
                        newName = base ++ videoExt
                        szInt = Nat.toInt (sizeBytes pr)
                        _ =
                          promoteToBuffer
                            targetVideoText
                            newName
                            base
                            seasonDirText
                            crc
                            szInt
                        _ =
                          match fileStat targetVideoText with
                            Some (mt, _) ->
                              upsertProbeCache targetVideoText mt pr
                            None -> ()
                        _ = deleteProbeCache sourceText
                        EpRenamed sourceText targetVideoText
                      Left f -> EpError sourceText (message f)

Tv.Rename.groupJobs :
  [( ((((((((Int, Text), Text), Text), Int), Text), Optional Int), Int), Int),
    Text)]
  -> [EpisodeJob]
Tv.Rename.groupJobs rows =
  use List +: :+
  use Nat fromInt
  use Optional getOrElse
  step acc = cases
    ( ((((((((fid, crc), opath), pjson), sid), sname), fyear), seas), ep),
      title) ->
      epNat = getOrElse 0 (fromInt ep)
      seasNat = getOrElse 0 (fromInt seas)
      sidNat = getOrElse 0 (fromInt sid)
      newJob =
        EpisodeJob
          fid
          crc
          opath
          pjson
          sidNat
          sname
          (optIntToNat fyear)
          seasNat
          [(epNat, title)]
      match acc with
        j +: rest ->
          if Universal.eq (EpisodeJob.fileId j) fid then
            EpisodeJob.episodes.modify (es -> es :+ (epNat, title)) j +: rest
          else newJob +: acc
        [] -> [newJob]
  List.reverse (List.foldLeft step [] rows)

Tv.Rename.printTvOutcome : TvRenameOutcome ->{IO, Exception} ()
Tv.Rename.printTvOutcome = cases
  EpRenamed _ tgt -> printLine ("  RENAMED -> " Text.++ tgt)
  EpWouldRename _ tgt -> printLine ("  DRY-RUN: would rename -> " Text.++ tgt)
  EpDuplicateRemoved _ tgt ->
    printLine
      ("  DUPLICATE -> source removed (already at " Text.++ tgt Text.++ ")")
  EpWouldRemoveDuplicate _ tgt ->
    printLine
      ("  DRY-RUN: would remove source as verified duplicate of " Text.++ tgt)
  EpNoVideo src -> printLine ("  SKIP: source file not found at " Text.++ src)
  EpConflict _ t -> printLine ("  SKIP: different file already at " Text.++ t)
  EpOutsideRoot path root ->
    printLine
      ("  REFUSED: "
        Text.++ path
        Text.++ " is not under expected root "
        Text.++ root)
  EpBadProbe _ msg -> printLine ("  SKIP: bad probe json: " Text.++ msg)
  EpError _ msg -> printLine ("  ERROR: " Text.++ msg)

Tv.Rename.renderEpisode : [FormatPart] -> EpisodeJob -> ProbeResult -> Text
Tv.Rename.renderEpisode parts job pr =
  render = cases
    Literal t             -> t
    FormatPart.Token name -> resolveEpisodeToken job pr name
  tighten (Text.join "" (List.map render parts))

Tv.Rename.resolveEpisodeToken : EpisodeJob -> ProbeResult -> Text -> Text
Tv.Rename.resolveEpisodeToken job pr tok =
  use EpisodeJob episodes season
  use List map
  use Nat toText
  use Optional None
  use ProbeResult durationSec primaryAudio sizeBytes
  use Text ++ join
  use VideoInfo height width
  vid = ProbeResult.video pr
  epNums = map (cases (n, _) -> n) (episodes job)
  epTitles = map (cases (_, t) -> t) (episodes job)
  pad2 n = padLeft 2 "0" (toText n)
  nameSan = sanitize (showName job)
  match tok with
    "n" -> nameSan
    "y" ->
      match firstAirYear job with
        Some y -> toText y
        None   -> "0000"
    "ny" ->
      match firstAirYear job with
        Some y -> nameSan ++ " (" ++ toText y ++ ")"
        None   -> nameSan
    "s" -> toText (season job)
    "s00" -> pad2 (season job)
    "e00" -> join "E" (map pad2 epNums)
    "t" -> sanitize (join " + " epTitles)
    "crc32" -> EpisodeJob.crc32 job
    "gigabytes" -> gigabytes (sizeBytes pr)
    "vf" -> vfTag (width vid) (height vid)
    "vc" -> vcTag (VideoInfo.codec vid)
    "bitdepth" -> toText (VideoInfo.bitDepth vid)
    "minutes" -> toText (Rename.minutes (durationSec pr))
    "resolution" -> resolutionStr (width vid) (height vid)
    "mbps" ->
      mbps
        (effectiveBitRate
          (VideoInfo.bitRate vid) (sizeBytes pr) (durationSec pr))
    "ac" ->
      match primaryAudio pr with
        Some a -> acTag (AudioInfo.codec a)
        None   -> "noaudio"
    "channels" ->
      match primaryAudio pr with
        Some a -> channelsTag (AudioInfo.channels a)
        None   -> "0"
    _ -> ""

Tv.Rename.selectEpisodeRenamableSql :
  postgres.Query
    r
    r
    ( ((((((((Int, Text), Text), Text), Int), Text), Optional Int), Int), Int),
      Text)
Tv.Rename.selectEpisodeRenamableSql =
  use Codec text
  sql
    "SELECT f.file_id, f.crc32, f.original_path, f.probe_json, s.tmdb_show_id, s.name, s.first_air_year, a.season, a.episode, e.title FROM files f JOIN episode_associations a ON a.file_id = f.file_id JOIN shows s ON s.tmdb_show_id = a.tmdb_show_id JOIN episodes e ON e.tmdb_show_id = a.tmdb_show_id AND e.season = a.season AND e.episode = a.episode WHERE f.stage = 'staging' AND f.media_kind = 'episode' ORDER BY f.file_id, a.season, a.episode"
    |> typedQuery
      (bigint
        ~ text
        ~ text
        ~ text
        ~ integer
        ~ text
        ~ Codec.optional integer
        ~ integer
        ~ integer
        ~ text)

Tv.Rename.splitTvFormat :
  Text -> Optional ([FormatPart], [FormatPart], [FormatPart])
Tv.Rename.splitTvFormat fmt =
  match Text.split ?/ fmt with
    [showF, seasonF, fileF] ->
      Some (parseFormat showF, parseFormat seasonF, parseFormat fileF)
    _ -> Optional.None

Tv.Resolve.batchInteract : '{g, TvInteract} a ->{g} a
Tv.Resolve.batchInteract body =
  h = cases
    { a }                        -> a
    { chooseShow _ _ -> resume } -> handle resume Optional.None with h
  handle body() with h

Tv.Resolve.deleteFileAssocSql : Command a (Int ->{g, g1} a)
Tv.Resolve.deleteFileAssocSql =
  sql "DELETE FROM episode_associations WHERE file_id = "
    %% StatementBuilder.var bigint
    |> buildCommand

Tv.Resolve.identify : Config ->{IO, Exception} ()
Tv.Resolve.identify cfg = Tv.Resolve.runWith true cfg

Tv.Resolve.printOutcome : Tv.Resolve.Outcome ->{IO, Exception} ()
Tv.Resolve.printOutcome = cases
  TvResolved fid showId seasonNum eps conf source ->
    printLine
      (Text.join
        ""
        [ "  file "
        , Int.toText fid
        , " -> tv:"
        , Nat.toText showId
        , " S"
        , Nat.toText seasonNum
        , " E"
        , Text.join "," (List.map Nat.toText eps)
        , " ("
        , Nat.toText conf
        , "%, "
        , source
        , ")"
        ])
  NoEpisodeRef fid name ->
    printLine
      (Text.join
        "" ["  file ", Int.toText fid, " -> no SxxEyy in \"", name, "\""])
  NoShowHint fid ->
    printLine ("  file " Text.++ Int.toText fid Text.++ " -> no show title")
  NoShowMatch fid reason ->
    printLine
      (Text.join "" ["  file ", Int.toText fid, " -> no show match: ", reason])
  TvDetailsFailed fid showId err ->
    printLine
      (Text.join
        ""
        [ "  file "
        , Int.toText fid
        , " -> show "
        , Nat.toText showId
        , " details failed: "
        , err
        ])
  TvSeasonFailed fid showId seasonNum err ->
    printLine
      (Text.join
        ""
        [ "  file "
        , Int.toText fid
        , " -> tv:"
        , Nat.toText showId
        , " S"
        , Nat.toText seasonNum
        , " fetch failed: "
        , err
        ])
  TvEpisodeMissing fid showId seasonNum missing ->
    printLine
      (Text.join
        ""
        [ "  file "
        , Int.toText fid
        , " -> tv:"
        , Nat.toText showId
        , " S"
        , Nat.toText seasonNum
        , " has no episode(s) "
        , Text.join "," (List.map Nat.toText missing)
        , " (refused)"
        ])

Tv.Resolve.resolveOne :
  Boolean
  -> Text
  -> Tv.Resolve.FileRow
  ->{TvMetaApi, TvCatalog} Tv.Resolve.Outcome
Tv.Resolve.resolveOne dryRun token row =
  use Optional None
  fid = Tv.Resolve.FileRow.fileId row
  oname = Tv.Resolve.FileRow.originalName row
  baseName = basenameNoExt oname
  folders = foldersOfPath (FileRow.originalPath row)
  refData = match parseEpisodeName baseName with
    Some p -> Some (ParsedEpisode.ref p, titlePrefix p)
    None   ->
      match refFromFolders folders baseName with
        Some r -> Some (r, None)
        None   -> None
  match refData with
    None -> NoEpisodeRef fid oname
    Some (ref, fileTitle) ->
      seasonNum = EpisodeRef.season ref
      eps = EpisodeRef.episodes ref
      directTmdb = match hintShowTmdbId row with
        Some sid -> Some (sid, "nfo_id")
        None     ->
          match tmdbTagFromFolders folders with
            Some sid -> Some (sid, "folder_tag")
            None     -> None
      showPick = match directTmdb with
        Some (sid, src) -> Right (sid, 100, src)
        None            -> resolveShowPick token folders fileTitle row fid
      match showPick with
        Left o -> o
        Right (showId, conf, source) ->
          detailsResult = showDetails showId
          match detailsResult with
            Left err -> TvDetailsFailed fid showId err
            Right _ ->
              seasonResult = seasonFor showId seasonNum
              match seasonResult with
                Left err -> TvSeasonFailed fid showId seasonNum err
                Right seasonData ->
                  missing =
                    List.filter
                      (epNum -> (match episodeFor seasonData epNum with
                        None   -> true
                        Some _ -> false)) eps
                  if Boolean.not (Universal.eq (List.size missing) 0) then
                    TvEpisodeMissing fid showId seasonNum missing
                  else
                    _ =
                      if dryRun then ()
                      else
                        recordEpisodeMatch fid showId seasonNum eps conf source
                    TvResolved fid showId seasonNum eps conf source

test> Tv.Resolve.resolveOne.dryRunNoWrite.test =
  use Optional None
  scriptedMeta = cases
    { r } -> r
    { searchShows _ _ -> k } ->
      handle k (Right (Tv.Tmdb.SearchResponse.SearchResponse []))
      with scriptedMeta
    { showDetails _ -> k } ->
      handle k (Right testShowDetails) with scriptedMeta
    { seasonFor _ _ -> k } ->
      handle k (Right testSeasonOneEp) with scriptedMeta
    { findShowByImdbApi _ -> k } -> handle k (Left "no") with scriptedMeta
  recordingCatalog = cases
    { r } -> (r, None)
    { lookupShowByImdbDb _ -> k } -> handle k None with recordingCatalog
    { recordEpisodeMatch fid sid sea eps conf src -> k } ->
      (res, _) = handle k() with recordingCatalog
      (res, Some (fid, sid, sea, eps, conf, src))
  row =
    Tv.Resolve.FileRow.FileRow
      +5
      "Severance.S01E01.mkv"
      None
      None
      (Some 100)
      None
      "/tv/Severance/Season 01/Severance.S01E01.mkv"
  (outcome, written) =
    handle handle Tv.Resolve.resolveOne true "tok" row with recordingCatalog
    with scriptedMeta
  okOutcome = match outcome with
    TvResolved _ _ _ _ _ _ -> true
    _                      -> false
  List.flatMap check [okOutcome, Universal.eq written None]

