mig : '{IO, Exception} ()
mig = do migrate fromEnv()

Move.commitFolder : Text -> Text ->{IO} Either Text ()
Move.commitFolder src dst =
  match catch do proc.execute "mv" ["-T", "--", src, dst] with
    Left f -> Left (Failure.message f)
    Right (code, _, err) ->
      if code Nat.== 0 then Right()
      else Left ("mv exit " Text.++ Nat.toText code Text.++ ": " Text.++ err)

Move.deviceOf : Text ->{IO} Optional Text
Move.deviceOf path = statField "%d" path

Move.enforceUnderRoot : Text -> Text -> Boolean
Move.enforceUnderRoot libraryRoot dstFolder =
  use Text ++
  prefix = libraryRoot ++ "/"
  startsWith prefix dstFolder

Move.ensureDir : Text ->{IO, Exception} ()
Move.ensureDir path =
  fp = FilePath path
  if isDirectory fp then ()
  else
    _ = catch do createDirectory fp
    ()

Move.epochSeconds : '{IO} Nat
Move.epochSeconds = do match systemTime.impl() with
  Right n -> n
  Left _  -> 0

Move.folderVideoBytes : FilePath ->{IO, Exception} Nat
Move.folderVideoBytes folder =
  use Optional None
  files = directoryContents.texts folder
  match findFirstVideo files with
    None   -> 0
    Some v ->
      match fileStat (filePathText (pathJoin folder v)) with
        Some (_, sz) -> sz
        None         -> 0

Move.loadIdentity :
  PreparedQuery r a (((Int, Text), Int), Text)
  -> Text
  ->{Postgres} Optional FileIdentity
Move.loadIdentity pq bufferPath = match 
  catch do
    portal = bindQuery pq (pt bufferPath)
    (rows, _) = executeQueryPortal portal 0
    rows
 with
  Left _   -> Optional.None
  Right rs ->
    match List.map rowToIdentity rs with
      ident +: _ -> Some ident
      []         -> Optional.None

Move.moveChunkSize : Nat
Move.moveChunkSize = 25

Move.moveFolder :
  Boolean -> Text -> FilePath ->{IO, MovieMoveCatalog, Exception} ()
Move.moveFolder dryRun libraryRoot folder =
  use Boolean not
  use List size
  use Nat - toText
  use Text ++
  folderName = filePathBasename folder
  srcText = filePathText folder
  dstText = libraryRoot ++ "/" ++ folderName
  _ = printLine ("MOVE: " ++ folderName)
  if not (enforceUnderRoot libraryRoot dstText) then
    printLine "  abort: destination not under library root"
  else
    if isDirectory (FilePath dstText) then
      printLine ("  abort: destination already exists in library: " ++ dstText)
    else
      entries = directoryContents.texts folder
      videoPaths = match findFirstVideo entries with
        Some v        -> [filePathText (pathJoin folder v)]
        Optional.None -> []
      _ = printLine ("  " ++ toText (size videoPaths) ++ " video file(s)")
      verified = List.map verifyFile videoPaths
      verifiedCount = size (List.filter (cases (_, ok, _) -> ok) verified)
      _ =
        printLine
          ("  identity verified: "
            ++ toText verifiedCount
            ++ "/"
            ++ toText (size verified))
      sameDev = sameDevice srcText libraryRoot
      if dryRun then
        method =
          if sameDev then "atomic rename" else "rsync to partial then commit"
        _ =
          printLine
            ("  DRY-RUN: would create new library folder at "
              ++ dstText
              ++ " via "
              ++ method)
        printLine
          ("  DRY-RUN: would update "
            ++ toText verifiedCount
            ++ " by identity, "
            ++ toText (size verified - verifiedCount)
            ++ " by name")
      else
        moveOk = transferFolder sameDev srcText dstText libraryRoot
        if not moveOk then ()
        else
          applyOne = cases
            (oldPath, ok, identOpt) ->
              updateMovieFile srcText dstText oldPath ok identOpt
          _ = Db.foreach_ applyOne verified
          printLine ("  promoted -> " ++ dstText)

Move.partialRoot : Text -> Text
Move.partialRoot libraryRoot =
  use Text ++
  libraryRoot ++ "/.unidork-partial"

Move.planOne : Text -> Optional a -> FilePath ->{IO, Exception} ()
Move.planOne libraryRoot trustedIdent folder =
  use Text ++
  folderName = filePathBasename folder
  srcText = filePathText folder
  dstFolderText = libraryRoot ++ "/" ++ folderName
  identityLine =
    match trustedIdent with
      Some _ -> "  identity: verified from files table"
      Optional.None ->
        "  identity: NOT verified (a real run would re-probe at the buffer location)"
  _ = printLine identityLine
  if Boolean.not (enforceUnderRoot libraryRoot dstFolderText) then
    printLine
      ("  DRY-RUN: would abort, destination not under library root: "
        ++ dstFolderText)
  else
    if isDirectory (FilePath dstFolderText) then
      printLine
        ("  DRY-RUN: would abort, destination already exists in library: "
          ++ dstFolderText)
    else
      method =
        if sameDevice srcText libraryRoot then "atomic rename"
        else "rsync to partial root, then commit"
      printLine
        ("  DRY-RUN: would promote via " ++ method ++ " -> " ++ dstFolderText)

Move.printProgress :
  Nat -> Nat -> Nat -> mutable.Ref g (Nat, Nat) ->{g, IO, Exception} ()
Move.printProgress totalFolders totalBytes startEpoch counter =
  Progress.report "folders" totalFolders totalBytes startEpoch counter

Move.removeFolderTree : Text ->{IO} Either Text ()
Move.removeFolderTree path =
  use Nat ==
  use Text ++
  t = Text.trim path
  bad = List.any (b -> Universal.eq b t) ["", "/"]
  if bad
    || Boolean.not (startsWith "/" t) then
    Left ("refusing to delete suspicious path: '" ++ path ++ "'")
  else
    match catch do proc.execute "rm" ["-rf", "--", t] with
      Left f -> Left (Failure.message f)
      Right (code, _, err) ->
        if code == 0 then Right()
        else Left ("rm exit " ++ Nat.toText code ++ ": " ++ err)

Move.rmdirFolder : Text ->{IO} ()
Move.rmdirFolder folder =
  _ = catch do proc.execute "rmdir" [folder]
  ()

Move.rowToIdentity : (((Int, Text), Int), Text) -> FileIdentity
Move.rowToIdentity = cases
  (((fid, crc), sz), name) -> FileIdentity fid crc sz name

Move.rsyncFolder : Text -> Text ->{IO} Either Text ()
Move.rsyncFolder srcFolder dstFolder =
  match catch do
    proc.execute "rsync" ["-a", srcFolder Text.++ "/", dstFolder Text.++ "/"] with
    Left f -> Left (Failure.message f)
    Right (code, _, err) ->
      if code Nat.== 0 then Right()
      else
        Left ("rsync exit " Text.++ Nat.toText code Text.++ ": " Text.++ err)

Move.run : Config -> Optional Text -> Boolean ->{IO, Exception} ()
Move.run cfg maybeFolderName dryRun =
  use Db foreach_
  use List size
  use Nat +
  use Universal eq
  bufferRoot = buffer (paths cfg)
  libraryRoot = library (paths cfg)
  bufferFp = FilePath bufferRoot
  if Boolean.not (isDirectory bufferFp) then
    printLine ("buffer not found: " Text.++ bufferRoot)
  else
    _ =
      if dryRun then
        printLine "[move] DRY RUN: no files will be moved or deleted"
      else ()
    folders =
      match maybeFolderName with
        Some name ->
          use Text ++
          trimmed = Text.trim name
          bad = List.any (b -> eq b trimmed) ["", ".", ".."]
          if bad then
            _ =
              printLine
                ("refusing to move: invalid folder name: '" ++ name ++ "'")
            []
          else
            fp = pathJoin bufferFp trimmed
            if isDirectory fp then [fp]
            else
              _ = printLine ("no such buffer folder: " ++ name)
              []
        Optional.None ->
          entries = directoryContents.texts bufferFp
          names =
            List.filter
              (n ->
                (if eq n "." then false
                else
                  if eq n ".." then false
                  else isDirectory (pathJoin bufferFp n)))
              entries
          List.map (n -> pathJoin bufferFp n) names
    _ =
      printLine
        ("[move] "
          Text.++ Nat.toText (size folders)
          Text.++ " folder(s) to promote")
    if eq (size folders) 0 then ()
    else
      _ = if dryRun then () else sweepPartial libraryRoot
      chunks = List.chunk moveChunkSize folders
      total = size folders
      counter = IO.ref (0, 0)
      startEpoch = epochSeconds()
      runChunk chunk = 
        singleIO (toClientConfig cfg) do
          pqIdent = prepareQuery selectFileByPathSql
          pcById = prepareCommand updateFilePathSql
          pcByName = prepareCommand updatePathSql
          moveGo = cases
            { r } -> r
            { identityForFile path -> k } ->
              handle k (loadIdentity pqIdent path) with moveGo
            { updateFilePathById newPath newName crc sz -> k } ->
              use List ++
              _ = 
                catch do
                  bindAndExecuteCommand
                    pcById
                    (pt newPath ++ pt newName ++ pt crc ++ pobi (Some sz))
              handle k() with moveGo
            { updateFilePathByName newPath newName oldPath -> k } ->
              use List ++
              _ = 
                catch do
                  bindAndExecuteCommand
                    pcByName (pt newPath ++ pt newName ++ pt oldPath)
              handle k() with moveGo
          safeMove folder =
            use Text ++
            outcome = 
              catch do handle moveFolder dryRun libraryRoot folder with moveGo
            _ = match outcome with
              Right _ -> ()
              Left f  -> printLine ("  FOLDER FAILED: " ++ Failure.message f)
            ()
          _ = foreach_ safeMove chunk
          (dn, _) = mutable.Ref.read counter
          _ = mutable.Ref.write counter (dn + size chunk, 0)
          _ = Move.printProgress total 0 startEpoch counter
          _ = PreparedQuery.close pqIdent
          _ = PreparedCommand.close pcById
          PreparedCommand.close pcByName
      foreach_ runChunk chunks

Move.sameDevice : Text -> Text ->{IO} Boolean
Move.sameDevice a b = match (deviceOf a, deviceOf b) with
  (Some x, Some y) -> Universal.eq x y
  _                -> false

Move.selectFileByPathSql :
  postgres.Query a (Text ->{g, g1} a) (((Int, Text), Int), Text)
Move.selectFileByPathSql =
  use Codec text
  sql
    "SELECT f.file_id, f.crc32, f.size_bytes, f.original_name FROM files f WHERE f.original_path = "
    %% StatementBuilder.var text
    |> typedQuery (bigint ~ text ~ bigint ~ text)

Move.sweepPartial : Text ->{IO, Exception} ()
Move.sweepPartial libraryRoot =
  use Text ++
  pr = partialRoot libraryRoot
  if isDirectory (FilePath pr) then
    _ = printLine ("[move] sweeping crashed partial transfers: " ++ pr)
    match removeFolderTree pr with
      Left e  -> printLine ("[move] sweep failed: " ++ e)
      Right _ -> ()
  else ()

Move.transferFolder : Boolean -> Text -> Text -> Text ->{IO, Exception} Boolean
Move.transferFolder sameDev srcText dstText libraryRoot =
  use Text ++
  if sameDev then
    _ = printLine "  transfer: atomic rename (same filesystem)"
    match commitFolder srcText dstText with
      Left err ->
        _ = printLine ("  abort: move failed: " ++ err)
        false
      Right _  -> true
  else
    _ =
      printLine "  transfer: rsync to partial, then commit (cross filesystem)"
    pRoot = partialRoot libraryRoot
    folderBase = filePathBasename (FilePath srcText)
    partialDst = pRoot ++ "/" ++ folderBase
    _ = ensureDir pRoot
    match rsyncFolder srcText partialDst with
      Left err ->
        _ = printLine ("  abort: rsync to partial failed: " ++ err)
        false
      Right _  ->
        match commitFolder partialDst dstText with
          Left err ->
            _ = printLine ("  abort: commit from partial failed: " ++ err)
            false
          Right _  ->
            _ = match removeFolderTree srcText with
              Left e  -> printLine ("  warn: source cleanup failed: " ++ e)
              Right _ -> ()
            ()
            true

Move.updateFilePathSql :
  Command a (Text ->{g6, g7} Text ->{g4, g5} Text ->{g2, g3} Int ->{g, g1} a)
Move.updateFilePathSql =
  use Codec text
  use StatementBuilder var
  sql "UPDATE files SET original_path = "
    %% var text
    %% sql ", original_name = "
    %% var text
    %% sql ", stage = 'library' WHERE crc32 = "
    %% var text
    %% sql " AND size_bytes = "
    %% var bigint
    |> buildCommand

Move.updateMovieFile :
  Text
  -> Text
  -> Text
  -> Boolean
  -> Optional FileIdentity
  ->{IO, MovieMoveCatalog, Exception} ()
Move.updateMovieFile srcText dstText oldPath verified identOpt =
  use Text ++
  rel = Text.drop (Text.size srcText) oldPath
  newPath = dstText ++ rel
  newName = filePathBasename (FilePath newPath)
  match (verified, identOpt) with
    (true, Some ident) ->
      crc = FileIdentity.crc32 ident
      sz = FileIdentity.sizeBytes ident
      updateFilePathById newPath newName crc sz
    _ ->
      _ =
        printLine
          ("  WARN identity-unverified, path updated by name: " ++ oldPath)
      updateFilePathByName newPath newName oldPath

Move.verifyFile :
  Text
  ->{IO, MovieMoveCatalog, Exception} (Text, Boolean, Optional FileIdentity)
Move.verifyFile oldPath =
  use Int toText
  use Optional None
  use Text ==
  identOpt = identityForFile oldPath
  match identOpt with
    None -> (oldPath, false, None)
    Some ident ->
      diskOk =
        match fileStat oldPath with
          None -> false
          Some (_, sz) ->
            toText (FileIdentity.sizeBytes ident) == toText (Nat.toInt sz)
      (oldPath, diskOk, Some ident)

Movie.fromJson : '{unison_json_1_3_5.Decoder} Movie
Movie.fromJson =
  do
    use Decoder nat optional! text
    use object at at!
    id = at! "id" MovieId.fromJson
    title = at! "title" Title.fromJson
    collection = optional! (at "collection" text)
    runtime = optional! (at "runtime" nat)
    scoring = at! "scoring" Scoring.fromJson
    plot = at! "plot" text
    tagline = at! "tagline" text
    taxonomy = at! "taxonomy" Taxonomy.fromJson
    fileInfo = at! "fileInfo" FileInfo.fromJson
    videoFilePath = optional! (at "videoFilePath" text)
    checksum = optional! (at "checksum" text)
    actors = at! "actors" (Decoder.array Actor.fromJson)
    folderPath = optional! (at "folderPath" text)
    nfoPath = optional! (at "nfoPath" text)
    fileSizeBytes = optional! (at "fileSizeBytes" nat)
    folderMeta = at! "folderMeta" FolderMeta.fromJson
    Movie
      id
      title
      collection
      runtime
      scoring
      plot
      tagline
      taxonomy
      fileInfo
      videoFilePath
      checksum
      actors
      folderPath
      nfoPath
      fileSizeBytes
      folderMeta

Movie.fromNdjsonLine : Text -> Either Failure Movie
Movie.fromNdjsonLine line = 
  catch do unison_json_1_4_2.Decoder.run Movie.fromJson (Text.trim line)

test> Movie.roundtrip.test =
  encoded = toNdjsonLine exampleMovie
  match fromNdjsonLine encoded with
    Left failure -> [Fail (Failure.message failure)]
    Right m      -> check (Universal.eq m exampleMovie)

Movie.toJson : Movie -> Json
Movie.toJson m =
  use Json nat text
  Json.object
    [ ("id", MovieId.toJson (Movie.id m))
    , ("title", Title.toJson (Movie.title m))
    , ("collection", toJsonOpt text (Movie.collection m))
    , ("runtime", toJsonOpt nat (Movie.runtime m))
    , ("scoring", Scoring.toJson (scoring m))
    , ("plot", text (plot m))
    , ("tagline", text (Movie.tagline m))
    , ("taxonomy", Taxonomy.toJson (taxonomy m))
    , ("fileInfo", FileInfo.toJson (fileInfo m))
    , ("videoFilePath", toJsonOpt text (videoFilePath m))
    , ("checksum", toJsonOpt text (Movie.checksum m))
    , ("actors", Json.array (List.map Actor.toJson (actors m)))
    , ("folderPath", toJsonOpt text (folderPath m))
    , ("nfoPath", toJsonOpt text (nfoPath m))
    , ("fileSizeBytes", toJsonOpt nat (fileSizeBytes m))
    , ("folderMeta", FolderMeta.toJson (folderMeta m))
    ]

Movie.toNdjsonLine : Movie -> Text
Movie.toNdjsonLine m =
  use Text ++
  Json.toText (Movie.toJson m) ++ "\n"

MovieId.fromJson : '{unison_json_1_3_5.Decoder} MovieId
MovieId.fromJson = do
  use Decoder optional! text
  use object at
  kodi = object.at! "kodi" text
  imdb = optional! (at "imdb" text)
  tmdb = optional! (at "tmdb" text)
  tvdb = optional! (at "tvdb" text)
  MovieId kodi imdb tmdb tvdb

MovieId.toJson : MovieId -> Json
MovieId.toJson m =
  use Json text
  Json.object
    [ ("kodi", text (kodi m))
    , ("imdb", toJsonOpt text (imdb m))
    , ("tmdb", toJsonOpt text (tmdb m))
    , ("tvdb", toJsonOpt text (tvdb m))
    ]

Nfo.actorBlock : (Text, Text) -> [Text]
Nfo.actorBlock = cases
  (name, role) ->
    use Text ++
    esc = escapeXml
    [ "  <actor>"
    , "    <name>" ++ esc name ++ "</name>"
    , "    <role>" ++ esc role ++ "</role>"
    , "  </actor>"
    ]

Nfo.allText : Soup ->{Throw XMLError} Text
Nfo.allText s = Text.join "" (Soup.texts s)

Nfo.aspectRatio : Nat -> Nat -> Text
Nfo.aspectRatio w h =
  use Nat % * + / toText
  use Text ++
  if Universal.eq h 0 then "0.000"
  else
    rounded = (w * 1000 + h / 2) / h
    whole = rounded / 1000
    frac = rounded % 1000
    fracStr = padLeft 3 "0" (toText frac)
    toText whole ++ "." ++ fracStr

test> Nfo.aspectRatio.test =
  use Universal eq
  List.flatMap
    check
    [ eq (aspectRatio 1920 1080) "1.778"
    , eq (aspectRatio 640 480) "1.333"
    , eq (aspectRatio 1280 720) "1.778"
    , eq (aspectRatio 100 100) "1.000"
    , eq (aspectRatio 100 0) "0.000"
    ]

Nfo.audioBlock : AudioInfo -> [Text]
Nfo.audioBlock a =
  use Text ++
  esc = escapeXml
  [ "      <audio>"
  , "        <codec>" ++ esc (AudioInfo.codec a) ++ "</codec>"
  , "        <language>" ++ esc (AudioInfo.language a) ++ "</language>"
  , "        <channels>" ++ Nat.toText (AudioInfo.channels a) ++ "</channels>"
  , "      </audio>"
  ]

Nfo.countryLine : Text -> Text
Nfo.countryLine c =
  use Text ++
  "  <country>" ++ escapeXml c ++ "</country>"

Nfo.descendantAttr : Text -> Text -> Soup -> Optional Text
Nfo.descendantAttr elemName attrName s = 
  Throw.toOptional do Soup.attribute attrName (Soup.findFirst elemName s)

Nfo.directorLine : Text -> Text
Nfo.directorLine d =
  use Text ++
  "  <director>" ++ escapeXml d ++ "</director>"

Nfo.extractImdbId : Movie -> Optional Text
Nfo.extractImdbId m = imdb (Movie.id m)

Nfo.extractTitle : Movie -> Optional Text
Nfo.extractTitle m =
  t = Title.display (Movie.title m)
  if Universal.eq (Text.size t) 0 then Optional.None else Some t

Nfo.extractTmdbId : Movie -> Optional Nat
Nfo.extractTmdbId m = match tmdb (Movie.id m) with
  Optional.None -> Optional.None
  Some s        -> Nat.fromText (Text.trim s)

Nfo.extractYear : Movie -> Optional Nat
Nfo.extractYear m = Scoring.year (scoring m)

Nfo.fileinfoBlock : ProbeResult -> [Text]
Nfo.fileinfoBlock pr =
  use List flatMap
  use Nat toText
  esc = escapeXml
  vid = ProbeResult.video pr
  vc = VideoInfo.codec vid
  vw = VideoInfo.width vid
  vh = VideoInfo.height vid
  videoLines =
    [ "      <video>"
    , "        <codec>" Text.++ esc vc Text.++ "</codec>"
    , "        <aspect>" Text.++ aspectRatio vw vh Text.++ "</aspect>"
    , "        <width>" Text.++ toText vw Text.++ "</width>"
    , "        <height>" Text.++ toText vh Text.++ "</height>"
    , "      </video>"
    ]
  audioLines = flatMap audioBlock (ProbeResult.audios pr)
  subtitleLines = flatMap subtitleBlock (ProbeResult.subtitles pr)
  result =
    ["  <fileinfo>", "    <streamdetails>"]
      List.++ videoLines
      List.++ audioLines
      List.++ subtitleLines
      List.++ ["    </streamdetails>", "  </fileinfo>"]
  result

Nfo.floatOr : Float -> Text -> Float
Nfo.floatOr default t = Optional.getOrElse default (Float.fromText t)

Nfo.generate : Tmdb.Result -> Details -> ProbeResult -> Text
Nfo.generate _r d pr =
  use Details title
  use List map
  use Nat >
  use Optional None
  use Text join size
  use Universal eq
  esc = escapeXml
  yearText = match releaseYear (Details.releaseDate d) with
    Some y -> Nat.toText y
    None   -> ""
  releaseDate = Details.releaseDate d
  imdbId = Optional.getOrElse "" (Details.imdbId d)
  tmdbText = Nat.toText (Details.tmdbId d)
  crc32 = ProbeResult.crc32 pr
  sortTitle = Nfo.sortTitle (title d) releaseDate
  setBlock = match Details.collection d with
    Some col -> ["  <set>" Text.++ esc col Text.++ "</set>"]
    None     -> ["  <set />"]
  premieredBlock =
    if size releaseDate > 0 then
      ["  <premiered>" Text.++ esc releaseDate Text.++ "</premiered>"]
    else []
  tmdbUniqueId =
    [ join
        ""
        [ "  <uniqueid type=\"tmdb\" default=\"true\">"
        , tmdbText
        , "</uniqueid>"
        ]
    ]
  imdbUniqueId =
    if eq (size imdbId) 0 then []
    else [join "" ["  <uniqueid type=\"imdb\">", esc imdbId, "</uniqueid>"]]
  crcUniqueId =
    if eq (size crc32) 0 then []
    else [join "" ["  <uniqueid type=\"crc32\">", esc crc32, "</uniqueid>"]]
  uniqueIdLines = tmdbUniqueId List.++ imdbUniqueId List.++ crcUniqueId
  genreLines = map genreLine (Details.genres d)
  tagLines = map tagLine (Details.tags d)
  countryLines = map countryLine (productionCountries d)
  studioLines = map studioLine (productionStudios d)
  directorLines = map directorLine (Details.directors d)
  writerLines = map writerLine (writers d)
  actorLines = List.flatMap actorBlock (Details.cast d)
  fileinfoLines = fileinfoBlock pr
  header =
    [ "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\" ?>"
    , "<movie>"
    , "  <title>" Text.++ esc (title d) Text.++ "</title>"
    , "  <originaltitle>"
        Text.++ esc (Details.originalTitle d)
        Text.++ "</originaltitle>"
    , "  <sorttitle>" Text.++ esc sortTitle Text.++ "</sorttitle>"
    ]
  scoring =
    [ "  <year>" Text.++ yearText Text.++ "</year>"
    , "  <rating>"
        Text.++ Float.toText (Details.voteAverage d)
        Text.++ "</rating>"
    , "  <votes>" Text.++ Nat.toText (Details.voteCount d) Text.++ "</votes>"
    , "  <mpaa>" Text.++ esc (Details.mpaa d) Text.++ "</mpaa>"
    , "  <id>" Text.++ esc imdbId Text.++ "</id>"
    ]
  plotEtc =
    [ "  <plot>" Text.++ esc (Details.overview d) Text.++ "</plot>"
    , "  <tagline>" Text.++ esc (Details.tagline d) Text.++ "</tagline>"
    , "  <runtime>" Text.++ Nat.toText (Details.runtime d) Text.++ "</runtime>"
    ]
  imdbElem =
    if eq (size imdbId) 0 then []
    else
      [ join
          ""
          [ "  <imdb id='"
          , imdbId
          , "'>http://www.imdb.com/title/"
          , imdbId
          , "</imdb>"
          ]
      ]
  tmdbElem =
    [ join
        ""
        [ "  <tmdb id='"
        , tmdbText
        , "'>http://www.themoviedb.org/movie/"
        , tmdbText
        , "</tmdb>"
        ]
    ]
  urlElems = imdbElem List.++ tmdbElem
  footer = ["</movie>", ""]
  allLines =
    header
      List.++ setBlock
      List.++ scoring
      List.++ premieredBlock
      List.++ uniqueIdLines
      List.++ plotEtc
      List.++ genreLines
      List.++ tagLines
      List.++ countryLines
      List.++ studioLines
      List.++ actorLines
      List.++ directorLines
      List.++ writerLines
      List.++ fileinfoLines
      List.++ urlElems
      List.++ footer
  join "\n" allLines

Nfo.genreLine : Text -> Text
Nfo.genreLine g =
  use Text ++
  "  <genre>" ++ escapeXml g ++ "</genre>"

Nfo.natOr : Nat -> Text -> Nat
Nfo.natOr default t = Optional.getOrElse default (Nat.fromText t)

Nfo.optText : Text -> Soup -> Optional Text
Nfo.optText tag s =
  match tryXml do allText (Soup.findFirst tag s) with
    Some t -> if Universal.eq (Text.size t) 0 then Optional.None else Some t
    Optional.None -> Optional.None

Nfo.padLeft : Nat -> Text -> Text -> Text
Nfo.padLeft target pad t =
  use Nat <
  use Text ++
  if Text.size t < target then Nfo.padLeft target pad (pad ++ t) else t

Nfo.parse : Text -> Either Text Movie
Nfo.parse xml = match withXML xml parseMovie with
  Left err       -> Left err
  Right (m +: _) -> Right m
  Right []       -> Left "no <movie> element found"

test> Nfo.parse.test =
  match Nfo.parse sampleNfo with
    Left err -> [Fail err]
    Right m ->
      check
        (Universal.eq (Title.display (Movie.title m)) "The Return of the King")

Nfo.parseActor : Soup ->{Throw XMLError} Actor
Nfo.parseActor s =
  name = textOr "" "name" s
  role = textOr "" "role" s
  Actor.Actor name role

Nfo.parseActors : Soup -> [Actor]
Nfo.parseActors s = silentBranches do
  a = Soup.named "actor" s
  parseActor a

Nfo.parseAudio : Soup ->{Throw XMLError} Audio
Nfo.parseAudio s =
  codec = textOr "" "codec" s
  language = textOr "" "language" s
  channels = natOr 0 (textOr "0" "channels" s)
  Audio.Audio codec language channels

Nfo.parseCollection : Soup -> Optional Text
Nfo.parseCollection s =
  use Soup findFirst
  modern = Throw.toOptional do
    setElem = findFirst "set" s
    nameElem = findFirst "name" setElem
    allText nameElem
  match modern with
    Some n ->
      trimmed = Text.trim n
      if Universal.eq (Text.size trimmed) 0 then optText "set" s
      else Some trimmed
    Optional.None -> optText "set" s

Nfo.parseFileInfo : Soup ->{Throw XMLError} FileInfo
Nfo.parseFileInfo s =
  streams = parseStreamDetails (Soup.findFirst "streamdetails" s)
  FileInfo streams

Nfo.parseFolderName : Text -> FolderMeta
Nfo.parseFolderName name =
  csum = textAfter "~" name
  brackets = textBetween "[" "]" name
  base = FolderMeta.checksum.set csum emptyFolderMeta
  match brackets with
    Optional.None -> base
    Some content ->
      List.foldLeft
        (acc p -> classifyPiece (Text.trim p) acc)
        base
        (Text.split ?\s content)

Nfo.parseMovie : Soup ->{Throw XMLError} Movie
Nfo.parseMovie s =
  use Optional None
  id = parseMovieId s
  title = parseTitle s
  collection = parseCollection s
  runtime = Optional.map (natOr 0) (optText "runtime" s)
  scoring = parseScoring s
  plot = textOr "" "plot" s
  tagline = textOr "" "tagline" s
  taxonomy = parseTaxonomy s
  fileInfo = match catch do parseFileInfo s with
    Left _  -> FileInfo (StreamDetails (Video.Video "" 0.0 0 0) [] [])
    Right f -> f
  Movie
    id
    title
    collection
    runtime
    scoring
    plot
    tagline
    taxonomy
    fileInfo
    None
    None
    (parseActors s)
    None
    None
    None
    emptyFolderMeta

Nfo.parseMovieId : Soup ->{Throw XMLError} MovieId
Nfo.parseMovieId s =
  use Optional None
  imdb = match uniqueIdOfType "imdb" s with
    Some v -> Some v
    None   -> descendantAttr "imdb" "id" s
  tmdb = match uniqueIdOfType "tmdb" s with
    Some v -> Some v
    None   -> descendantAttr "tmdb" "id" s
  tvdb = match uniqueIdOfType "tvdb" s with
    Some v -> Some v
    None   -> descendantAttr "tvdb" "id" s
  kodi = match optText "id" s with
    Some k -> k
    None   -> Optional.getOrElse "" imdb
  MovieId kodi imdb tmdb tvdb

Nfo.parseRatingAndVotes : Soup -> (Float, Nat)
Nfo.parseRatingAndVotes s =
  use List find
  use Optional None getOrElse
  use Soup attribute findFirst
  use Text trim
  use Throw toOptional
  use Universal eq
  ratingsElem = toOptional do findFirst "ratings" s
  match ratingsElem with
    None    ->
      r = floatOr 0.0 (textOr "0" "rating" s)
      v = natOr 0 (textOr "0" "votes" s)
      (r, v)
    Some rs ->
      candidates : [(Optional Text, Optional Text, Float, Nat)]
      candidates = silentBranches do
        r = Soup.named "rating" rs
        name = toOptional do attribute "name" r
        dflt = toOptional do attribute "default" r
        valStr = allText (findFirst "value" r)
        votesStr = allText (findFirst "votes" r)
        val = getOrElse 0.0 (Float.fromText (trim valStr))
        vc = getOrElse 0 (Nat.fromText (trim votesStr))
        (name, dflt, val, vc)
      defaultMatch = find (cases (_, d, _, _) -> eq d (Some "true")) candidates
      imdbMatch = find (cases (n, _, _, _) -> eq n (Some "imdb")) candidates
      best = match defaultMatch with
        Some x -> Some x
        None   ->
          match imdbMatch with
            Some x -> Some x
            None   -> List.head candidates
      match best with
        Some (_, _, r, v) -> (r, v)
        None              -> (0.0, 0)

Nfo.parseScoring : Soup ->{Throw XMLError} Scoring
Nfo.parseScoring s =
  year = Optional.map (natOr 0) (optText "year" s)
  (rating, votes) = parseRatingAndVotes s
  mpaa = textOr "" "mpaa" s
  Scoring year rating votes mpaa

Nfo.parseStreamDetails : Soup ->{Throw XMLError} StreamDetails
Nfo.parseStreamDetails s =
  use Soup named
  video = parseVideo (Soup.findFirst "video" s)
  audios = silentBranches do
    a = named "audio" s
    parseAudio a
  subs = silentBranches do
    sb = named "subtitle" s
    parseSubtitle sb
  StreamDetails video audios subs

Nfo.parseSubtitle : Soup ->{Throw XMLError} Subtitle
Nfo.parseSubtitle s =
  language = textOr "" "language" s
  Subtitle language

Nfo.parseTaxonomy : Soup -> Taxonomy
Nfo.parseTaxonomy s =
  use Nfo texts
  Taxonomy
    (texts "genre" s)
    (texts "tag" s)
    (texts "country" s)
    (texts "studio" s)
    (texts "director" s)
    (texts "credits" s)

Nfo.parseTitle : Soup ->{Throw XMLError} Title
Nfo.parseTitle s =
  display = textOr "" "title" s
  original = textOr "" "originaltitle" s
  sort = textOr "" "sorttitle" s
  Title display original sort

Nfo.parseVideo : Soup ->{Throw XMLError} Video
Nfo.parseVideo s =
  codec = textOr "" "codec" s
  aspect = floatOr 0.0 (textOr "0" "aspect" s)
  width = natOr 0 (textOr "0" "width" s)
  height = natOr 0 (textOr "0" "height" s)
  Video.Video codec aspect width height

Nfo.processFolder : FilePath ->{IO, Exception} Either FilePath Movie
Nfo.processFolder folder =
  files = directoryContents.texts folder
  match findFirstNfo files with
    Optional.None -> Left folder
    Some nfoName ->
      nfoFp = pathJoin folder nfoName
      xml = readFileUtf8 nfoFp
      match Nfo.parse xml with
        Left err ->
          _ =
            printLine
              (Text.join "" ["  NFO PARSE FAILED (", nfoName, "): ", err])
          Left folder
        Right m ->
          videoPath =
            Optional.map
              (vf -> filePathText (pathJoin folder vf)) (findFirstVideo files)
          folderName = filePathBasename folder
          folderMeta = parseFolderName folderName
          Right
            (m
              |> videoFilePath.set videoPath
              |> Movie.checksum.set (FolderMeta.checksum folderMeta)
              |> folderPath.set (Some (filePathText folder))
              |> nfoPath.set (Some (filePathText nfoFp))
              |> folderMeta.set folderMeta)

Nfo.sortTitle : Text -> Text -> Text
Nfo.sortTitle title releaseDate =
  use Nat >
  use Text ++ drop
  lower = Text.toLowercase title
  stripped =
    if startsWith "the " lower then drop 4 title
    else
      if startsWith "an " lower then drop 3 title
      else if startsWith "a " lower then drop 2 title else title
  if Text.size releaseDate > 0 then stripped ++ " :: " ++ releaseDate
  else stripped

test> Nfo.sortTitle.test =
  use Universal eq
  List.flatMap
    check
    [ eq (sortTitle "A Lobster Tale" "2006-01-01") "Lobster Tale :: 2006-01-01"
    , eq (sortTitle "The Matrix" "1999-03-31") "Matrix :: 1999-03-31"
    , eq
        (sortTitle "An American Tail" "1986-11-21")
        "American Tail :: 1986-11-21"
    , eq (sortTitle "Inception" "2010-07-15") "Inception :: 2010-07-15"
    , eq (sortTitle "Inception" "") "Inception"
    ]

Nfo.studioLine : Text -> Text
Nfo.studioLine s =
  use Text ++
  "  <studio>" ++ escapeXml s ++ "</studio>"

Nfo.subtitleBlock : SubtitleInfo -> [Text]
Nfo.subtitleBlock s =
  use Text ++
  esc = escapeXml
  [ "      <subtitle>"
  , "        <language>" ++ esc (SubtitleInfo.language s) ++ "</language>"
  , "      </subtitle>"
  ]

Nfo.tagLine : Text -> Text
Nfo.tagLine t =
  use Text ++
  "  <tag>" ++ escapeXml t ++ "</tag>"

Nfo.textOr : Text -> Text -> Soup -> Text
Nfo.textOr default tag s = Optional.getOrElse default (optText tag s)

Nfo.texts : Text -> Soup -> [Text]
Nfo.texts tag s = silentBranches do
  g = Soup.named tag s
  allText g

Nfo.tryReadFolder : FilePath ->{IO, Exception} Optional Movie
Nfo.tryReadFolder folder =
  use Optional None
  files = directoryContents.texts folder
  match findFirstNfo files with
    None         -> None
    Some nfoName ->
      nfoPath = pathJoin folder nfoName
      match catch do readFileUtf8 nfoPath with
        Left _    -> None
        Right xml ->
          match Nfo.parse xml with
            Left _  -> None
            Right m -> Some m

Nfo.uniqueIdOfType : Text -> Soup -> Optional Text
Nfo.uniqueIdOfType wantType s =
  use Optional None
  candidates : [(Text, Text)]
  candidates = silentBranches do
    u = Soup.named "uniqueid" s
    typeAttr = Soup.attribute "type" u
    textVal = allText u
    (typeAttr, textVal)
  match List.find (cases (t, _) -> Universal.eq t wantType) candidates with
    Some (_, v) -> Some (Text.trim v)
    None        -> None

Nfo.writerLine : Text -> Text
Nfo.writerLine w =
  use Text ++
  "  <credits>" ++ escapeXml w ++ "</credits>"

parseConfigLine : Text -> Optional FilePath
parseConfigLine l =
  trimmed = Text.trim l
  if Universal.eq (Text.size trimmed) 0 then Optional.None
  else Some (FilePath trimmed)

parseNatBefore : Text -> Text -> Optional Nat
parseNatBefore suffix t =
  use Nat -
  use Text size
  if endsWith suffix t then
    sz = size t - size suffix
    Nat.fromText (Text.take sz t)
  else Optional.None

pathJoin : FilePath -> Text -> FilePath
pathJoin base name =
  use Text ++
  (FilePath t) = base
  FilePath (t ++ "/" ++ name)

primaryAudio : Movie -> Optional Audio
primaryAudio m =
  match StreamDetails.audios (FileInfo.streams (fileInfo m)) with
    a +: _ -> Some a
    []     -> Optional.None

Probe.AudioTrack.fromJson : '{unison_json_1_3_5.Decoder} AudioTrack
Probe.AudioTrack.fromJson =
  do
    use Decoder boolean nat optional! text
    use object at at!
    index = at! "index" nat
    codec = at! "codec" text
    language = optional! (at "language" text)
    title = optional! (at "title" text)
    channels = at! "channels" nat
    channelLayout = at! "channel_layout" text
    isDefault = at! "default" boolean
    isComment = at! "comment" boolean
    isVisualImpaired = at! "visual_impaired" boolean
    AudioTrack
      index
      codec
      language
      title
      channels
      channelLayout
      isDefault
      isComment
      isVisualImpaired

Probe.Format.fromJson : '{unison_json_1_3_5.Decoder} Format
Probe.Format.fromJson = do
  durStr = object.at! "duration" Decoder.text
  duration = parseFloat durStr
  sizeBytes = optNatStringAt "size"
  bitRate = optNatStringAt "bit_rate"
  Format duration sizeBytes bitRate

Probe.optNatStringAt : Text ->{unison_json_1_3_5.Decoder} Optional Nat
Probe.optNatStringAt key =
  match Decoder.optional! (object.at key Decoder.text) with
    Optional.None -> Optional.None
    Some s        -> Nat.fromText (Text.trim s)

Probe.parseFloat : Text -> Float
Probe.parseFloat t = Optional.getOrElse 0.0 (Float.fromText (Text.trim t))

Progress.report :
  Text -> Nat -> Nat -> Nat -> mutable.Ref g (Nat, Nat) ->{g, IO, Exception} ()
Progress.report label totalItems totalBytes startEpoch counter =
  use Nat - / < == toText
  use Text ++
  (doneI, doneB) = mutable.Ref.read counter
  now = epochSeconds()
  elapsed = if now < startEpoch then 0 else now - startEpoch
  remB = if doneB < totalBytes then totalBytes - doneB else 0
  etaTxt =
    if doneB == 0 then "ETA ?"
    else
      if elapsed == 0 then "ETA ?"
      else
        rate = doneB / elapsed
        if rate == 0 then "ETA ?"
        else "ETA ~" ++ toText (remB / rate / 60) ++ "min"
  printLine
    ("[progress] "
      ++ toText doneI
      ++ "/"
      ++ toText totalItems
      ++ " "
      ++ label
      ++ ", "
      ++ gigabytes doneB
      ++ " / "
      ++ gigabytes totalBytes
      ++ ", elapsed "
      ++ toText (elapsed / 60)
      ++ "min, "
      ++ etaTxt)

README : Doc
README =
  {{
  # uniDork
  
    PostgreSQL-backed movie __and TV__ library organization in Unison.
    
    [AGPLv3](https://www.gnu.org/licenses/agpl-3.0.html)
    
    A FileBot replacement for Kodi users, typed end to end, reproducibly built
    with Nix. Two parallel pipelines — one for movies, one for episodic TV —
    sharing the same identity model, the same `files` table, and the same
    three-directory discipline.
    
    ## Why Unison
    
       This project is an experiment in content addressing all the way down.
       Unison code is itself content-addressable: every function is identified
       by the hash of its abstract syntax tree, not by a name in a file.
       uniDork extends that idea into the data layer. File identity is a CRC32
       of the video bytes; the CRC32 is embedded in folder and file names. The
       same title ripped twice produces two different rows. A renamed or
       relocated folder still resolves to the same row. The on-disk layout, the
       database, and the language all agree about what identity means: bytes,
       not labels.
       
       A Haskell port would be trivial. I continue to choose not to.
    
    ## The pipeline: three directories, one direction
    
       Media flows through three real directories per kind, tracked by two
       columns on every file row: `stage` (`staging` -> `buffer` -> `library`)
       and `media_kind` (`movie` | `episode`).
       
       ``` text
       intake  --probe-->  files(staging)  --resolve-->  associations
          |                                                   |
          +-------------------- rename --apply ---------------+
                                     |
                                     v
       buffer  --import-->  files(buffer)   [awaiting your approval]
          |
          +---------------------- move -----------------------+
                                                              |
                                                              v
       library --import-->  files(library) + catalog rows
       ```
       
       Movies use `intake` / `buffer` / `library`. TV uses `tvIntake` /
       `tvBuffer` / `tvLibrary`. Same shape, different roots, different
       `media_kind`. There is no separate "destination" field: `move` writes to
       the library root, `import-library` reads from it.
       
       * **intake** — where fresh downloads land. Read-only to uniDork.
       * **buffer** — the holding pen between rename and promotion. `rename`
         writes renamed folders here; `move` reads here and
         __deletes from here__ on a successful promotion. Review here before
         promoting.
       * **library** — your actual library. `move` writes here;
         `import-library` reads here to catalogue.
       
       All roots are configured in `nix/config.nix` under `paths`.
       
       ### The `stage` and `media_kind` columns
       
           Every row in `files` carries a `stage` and a `media_kind`:
           
           * `staging` — probed in intake, resolvable.
           * `buffer` — renamed into the buffer. **Excluded from** `resolve`;
             its identity comes from the NFO that `rename` wrote.
           * `library` — promoted (or catalogued directly) into the library.
           
           `media_kind` partitions the resolvers: `resolve` matches files with
           `media_kind = 'movie'` and `stage <> 'buffer'`; `tv-resolve` matches
           `media_kind = 'episode'` and `stage = 'staging'`.
    
    ## Commands
    
       ``` sh
       nix develop                       # enter devshell
       unidork help                      # full command list
       
       # movies — read-only / safe
       unidork status                    # rowcounts across all tables
       unidork identify                  # read-only TMDB match report
       unidork probe                     # probe intake -> files (staging)
       unidork resolve                   # associate staging movies -> tmdb
       unidork import-library            # catalogue the library (library_movies)
       unidork reconcile                 # probe the buffer (record/repair)
       unidork import-all                # reconcile + import-library
       
       # movies — destructive
       unidork rename --apply            # move intake files INTO the buffer (renamed)
       unidork rename --dry-run          # preview the rename plan
       unidork process [--dry-run]       # probe + resolve + rename
       unidork move "<folder>"           # promote ONE buffer folder into the library
       unidork move                      # promote ALL buffer folders
       
       # tv — mirrors the movie verbs
       unidork tv-init                   # create tv schema tables
       unidork tv-probe                  # probe tv intake -> files (episode/staging)
       unidork tv-identify               # read-only episode resolver report
       unidork tv-resolve                # associate staging episodes -> shows/episodes
       unidork tv-rename --apply|--dry-run
       unidork tv-process [--dry-run]    # tv-probe + tv-resolve + tv-rename
       unidork tv-move ["<show>"] [--dry-run]
       
       # combined
       unidork process-all               # movie process THEN tv process (DESTRUCTIVE)
       unidork run                       # start + import-library + process + tv-process
       
       # lifecycle / utility
       unidork start | stop              # postgres
       unidork psql                      # interactive psql
       unidork clean-stage               # truncate probe_cache (forces re-probe)
       unidork logs                      # list log files
       ```
       
       Every destructive verb accepts `--dry-run`: no file is created, moved,
       or deleted. DB metadata (probe rows, associations, TMDB caches) may
       still be written.
       
       ### `move` — what it does, per movie buffer folder
       
           1. Parse the folder's NFO. No parseable NFO -> abort, leave in
              buffer.
           2. Read the TMDB id from the NFO. No id -> abort.
           3. Find the video; look up its `files` row by buffer path. Verify
              on-disk size matches the stored size; on match, the stored CRC32
              is trusted (no rehash). On miss or mismatch, fall back to a
              name-based path update.
           4. Enforce the destination is under the configured `library` root.
           5. Same filesystem -> atomic rename. Cross filesystem -> rsync to a
              `.unidork-partial` staging dir under the library root, then
              commit. This is the point of no return.
           6. On success: update the `files` row (new path, `library` stage) by
              identity where verified, by name otherwise.
           
           **Safety:** `move` only ever writes to `paths.library` and only ever
           deletes from `paths.buffer`. The blast radius of one movie `move` is
           exactly one folder added to the library, one removed from the
           buffer. It cannot overwrite an existing library folder.
       
       ### `tv-move` — the same, but it merges
       
           `tv-move` promotes a whole show folder. If the destination show
           folder does __not__ exist, it behaves like movie `move` (atomic
           rename or rsync-to-partial-then-commit). If the destination __does__
           exist, it **merges** into it: `mergeTree` on the same filesystem, or
           `rsync` into the existing tree cross-filesystem. Existing video
           files at the destination are skipped, not overwritten.
           
           This is a deliberately wider blast radius than movie `move`: a
           `tv-move` can touch an existing show folder. It still never
           overwrites an existing episode file, and still only writes under
           `paths.tvLibrary`. Review before promoting.
    
    ## Configuration
    
       `nix/config.nix`, under `paths`:
       
       ``` nix
       paths = {
         intake  = "/.../renameQue/Movies";    # fresh movie downloads (read-only)
         buffer  = "/.../AMC/TEST";             # movie rename writes; move reads + deletes
         library = "/.../AMC/Movies";           # movie move writes; import-library reads
       
         tvIntake  = "/.../renameQue/Episodic"; # fresh tv downloads (read-only)
         tvBuffer  = "/.../AMC/TEST_TV";         # tv-rename writes; tv-move reads + deletes
         tvLibrary = "/.../AMC/Episodic";        # tv-move writes
       };
       ```
       
       **Going to production:** change `paths.library` / `paths.tvLibrary` to
       your real library paths. Before the first production `move`, verify the
       destination with `echo "$UNIDORK_PATH_LIBRARY"` (and
       `$UNIDORK_PATH_TV_LIBRARY`) inside the devshell. Those env vars, set
       from `config.nix`, are the __only__ thing controlling where `move`
       writes.
       
       Format strings live under `rename.movieFormat` and `rename.tvFormat`.
       The TV format must contain exactly two `/` separators (show / season /
       file). The TMDB v4 bearer token lives at `~/.config/uniDork/tmdb-token`
       (mode 600); the subdl token at `~/.config/uniDork/sub-token`. Caches
       live under `~/.cache/uniDork/`. PostgreSQL data lives under
       `~/.local/share/uniDork/postgres/`.
    
    ## What works
    
       * **Stage probing.** `probe` / `tv-probe` walk intake, CRC32 + ffprobe,
         write `files` rows keyed on `(crc32, size_bytes)`. TV probing skips
         extras/sample dirs and recurses up to a bounded depth.
       * **TMDB identification.** `resolve` matches movies; `tv-resolve`
         matches episodes by parsed `SxxEyy` (and folder-derived season +
         episode fallbacks), resolving the show by NFO id, `{tmdb-...}` /
         `{imdb-...}` folder tags, IMDB `find`, or title/year search. Search,
         details, and season payloads are cached.
       * **Rename pipelines.** FileBot-style format DSL for both. `rename`
         writes renamed folders from intake into the buffer.
       * **Full NFO emission.** Movies emit a complete Kodi `movie.nfo` via
         `Nfo.generate` (uniqueids, ratings, cast, fileinfo/streamdetails). TV
         emits a `tvshow.nfo` per show and an `episodedetails` NFO per episode,
         with multi-episode (`SxxEyyEzz`) support.
       * **Sidecar subtitles (movies).** During movie rename, subtitles are
         fetched from subdl by IMDB/TMDB id and saved as language-tagged
         sidecar files.
       * **Promotion.** `move` / `tv-move` promote reviewed buffer folders into
         the library with identity verification, including merge-into-existing
         for TV shows.
       * **Library import.** `import-library` catalogues the movie library into
         `library_movies`, keyed on `folder_checksum`, self-probing and
         CRC-verifying.
       * **Audio language analysis.** `Relang.*` decides default-track flips
         (computed, not yet applied).
    
    ## What's next
    
       * **Apply the Relang decision.** `Relang.decide` computes the correct
         default audio track but nothing mutes/remuxes to apply it.
       * **Subtitle muxing.** Movie subs are fetched as sidecars; muxing into
         the MKV (and any TV subtitle fetch at all) is unimplemented.
       * **Duplicate management.** Exact byte-duplicates are removed at rename
         by CRC tag + size match, but multiple distinct rips per `imdb_id` /
         `tmdb_id` are not ranked by quality or surfaced for a decision.
       * **A re-match gate at promotion** (optional). `move` trusts the NFO id
         and does not re-match; a verification check could be added.
       
       None of this will involve Haskell, no matter how convenient that would
       be.
    
    ## Stack
    
       Unison (''@unison/base'', `@unison/json`, `@unison/xml`, `@unison/http`,
       `@runarorama/postgres`), PostgreSQL, Nix flakes, ffmpeg, rhash (CRC32),
       rsync (promotion), jq. No Python. No Docker. And though I adore it, no
       Haskell here.
    
    ## Build
    
       ``` sh
       nix build
       ```
       
       `./result/bin/unidork-import` runs the compiled pipeline without ucm.
       
       ### Working on the code
       
           The compiled binary (''bin/unidork-import.uc'') is __not__ the live
           UCM namespace. After editing definitions, test via `run <thunk>`
           against the namespace, then `compile cli ./bin/unidork-import` and
           `direnv reload` to update the binary. Editing the namespace and
           testing via `unidork` silently tests stale code.
    
    ## License
    
       [AGPLv3](https://www.gnu.org/licenses/agpl-3.0.html).
  }}

Relang.bestOf : [AudioTrack] -> Optional AudioTrack
Relang.bestOf tracks =
  use Optional None
  step acc cur = match acc with
    None      -> Some cur
    Some best -> if betterThan cur best then Some cur else Some best
  List.foldLeft step None tracks

Relang.betterThan : AudioTrack -> AudioTrack -> Boolean
Relang.betterThan a b =
  use AudioTrack channels codec index
  use Nat < max
  use Universal eq
  ca = channels a
  cb = channels b
  if eq ca cb then
    ra = codecRank (codec a)
    rb = codecRank (codec b)
    if eq ra rb then index a < index b
    else
      if eq ra (max ra rb) && (if eq ra rb then false else true) then true
      else false
  else if eq ca (max ca cb) then true else false

Relang.codecRank : Text -> Nat
Relang.codecRank c =
  lower = Text.toLowercase c
  isIn xs = List.any (x -> Universal.eq x lower) xs
  if isIn losslessCodecs then 2 else if isIn lossyCodecs then 1 else 0

Relang.containsAnySubstring : [Text] -> Text -> Boolean
Relang.containsAnySubstring needles haystack =
  List.any
    (n -> (match Text.indexOf n haystack with
      Some _        -> true
      Optional.None -> false)) needles

Relang.currentDefault : [AudioTrack] -> Optional Nat
Relang.currentDefault tracks = match List.find isDefault tracks with
  Some t        -> Some (AudioTrack.index t)
  Optional.None -> Optional.None

Relang.decide : Text -> [AudioTrack] -> Decision
Relang.decide tmdbOrigLang tracks =
  match toIso6392 tmdbOrigLang with
    Optional.None -> UnsupportedLanguage tmdbOrigLang
    Some code ->
      match selectTrack code tracks with
        Optional.None -> OriginalNotPresent code
        Some tr ->
          chosenIdx = AudioTrack.index tr
          match currentDefault tracks with
            Optional.None -> NoCurrentDefault chosenIdx
            Some curIdx ->
              if Universal.eq curIdx chosenIdx then AlreadyCorrect curIdx
              else SwitchTo curIdx chosenIdx

Relang.Decision.toJson : Decision -> Json
Relang.Decision.toJson = cases
  AlreadyCorrect i ->
    Json.object
      [("kind", Json.text "already_correct"), ("default_index", Json.nat i)]
  SwitchTo o n ->
    Json.object
      [ ("kind", Json.text "switch")
      , ("old_default_index", Json.nat o)
      , ("new_default_index", Json.nat n)
      ]
  OriginalNotPresent code ->
    Json.object
      [ ("kind", Json.text "original_not_present")
      , ("expected_language", Json.text code)
      ]
  UnsupportedLanguage code ->
    Json.object
      [ ("kind", Json.text "unsupported_language")
      , ("tmdb_code", Json.text code)
      ]
  NoCurrentDefault i ->
    Json.object
      [("kind", Json.text "no_current_default"), ("chosen_index", Json.nat i)]

Relang.isCommentaryOrDescriptive : AudioTrack -> Boolean
Relang.isCommentaryOrDescriptive tr =
  if isComment tr then true
  else
    if isVisualImpaired tr then true
    else
      match AudioTrack.title tr with
        Optional.None -> false
        Some tt       -> titleSuggestsCommentary tt

Relang.losslessCodecs : [Text]
Relang.losslessCodecs =
  ["truehd", "dts-hd", "flac", "pcm_s24le", "pcm_s16le", "mlp"]

Relang.lossyCodecs : [Text]
Relang.lossyCodecs = ["dts", "eac3", "ac3", "aac", "opus", "vorbis", "mp3"]

Relang.selectTrack : Text -> [AudioTrack] -> Optional AudioTrack
Relang.selectTrack origLang3 tracks =
  use List filter
  use Universal eq
  strict = filter (t -> eq (AudioTrack.language t) (Some origLang3)) tracks
  candidates =
    if eq (List.size strict) 0 then filter (titleMatches origLang3) tracks
    else strict
  surviving =
    filter
      (t -> (if isCommentaryOrDescriptive t then false else true)) candidates
  bestOf surviving

Relang.splitMany : [Char] -> Text -> [Text]
Relang.splitMany seps t =
  step acc c = List.flatMap (p -> Text.split c p) acc
  result = List.foldLeft step [t] seps
  List.filter (p -> (if Universal.eq p "" then false else true)) result

Relang.titleAliases : Text -> [Text]
Relang.titleAliases = cases
  "eng" -> ["english", "eng", "en"]
  "ita" -> ["italian", "italiano", "ita", "it"]
  "jpn" -> ["japanese", "jpn", "jp"]
  "kor" -> ["korean", "kor", "kr"]
  "fra" -> ["french", "francais", "français", "fra", "fre", "fr", "vf", "vff"]
  "deu" -> ["german", "deutsch", "ger", "deu", "de"]
  "spa" -> ["spanish", "espanol", "español", "spa", "esp", "es"]
  "por" -> ["portuguese", "portugues", "português", "por", "pt"]
  "rus" -> ["russian", "rus", "ru"]
  "zho" -> ["chinese", "mandarin", "cantonese", "zho", "chi", "zh"]
  "swe" -> ["swedish", "svenska", "swe", "sv"]
  "dan" -> ["danish", "dansk", "dan", "da"]
  "nor" -> ["norwegian", "norsk", "nor", "no"]
  "nld" -> ["dutch", "nederlands", "nld", "dut", "nl"]
  "fin" -> ["finnish", "suomi", "fin", "fi"]
  "pol" -> ["polish", "polski", "pol", "pl"]
  _     -> []

Relang.titleMatches : Text -> AudioTrack -> Boolean
Relang.titleMatches code tr = match AudioTrack.title tr with
  Optional.None -> false
  Some tt       ->
    use List any
    aliases = titleAliases code
    lower = Text.toLowercase tt
    words = splitMany titleSeparators lower
    any (w -> any (a -> Universal.eq w a) aliases) words

Relang.titleSeparators : [Char]
Relang.titleSeparators = [?\s, ?-, ?_, ?., ?,, ?(, ?), ?[, ?], ?/]

Relang.titleSuggestsCommentary : Text -> Boolean
Relang.titleSuggestsCommentary tt =
  lower = Text.toLowercase tt
  markers =
    [ "comment"
    , "descriptive"
    , "director"
    , "vfx"
    , "isolated"
    , "audio description"
    , "narration"
    , "for the visually"
    ]
  containsAnySubstring markers lower

Relang.toIso6392 : Text -> Optional Text
Relang.toIso6392 = cases
  "en" -> Some "eng"
  "ja" -> Some "jpn"
  "ko" -> Some "kor"
  "zh" -> Some "zho"
  "fr" -> Some "fra"
  "de" -> Some "deu"
  "it" -> Some "ita"
  "es" -> Some "spa"
  "pt" -> Some "por"
  "ru" -> Some "rus"
  "sv" -> Some "swe"
  "da" -> Some "dan"
  "no" -> Some "nor"
  "nl" -> Some "nld"
  "fi" -> Some "fin"
  "pl" -> Some "pol"
  "tr" -> Some "tur"
  "hi" -> Some "hin"
  "ar" -> Some "ara"
  "he" -> Some "heb"
  "th" -> Some "tha"
  "vi" -> Some "vie"
  "id" -> Some "ind"
  "hu" -> Some "hun"
  "cs" -> Some "ces"
  "ro" -> Some "ron"
  "el" -> Some "ell"
  "uk" -> Some "ukr"
  _    -> Optional.None

ReleaseNotes : Doc
ReleaseNotes =
  {{ replace @chrisspenner's auth library with the @unison rerelease. }}

Rename.acTag : Text -> Text
Rename.acTag raw =
  use Universal eq
  upper = Text.toUppercase raw
  if eq upper "AC3" then "AC3"
  else
    if eq upper "EAC3" then "EAC3"
    else
      if eq upper "AAC" then "AAC"
      else
        if eq upper "DTS" then "DTS"
        else
          if eq upper "TRUEHD" then "TrueHD"
          else
            if eq upper "FLAC" then "FLAC"
            else
              if eq upper "OPUS" then "Opus"
              else if eq upper "MP3" then "MP3" else upper

Rename.anySizeMatch : FilePath -> Nat -> [Text] ->{IO} Boolean
Rename.anySizeMatch targetFolder expectedSize entries =
  sizeMatches n = match fileStat (filePathText (pathJoin targetFolder n)) with
    Some (_, sz)  -> Universal.eq sz expectedSize
    Optional.None -> false
  List.any sizeMatches entries

Rename.basenameNoExt : Text -> Text
Rename.basenameNoExt filename =
  use List reverse
  parts = Text.split ?. filename
  match reverse parts with
    _ +: []   -> filename
    _ +: rest -> Text.join "." (reverse rest)
    []        -> filename

Rename.channelsTag : Nat -> Text
Rename.channelsTag ch =
  use Universal eq
  if eq ch 1 then "1.0"
  else
    if eq ch 2 then "2.0"
    else if eq ch 6 then "5.1" else if eq ch 8 then "7.1" else Nat.toText ch

test> Rename.channelsTag.test =
  use Universal eq
  List.flatMap
    check
    [ eq (channelsTag 2) "2.0"
    , eq (channelsTag 6) "5.1"
    , eq (channelsTag 8) "7.1"
    , eq (channelsTag 3) "3"
    ]

Rename.collapseSpaces : Text -> Text
Rename.collapseSpaces t =
  use Nat >
  parts = Text.split ?\s t
  nonEmpty = List.filter (p -> Text.size p > 0) parts
  Text.join " " nonEmpty

Rename.crcTaggedEntries : FilePath -> Text ->{IO, Exception} [Text]
Rename.crcTaggedEntries targetFolder crc =
  use Text ++ toUppercase
  if isDirectory targetFolder then
    entries = directoryContents.texts targetFolder
    needle = "~" ++ toUppercase crc
    List.filter
      (n -> (match Text.indexOf needle (toUppercase n) with
        Some _        -> true
        Optional.None -> false)) entries
  else []

Rename.deleteProbeCacheSql : Command a (Text ->{g, g1} a)
Rename.deleteProbeCacheSql =
  sql "DELETE FROM probe_cache WHERE original_path = "
    %% StatementBuilder.var Codec.text
    |> buildCommand

Rename.durationSeconds : Float -> Nat
Rename.durationSeconds d =
  use Float <
  if d < 0.0 then 0
  else
    asText = Float.toText d
    intPart = match Text.indexOf "." asText with
      Some i        -> Text.take i asText
      Optional.None -> asText
    Optional.getOrElse 0 (Nat.fromText intPart)

Rename.effectiveBitRate : Optional Nat -> Nat -> Float -> Nat
Rename.effectiveBitRate br sizeBytes durationSec = match br with
  Some b        -> b
  Optional.None ->
    use Nat * /
    secs = durationSeconds durationSec
    if Universal.eq secs 0 then 0 else sizeBytes * 8 / secs

Rename.escapeXml : Text -> Text
Rename.escapeXml t =
  t |> replaceAll "&" "&amp;" |> replaceAll "<" "&lt;" |> replaceAll ">" "&gt;"

Rename.executeOne :
  Boolean
  -> Text
  -> [FormatPart]
  -> [FormatPart]
  -> Optional Text
  -> [Text]
  -> RenameRow
  ->{IO, Exception, RenameCatalog} Rename.Outcome
Rename.executeOne
  dryRun targetRootText folderFmt fileFmt subsToken subLangs row =
  use Failure message
  use ProbeResult sizeBytes
  use Text ++
  use unison_json_1_4_2.Decoder run
  crc = RenameRow.crc32 row
  sourceText = RenameRow.originalPath row
  sourceVideo = FilePath sourceText
  m = toMovieRecord row
  prParsed = catch do run ProbeResult.fromJson (RenameRow.probeJson row)
  match prParsed with
    Left f -> RenameError sourceText (message f)
    Right pr ->
      nfoText = match catch do run Details.fromJson (detailsJson row) with
        Right d -> Nfo.generate (resultFromDetails d) d pr
        Left _  -> minimalNfoM m crc
      videoExt = fileExt sourceText
      base = renderName fileFmt m pr
      targetFolderText = targetRootText ++ "/" ++ renderName folderFmt m pr
      targetFolder = FilePath targetFolderText
      targetVideo = pathJoin targetFolder (base ++ videoExt)
      targetNfo = pathJoin targetFolder (nfoBase base ++ ".nfo")
      targetVideoText = filePathText targetVideo
      tagged = crcTaggedEntries targetFolder crc
      match tagged with
        _ +: _ ->
          if anySizeMatch targetFolder (sizeBytes pr) tagged then
            if dryRun then WouldRemoveDuplicate sourceText targetVideoText
            else
              _ = catch do removeFile sourceVideo
              DuplicateRemoved sourceText targetVideoText
          else Conflict sourceText targetVideoText
        [] ->
          if Boolean.not (pathExists sourceVideo) then NoVideo sourceText
          else
            if pathExists targetVideo then Conflict sourceText targetVideoText
            else
              if dryRun then WouldRename sourceText targetVideoText
              else
                fsOutcome = catch do
                  _ =
                    if isDirectory targetFolder then ()
                    else
                      _ = createDirectory targetFolder
                      ()
                  _ = writeFileUtf8 targetNfo nfoText
                  renameFile sourceVideo targetVideo
                match fsOutcome with
                  Right _ ->
                    _ = 
                      catch do
                        maybeFetchSubsM subsToken subLangs m targetFolder base
                    newName = base ++ videoExt
                    szInt = Nat.toInt (sizeBytes pr)
                    _ =
                      promoteToBuffer
                        targetVideoText newName base targetFolderText crc szInt
                    _ = match fileStat targetVideoText with
                      Some (mt, _)  -> upsertProbeCache targetVideoText mt pr
                      Optional.None -> ()
                    _ = deleteProbeCache sourceText
                    Renamed sourceText targetVideoText
                  Left f -> RenameError sourceText (message f)

Rename.fileExt : Text -> Text
Rename.fileExt path =
  lower = Text.toLowercase path
  exts =
    [ ".mkv"
    , ".mp4"
    , ".m4v"
    , ".avi"
    , ".mov"
    , ".wmv"
    , ".flv"
    , ".mpeg"
    , ".mpg"
    , ".m2ts"
    , ".mts"
    , ".ts"
    , ".webm"
    ]
  match List.find (e -> endsWith e lower) exts with
    Some e        -> e
    Optional.None -> ""

Rename.findPriorTargetForCrcWith :
  PreparedQuery r a b -> Text ->{Postgres} Optional b
Rename.findPriorTargetForCrcWith pq crc = match 
  catch do
    portal = bindQuery pq (pt crc)
    (rows, _) = executeQueryPortal portal 0
    rows
 with
  Left _   -> Optional.None
  Right rs ->
    match rs with
      []       -> Optional.None
      tgt +: _ -> Some tgt

Rename.gigabytes : Nat -> Text
Rename.gigabytes bytes =
  use Nat % * + / >= toText
  use Text ++
  oneGb = 1073741824
  tenths = (bytes * 10 + oneGb / 2) / oneGb
  whole = tenths / 10
  if whole >= 10 then
    rounded = (bytes + oneGb / 2) / oneGb
    toText rounded ++ " GB"
  else
    f = tenths % 10
    toText whole ++ "." ++ toText f ++ " GB"

test> Rename.gigabytes.test =
  use Universal eq
  List.flatMap
    check
    [ eq (gigabytes 0) "0.0 GB"
    , eq (gigabytes 1073741824) "1.0 GB"
    , eq (gigabytes 5368709120) "5.0 GB"
    , eq (gigabytes 8589934592) "8.0 GB"
    , eq (gigabytes 12884901888) "12 GB"
    , eq (gigabytes 25769803776) "24 GB"
    , eq (gigabytes 429496729) "0.4 GB"
    ]

Rename.isLikelyGroupToken : Text -> Boolean
Rename.isLikelyGroupToken t =
  use Nat < >=
  sz = Text.size t
  hasAny needles =
    List.any
      (n -> (match Text.indexOf n t with
        Some _        -> true
        Optional.None -> false)) needles
  if sz < 2 then false
  else
    if sz >= 30 then false
    else
      if startsWith "~" t then false
      else if hasAny [" ", ".", "(", ")", "[", "]"] then false else true

Rename.logSubOutcomes : [SaveOutcome] ->{IO, Exception} ()
Rename.logSubOutcomes outcomes =
  use Text ++
  Db.foreach_
    (cases
      Saved lang p -> printLine ("    SUB " ++ lang ++ " -> " ++ p)
      SaveOutcome.NotFound lang ->
        printLine ("    SUB " ++ lang ++ " not found")
      Errored lang e -> printLine ("    SUB " ++ lang ++ " error: " ++ e))
    outcomes

Rename.looseVideos : FilePath ->{IO, Exception} [FilePath]
Rename.looseVideos dir =
  entries = directoryContents.texts dir
  videoNames = List.filter isVideo entries
  step acc n =
    use List :+
    fp = pathJoin dir n
    if isDirectory fp then acc else acc :+ fp
  List.foldLeft step [] videoNames

Rename.maybeFetchSubsM :
  Optional Text
  -> [Text]
  -> MovieRecord
  -> FilePath
  -> Text
  ->{IO, Exception} ()
Rename.maybeFetchSubsM maybeToken subLangs m targetFolder base =
  match maybeToken with
    Optional.None -> ()
    Some token ->
      if Universal.eq (List.size subLangs) 0 then ()
      else
        outcomes =
          match MovieRecord.imdbId m with
            Some imdb ->
              fetchAndSaveByImdb token imdb targetFolder base subLangs
            Optional.None ->
              fetchAndSaveByTmdb
                token (MovieRecord.tmdbId m) targetFolder base subLangs
        logSubOutcomes outcomes

Rename.mbps : Nat -> Text
Rename.mbps bps =
  use Nat % * + / >= toText
  use Text ++
  oneMbps = 1000000
  tenths = (bps * 10 + oneMbps / 2) / oneMbps
  whole = tenths / 10
  if whole >= 10 then
    rounded = (bps + oneMbps / 2) / oneMbps
    toText rounded ++ " Mbps"
  else
    f = tenths % 10
    toText whole ++ "." ++ toText f ++ " Mbps"

test> Rename.mbps.test =
  use Universal eq
  List.flatMap
    check
    [ eq (mbps 0) "0.0 Mbps"
    , eq (mbps 1500000) "1.5 Mbps"
    , eq (mbps 5800000) "5.8 Mbps"
    , eq (mbps 11000000) "11 Mbps"
    , eq (mbps 31000000) "31 Mbps"
    ]

Rename.minimalNfoM : MovieRecord -> Text -> Text
Rename.minimalNfoM m crc =
  use Nat toText
  use Text ++
  yearText = match MovieRecord.year m with
    Some y        -> toText y
    Optional.None -> ""
  tmdbText = toText (MovieRecord.tmdbId m)
  Text.join
    "\n"
    [ "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\" ?>"
    , "<movie>"
    , "  <title>" ++ escapeXml (MovieRecord.title m) ++ "</title>"
    , "  <year>" ++ yearText ++ "</year>"
    , "  <uniqueid type=\"tmdb\" default=\"true\">"
        ++ tmdbText
        ++ "</uniqueid>"
    , "  <uniqueid type=\"crc32\">" ++ escapeXml crc ++ "</uniqueid>"
    , "  <id>" ++ tmdbText ++ "</id>"
    , "</movie>"
    , ""
    ]

Rename.minutes : Float -> Nat
Rename.minutes d =
  use Nat /
  durationSeconds d / 60

Rename.nfoBase : Text -> Text
Rename.nfoBase _videoBase = "movie"

Rename.parentDir : FilePath -> FilePath
Rename.parentDir fp =
  use List reverse
  parts = Text.split ?/ (filePathText fp)
  match reverse parts with
    _ +: rest -> FilePath (Text.join "/" (reverse rest))
    []        -> fp

Rename.parseFormat : Text -> [FormatPart]
Rename.parseFormat template =
  use List ++
  use Nat >
  use Text size
  segments = Text.split ?{ template
  match segments with
    []            -> []
    [single]      -> if size single > 0 then [Literal single] else []
    first +: rest ->
      head = if size first > 0 then [Literal first] else []
      head ++ List.flatMap parseSegment rest

test> Rename.parseFormat.test =
  use Universal eq
  lit = Literal
  tok = FormatPart.Token
  List.flatMap
    check
    [ eq (parseFormat "") []
    , eq (parseFormat "hello") [lit "hello"]
    , eq (parseFormat "{a}") [tok "a"]
    , eq (parseFormat "x{a}y") [lit "x", tok "a", lit "y"]
    , eq (parseFormat "{a}{b}") [tok "a", tok "b"]
    , eq (parseFormat "{ny} [{vf}]") [tok "ny", lit " [", tok "vf", lit "]"]
    ]

Rename.parseSegment : Text -> [FormatPart]
Rename.parseSegment seg = match Text.indexOf "}" seg with
  Optional.None -> [Literal (Text.join "" ["{", seg])]
  Some i        ->
    use List ++
    use Nat + >
    tokenName = Text.take i seg
    rest = Text.drop (i + 1) seg
    tokenPart = [FormatPart.Token tokenName]
    if Text.size rest > 0 then tokenPart ++ [Literal rest] else tokenPart

Rename.pathExists : FilePath ->{IO, Exception} Boolean
Rename.pathExists fp = match catch do FilePath.exists fp with
  Right b -> b
  Left _  -> false

Rename.promoteToBufferSql :
  Command
    a
    (Text
    ->{g10, g11} Text
    ->{g8, g9} Text
    ->{g6, g7} Text
    ->{g4, g5} Text
    ->{g2, g3} Int
    ->{g, g1} a)
Rename.promoteToBufferSql =
  use Codec text
  use StatementBuilder var
  sql "UPDATE files SET original_path = "
    %% var text
    %% sql ", original_name = "
    %% var text
    %% sql ", proposed_name = "
    %% var text
    %% sql ", proposed_folder = "
    %% var text
    %% sql ", stage = 'buffer' WHERE crc32 = "
    %% var text
    %% sql " AND size_bytes = "
    %% var bigint
    |> buildCommand

Rename.renderName : [FormatPart] -> MovieRecord -> ProbeResult -> Text
Rename.renderName parts m pr =
  render = cases
    Literal t             -> t
    FormatPart.Token name -> resolveTokenM m pr name
  tighten (Text.join "" (List.map render parts))

Rename.resolutionStr : Nat -> Nat -> Text
Rename.resolutionStr w h =
  use Nat toText
  use Text ++
  toText w ++ "x" ++ toText h

Rename.resolveTokenM : MovieRecord -> ProbeResult -> Text -> Text
Rename.resolveTokenM m pr tok =
  use Nat toText
  use Optional None
  use ProbeResult durationSec primaryAudio sizeBytes
  use VideoInfo height width
  vid = ProbeResult.video pr
  match tok with
    "ny" -> titleYearM m
    "n" -> sanitize (MovieRecord.title m)
    "y" ->
      match MovieRecord.year m with
        Some y -> toText y
        None   -> "0000"
    "gigabytes" -> gigabytes (sizeBytes pr)
    "vf" -> vfTag (width vid) (height vid)
    "vc" -> vcTag (VideoInfo.codec vid)
    "bitdepth" -> toText (VideoInfo.bitDepth vid)
    "minutes" -> toText (Rename.minutes (durationSec pr))
    "crc32" -> ProbeResult.crc32 pr
    "resolution" -> resolutionStr (width vid) (height vid)
    "mbps" ->
      mbps
        (effectiveBitRate
          (VideoInfo.bitRate vid) (sizeBytes pr) (durationSec pr))
    "ac" ->
      match primaryAudio pr with
        Some a -> acTag (AudioInfo.codec a)
        None   -> "noaudio"
    "channels" ->
      match primaryAudio pr with
        Some a -> channelsTag (AudioInfo.channels a)
        None   -> "0"
    _ -> ""

Rename.resultFromDetails : Details -> Tmdb.Result
Rename.resultFromDetails d =
  Tmdb.Result.Result
    (Details.tmdbId d)
    (Details.title d)
    (Details.originalTitle d)
    (Details.originalLanguage d)
    (Details.releaseDate d)
    0.0
    (Details.overview d)

Rename.rowToRenameRow :
  (((((((Text, Text), Text), Int), Optional Text), Text), Optional Int), Text)
  -> RenameRow
Rename.rowToRenameRow = cases
  (((((((crc, opath), pjson), tid), imdb), ttl), yr), djson) ->
    tmdbNat = Optional.getOrElse 0 (Nat.fromInt tid)
    RenameRow crc opath pjson tmdbNat imdb ttl (optIntToNat yr) djson

Rename.runNew : Config -> Text -> Text -> Boolean -> '{IO, Exception} ()
Rename.runNew cfg folderFmtText fileFmtText dryRun =
  do
    folderFmt = parseFormat folderFmtText
    fileFmt = parseFormat fileFmtText
    subsToken = match catch do readSubToken cfg with
      Right t -> Some t
      Left _  -> Optional.None
    targetRootText = buffer (paths cfg)
    subLangs = Tuning.subLangs (tuning cfg)
    _ =
      if dryRun then
        printLine
          "[rename] DRY RUN: no files will be created, moved, or deleted"
      else
        if isDirectory (FilePath targetRootText) then ()
        else
          _ = catch do createDirectory (FilePath targetRootText)
          ()
    singleIO (toClientConfig cfg) do
      pqRows = prepareQuery selectRenamableSql
      pcPromote = prepareCommand promoteToBufferSql
      pcCache = prepareCommand upsertProbeCacheSql
      pcDelCache = prepareCommand deleteProbeCacheSql
      pqProposed = prepareQuery selectProposedSql
      rowsResult = catch do
        portal = bindQuery pqRows []
        (rs, _) = executeQueryPortal portal 0
        rs
      rows = match rowsResult with
        Left f   ->
          use Text ++
          _ = printLine ("[rename] QUERY FAILED: " ++ Failure.message f)
          []
        Right rs -> List.map rowToRenameRow rs
      _ =
        printLine
          ("[rename] "
            Text.++ Nat.toText (List.size rows)
            Text.++ " associated file(s)")
      let
        use List ++
        renameGo = cases
          { r } -> r
          { priorTargetForCrc crc -> k } ->
            handle k (findPriorTargetForCrcWith pqProposed crc) with renameGo
          { promoteToBuffer path name base folder crc size -> k } ->
            _ = 
              catch do
                bindAndExecuteCommand
                  pcPromote
                  (pt path
                    ++ pt name
                    ++ pt base
                    ++ pt folder
                    ++ pt crc
                    ++ pobi (Some size))
            handle k() with renameGo
          { upsertProbeCache path mt pr -> k } ->
            _ = upsertProbeCacheWith pcCache path mt pr
            handle k() with renameGo
          { deleteProbeCache path -> k } ->
            _ = catch do bindAndExecuteCommand pcDelCache (pt path)
            handle k() with renameGo
        runOne row =
          handle
            runStep
              dryRun targetRootText folderFmt fileFmt subsToken subLangs row
          with renameGo
        _ = Db.foreach_ runOne rows
        _ = PreparedQuery.close pqRows
        _ = PreparedCommand.close pcPromote
        _ = PreparedCommand.close pcCache
        _ = PreparedCommand.close pcDelCache
        _ = PreparedQuery.close pqProposed
        printLine "[rename] done"

Rename.runStep :
  Boolean
  -> Text
  -> [FormatPart]
  -> [FormatPart]
  -> Optional Text
  -> [Text]
  -> RenameRow
  ->{IO, Exception, RenameCatalog} ()
Rename.runStep dryRun targetRootText folderFmt fileFmt subsToken subLangs row =
  use Text ++
  crc = RenameRow.crc32 row
  sourceText = RenameRow.originalPath row
  _ = printLine ("processing: " ++ sourceText)
  _ =
    match priorTargetForCrc crc with
      Some prior ->
        printLine ("  note: previously renamed this file -> " ++ prior)
      Optional.None -> ()
  outcome =
    executeOne dryRun targetRootText folderFmt fileFmt subsToken subLangs row
  match outcome with
    Renamed _ tgt -> printLine ("  RENAMED -> " ++ tgt)
    WouldRename _ tgt -> printLine ("  DRY-RUN: would rename -> " ++ tgt)
    DuplicateRemoved _ tgt ->
      printLine ("  DUPLICATE -> source removed (already at " ++ tgt ++ ")")
    WouldRemoveDuplicate _ tgt ->
      printLine
        ("  DRY-RUN: would remove source as verified duplicate of " ++ tgt)
    NoVideo src -> printLine ("  SKIP: source file not found at " ++ src)
    NoProbe src -> printLine ("  SKIP: no probe for " ++ src)
    NoMatch src reason ->
      printLine ("  SKIP: no match for " ++ src ++ " (" ++ reason ++ ")")
    Conflict _ t -> printLine ("  SKIP: different file already at " ++ t)
    AlreadyDone src -> printLine ("  SKIP: already done " ++ src)
    RenameError _ msg -> printLine ("  ERROR: " ++ msg)

Rename.sanitize : Text -> Text
Rename.sanitize t =
  use List foldLeft
  use Nat >
  dropChars = ["'", "\"", "`"]
  spaceChars =
    [ ":"
    , ";"
    , ","
    , "."
    , "/"
    , "\\"
    , "?"
    , "*"
    , "<"
    , ">"
    , "|"
    , "!"
    , "@"
    , "#"
    , "$"
    , "%"
    , "^"
    , "&"
    , "+"
    , "="
    , "~"
    , "("
    , ")"
    , "["
    , "]"
    , "{"
    , "}"
    , "—"
    , "–"
    , "\n"
    , "\t"
    , "\r"
    ]
  dropped = foldLeft (acc c -> replaceAll c "" acc) t dropChars
  spaced = foldLeft (acc c -> replaceAll c " " acc) dropped spaceChars
  parts = Text.split ?\s spaced
  nonEmpty = List.filter (p -> Text.size p > 0) parts
  Text.trim (Text.join " " nonEmpty)

Rename.selectProposedSql : postgres.Query b (Text ->{g, g1} b) Text
Rename.selectProposedSql =
  use Codec text
  sql "SELECT proposed_folder FROM files WHERE crc32 = "
    %% StatementBuilder.var text
    %% sql " AND proposed_folder IS NOT NULL"
    |> typedQuery text

Rename.selectRenamableSql :
  postgres.Query
    r
    r
    ( ((((((Text, Text), Text), Int), Optional Text), Text), Optional Int),
      Text)
Rename.selectRenamableSql =
  use Codec optional text
  sql
    "SELECT f.crc32, f.original_path, f.probe_json, m.tmdb_id, m.imdb_id, m.title, m.year, m.details_json FROM files f JOIN associations a ON a.file_id = f.file_id JOIN movies m ON m.tmdb_id = a.tmdb_id WHERE f.stage = 'staging'"
    |> typedQuery
      (text
        ~ text
        ~ text
        ~ integer
        ~ optional text
        ~ text
        ~ optional integer
        ~ text)

Rename.shrink : Text -> Text -> Text -> Text
Rename.shrink needle replacement t =
  t
    |> replaceAll needle replacement
    |> replaceAll needle replacement
    |> replaceAll needle replacement
    |> replaceAll needle replacement
    |> replaceAll needle replacement

Rename.tighten : Text -> Text
Rename.tighten t =
  t
    |> collapseSpaces
    |> shrink "__" "_"
    |> replaceAll "_]" "]"
    |> replaceAll "[_" "["
    |> replaceAll "_ " " "
    |> replaceAll " _" " "
    |> Text.trim

test> Rename.tighten.test =
  use Universal eq
  List.flatMap
    check
    [ eq (tighten "hello  world") "hello world"
    , eq (tighten "  hello   world  ") "hello world"
    , eq (tighten "a__b") "a_b"
    , eq (tighten "a___b") "a_b"
    , eq (tighten "[x_y_]") "[x_y]"
    , eq (tighten "[_x_y]") "[x_y]"
    ]

Rename.titleYearM : MovieRecord -> Text
Rename.titleYearM m =
  use Text ++
  yearText = match MovieRecord.year m with
    Some y        -> Nat.toText y
    Optional.None -> "0000"
  sanitize (MovieRecord.title m) ++ " (" ++ yearText ++ ")"

Rename.toMovieRecord : RenameRow -> MovieRecord
Rename.toMovieRecord row =
  MovieRecord
    (RenameRow.tmdbId row)
    (RenameRow.imdbId row)
    (RenameRow.title row)
    (RenameRow.year row)

Rename.vcTag : Text -> Text
Rename.vcTag raw =
  use Universal eq
  lower = Text.toLowercase raw
  if eq lower "hevc" then "x265"
  else
    if eq lower "h265" then "x265"
    else
      if eq lower "h264" then "x264"
      else
        if eq lower "avc" then "x264"
        else
          if eq lower "av1" then "av1"
          else
            if eq lower "vp9" then "vp9"
            else if eq lower "mpeg4" then "xvid" else lower

test> Rename.vcTag.test =
  use Universal eq
  List.flatMap
    check
    [ eq (vcTag "hevc") "x265"
    , eq (vcTag "HEVC") "x265"
    , eq (vcTag "h264") "x264"
    , eq (vcTag "av1") "av1"
    ]

Rename.vfTag : Nat -> Nat -> Text
Rename.vfTag width height =
  use Nat >=
  if width >= 3000 || height >= 1700 then "2160p"
  else
    if width >= 2300 || height >= 1300 then "1440p"
    else
      if width >= 1800 || height >= 800 then "1080p"
      else
        if width >= 1100 || height >= 700 then "720p"
        else
          if height >= 540 then "576p"
          else if height >= 380 then "480p" else "SD"

test> Rename.vfTag.test =
  use Universal eq
  List.flatMap
    check
    [ eq (vfTag 3840 2160) "2160p"
    , eq (vfTag 3840 2080) "2160p"
    , eq (vfTag 1920 1080) "1080p"
    , eq (vfTag 1920 800) "1080p"
    , eq (vfTag 1920 1040) "1080p"
    , eq (vfTag 1280 720) "720p"
    , eq (vfTag 720 576) "576p"
    , eq (vfTag 720 404) "480p"
    , eq (vfTag 640 360) "SD"
    ]

resetDb : '{IO, Exception} ()
resetDb = do resetSchema fromEnv()

