exercises.ex5_webSockets.webSocketChatHandler :
  Cell (Set unison_cloud_27_2_0.websockets.WebSocket)
  -> Text
  -> unison_cloud_27_2_0.websockets.WebSocket
  ->{Exception, Remote, unison_cloud_27_2_0.websockets.WebSockets} ()
exercises.ex5_webSockets.webSocketChatHandler cell username ws =
  use Cell modify
  use Text ++
  addFinalizer do unsafeRun! do modify cell (s -> (Set.delete ws s, ()))
  modify cell (s -> (Set.insert ws s, ()))
  loop =
    do
      match unison_cloud_27_2_0.websockets.WebSockets.receive ws with
        TextMessage msg ->
          recipients = Cell.read cell
          flipped.deprecated
            (Set.toList recipients)
            (r ->
              unison_cloud_27_2_0.websockets.WebSockets.send
                r (TextMessage ("<" ++ username ++ "> " ++ msg)))
        _ -> ()
  forever loop

exercises.ex5_webSockets.webSocketHandler :
  unison_cloud_27_2_0.websockets.WebSocket
  ->{Exception, Remote, unison_cloud_27_2_0.websockets.WebSockets} ()
exercises.ex5_webSockets.webSocketHandler ws = forever do
  msg = unison_cloud_27_2_0.websockets.WebSockets.receive ws
  unison_cloud_27_2_0.websockets.WebSockets.send ws msg

exercises.ex5_webSockets.webSocketHandler.doc : Doc
exercises.ex5_webSockets.webSocketHandler.doc =
