Resolve.deleteOtherAssociationsSql =
  use StatementBuilder var
  sql "DELETE FROM associations WHERE file_id = "
    %% var bigint
    %% sql " AND tmdb_id <> "
    %% var integer
    |> buildCommand

Resolve.ensureMovie :
  PreparedQuery r1 a1 Text
  -> PreparedCommand r a
  -> Text
  -> Nat
  ->{IO, Postgres} Boolean
Resolve.ensureMovie pqDet pcDet token tmdbId =
  match cachedDetailsWith pqDet pcDet token tmdbId with
    Right _ -> true
    Left _  -> false

Resolve.optIntToNat : Optional Int -> Optional Nat
Resolve.optIntToNat = cases
  Optional.None -> Optional.None
  Some i        -> Nat.fromInt i

Resolve.printOutcome : Resolve.Outcome ->{IO, Exception} ()
Resolve.printOutcome = cases
  ResolvedById fid tmdbId ->
    printLine
      (Text.join
        ""
        [ "  file "
        , Int.toText fid
        , " -> tmdb:"
        , Nat.toText tmdbId
        , " (nfo id)"
        ])
  ResolvedBySearch fid tmdbId s ->
    printLine
      (Text.join
        ""
        [ "  file "
        , Int.toText fid
        , " -> tmdb:"
        , Nat.toText tmdbId
        , " ("
        , Nat.toText s
        , "%)"
        ])
  NoHint fid ->
    printLine
      ("  file " Text.++ Int.toText fid Text.++ " -> no title/year hint")
  NoTmdbMatch fid ->
    printLine
      ("  file " Text.++ Int.toText fid Text.++ " -> no confident match")
  SearchError fid err ->
    printLine (Text.join "" ["  file ", Int.toText fid, " -> error: ", err])

Resolve.resolveOne :
  Boolean
  -> Text
  -> Resolve.FileRow
  ->{MetaApi, ResolveCatalog} Resolve.Outcome
Resolve.resolveOne dryRun token row =
  use Optional None
  use Resolve.FileRow originalName
  fileId = Resolve.FileRow.fileId row
  hintId = hintTmdbId row
  match hintId with
    Some tmdbId ->
      detailsResult = movieDetails tmdbId
      match detailsResult with
        Right _ ->
          _ = if dryRun then () else recordMatch fileId tmdbId 100 "nfo_id"
          ResolvedById fileId tmdbId
        Left _  -> SearchError fileId "details fetch failed"
    None ->
      titleHint = Resolve.FileRow.hintTitle row
      yearHint = Resolve.FileRow.hintYear row
      parsed = match (titleHint, yearHint) with
        (Some t, Some y) -> Some (ParsedRelease (originalName row) t y None)
        _                -> parseReleaseName (basenameNoExt (originalName row))
      match parsed with
        None -> NoHint fileId
        Some p ->
          searchResult =
            searchMovies (ParsedRelease.title p) (ParsedRelease.year p)
          match searchResult with
            Left err -> SearchError fileId err
            Right resp ->
              candidates = Tmdb.SearchResponse.results resp
              scored = List.map (r -> (r, scoreCandidate p r)) candidates
              probeMin = Some (Rename.minutes (FileRow.durationSec row))
              pick = pickBestWithRuntime probeMin scored
              match pick with
                None -> NoTmdbMatch fileId
                Some (r, s) ->
                  tmdbId = Result.tmdbId r
                  detailsResult = movieDetails tmdbId
                  match detailsResult with
                    Right _ ->
                      _ =
                        if dryRun then ()
                        else recordMatch fileId tmdbId s "title_year"
                      ResolvedBySearch fileId tmdbId s
                    Left _ -> SearchError fileId "details fetch failed"

test> Resolve.resolveOne.dryRunNoWrite.test =
  use Optional None
  use Universal eq
  scriptedMeta = cases
    { r } -> r
    { movieDetails _ -> k } -> handle k (Right testDetails) with scriptedMeta
    { searchMovies _ _ -> k } ->
      handle k (Right (Tmdb.SearchResponse.SearchResponse []))
      with scriptedMeta
  recordingCatalog = cases
    { r }                                 -> (r, None)
    { recordMatch fid tid conf src -> k } ->
      (res, _) = handle k() with recordingCatalog
      (res, Some (fid, tid, conf, src))
  row = Resolve.FileRow.FileRow +7 "Movie.2010.mkv" 0.0 None None (Some 122)
  (outcome, written) =
    handle handle Resolve.resolveOne true "tok" row with recordingCatalog
    with scriptedMeta
  List.flatMap check [eq outcome (ResolvedById +7 122), eq written None]

