        (Some (EpisodeRef 1 [1]))
    , eq
        (refFromFolders
          ["S03 - An Empire of Terror"] "Ep 5 - The Victory Over Democracy")
        (Some (EpisodeRef 3 [5]))
    , eq
        (refFromFolders ["Some Show", "Season 1"] "13 - Plain Episode Thirteen")
