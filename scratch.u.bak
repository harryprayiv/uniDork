Tv.Parse.refFromToken : Text -> Optional EpisodeRef
Tv.Parse.refFromToken tok =
  use Boolean not
  use Nat <= >=
  use Optional None
  use Text split
  use Universal eq
  lower = Text.toLowercase tok
  notBlank s = not (eq (Text.size s) 0)
  seasonValid s = s <= 99 || s >= 1900 && s <= 2030
  finalize season eps =
    use List any size
    use Nat >
    okShape =
      seasonValid season && size eps > 0 && size eps <= 3
        && not (any (n -> n > 999) eps)
    if not okShape then None
    else
      anyNonZero = any (n -> not (eq n 0)) eps
      if eq season 0 then Some (EpisodeRef 0 eps)
      else
        if anyNonZero then Some (EpisodeRef season eps)
        else Some (EpisodeRef 0 eps)
  if startsWith "s" lower then
    use List size
    rest = Text.drop 1 lower
    match split ?e rest with
      seasonSeg +: epSegsRaw ->
        epSegs = List.filter notBlank epSegsRaw
        match natSegment seasonSeg with
          None -> None
          Some season ->
            parsedSegs = List.filterMap epSegment epSegs
            if eq (size parsedSegs) (size epSegs) then
              finalize season (List.flatMap (x -> x) parsedSegs)
            else None
      [] -> None
  else
    match split ?x lower with
      [a, b] ->
        if notBlank a
          && notBlank b then
          match (natSegment a, epSegment b) with
            (Some season, Some eps) ->
              if season <= 99 then finalize season eps else None
            _ -> None
        else None
      _ -> None

