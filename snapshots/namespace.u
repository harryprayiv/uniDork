  use Optional None
  Authority None (HostName "api.themoviedb.org") None

Tmdb.cachedDetailsWith :
  PreparedQuery r1 a1 Text
  -> PreparedCommand r a
  -> Text
  -> Nat
  ->{IO, Postgres} Either Text Details
Tmdb.cachedDetailsWith pq pc token tmdbId =
  parse body =
    match catch do unison_json_1_4_2.Decoder.run Details.fromJson body with
      Right d -> Right d
      Left f  -> Left (Failure.message f)
  match readDetailsBodyWith pq tmdbId with
    Some body     -> parse body
    Optional.None ->
      match fetchDetailsBody token tmdbId with
        Left err   -> Left err
        Right body ->
          _ = writeDetailsBodyWith pc tmdbId body
          parse body

Tmdb.cachedSearchWith :
  PreparedQuery r1 a1 Text
  -> PreparedCommand r a
  -> Text
  -> Text
  -> Nat
  ->{IO, Postgres} Either Text Tmdb.SearchResponse
Tmdb.cachedSearchWith pq pc token title year =
  match readCachedWith pq Tmdb.SearchResponse.fromJson title (Nat.toInt year) with
    Some cached -> cached
    Optional.None ->
      result = Tmdb.search token title year
      _ =
        writeCachedWith
          pc Tmdb.SearchResponse.toJson title (Nat.toInt year) result
      result

