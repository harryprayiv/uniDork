Versions.loadDesired : Config ->{IO, Exception} [(Text, (Text, Boolean))]
Versions.loadDesired cfg =
  use Text ++
  rows = myPg.singleIO (toClientConfig cfg) do
    pq = prepareQuery selectStampRowsSql
    rowsResult = catch do
      portal = bindQuery pq []
      (rs, _) = executeQueryPortal portal 0
      rs
    rs = match rowsResult with
      Left f   ->
        _ = printLine ("[versions-nfo] QUERY FAILED: " ++ Failure.message f)
        []
      Right rs -> rs
    _ = PreparedQuery.close pq
    rs
  stampRows = List.map rowToStampRow rows
  groups = Stamp.groupBy StampRow.tmdbId stampRows
  List.flatMap labelsForPair groups

Versions.normalizedSeconds : MediaFacts -> Float
Versions.normalizedSeconds f =
  use Float * / >
  use MediaFacts durationSec
  fp = MediaFacts.fps f
  if fp > 0.0 then durationSec f * fp / referenceFps else durationSec f

test> Versions.palSameCut.test =
  film = testFacts "AAA" 7200.0 23.976 1920 1080 8 "x264" "M.1999.1080p"
  pal = testFacts "BBB" 6900.0 25.0 1920 1080 8 "x264" "M.1999.PAL"
  check (relativeClose (normalizedSeconds film) (normalizedSeconds pal))

Versions.parseFrameRate : Text -> Float
Versions.parseFrameRate t =
  use Float / <= fromText
  s = Text.trim t
  match Text.split ?/ s with
    [numT, denT] ->
      match (fromText numT, fromText denT) with
        (Some n, Some d) -> if d <= 0.0 then 0.0 else n / d
        _                -> 0.0
    [single]     -> Optional.getOrElse 0.0 (fromText single)
    _            -> 0.0

test> Versions.parseFrameRate.test =
  use Float < >
  use Universal eq
  pal = parseFrameRate "25/1"
  ntsc = parseFrameRate "24000/1001"
  plain = parseFrameRate "30"
  List.flatMap
    check
    [ eq pal 25.0
    , ntsc > 23.9
        && ntsc < 24.0
    , eq plain 30.0
    , eq (parseFrameRate "0/0") 0.0
    , eq (parseFrameRate "") 0.0
    ]

Versions.pickStandardIndex : Optional Nat -> [Float] -> Optional Nat
Versions.pickStandardIndex canonicalMin runtimes = match canonicalMin with
  Optional.None -> Optional.None
  Some mins     ->
    use Float - < >
    use Nat *
    use Optional None
    target = Float.fromNat (mins * 60)
    step acc = cases
      (i, rt) ->
        d = if rt > target then rt - target else target - rt
        match acc with
          None          -> Some (i, d)
          Some (bi, bd) -> if d < bd then Some (i, d) else Some (bi, bd)
    match List.foldLeft step None (Versions.withIndex runtimes) with
      Some (i, _) -> Some i
      None        -> None

test> Versions.qualityOrdering.test =
  use Nat >
  fourK = testFacts "A" 7200.0 23.976 3840 2160 10 "x265" "4k"
  hd10 = testFacts "B" 7200.0 23.976 1920 1080 10 "x265" "hd10"
  hd8 = testFacts "C" 7200.0 23.976 1920 1080 8 "x265" "hd8"
  List.flatMap
    check
    [ qualityScore fourK > qualityScore hd10
    , qualityScore hd10 > qualityScore hd8
    ]

Versions.qualityScore : MediaFacts -> Nat
Versions.qualityScore f =
  use Nat * + /
  res = resolutionRank (MediaFacts.width f) (MediaFacts.height f)
  depth = MediaFacts.bitDepth f
  brMbps = match videoBitRate f with
    Some b        -> b / 1000000
    Optional.None -> 0
  vc = videoCodecRank (MediaFacts.videoCodec f)
  ac = audioChannels f
  acr = codecRank (audioCodec f)
  res * 1000000000
    + depth * 10000000
    + brMbps * 10000
    + vc * 1000
    + ac * 10
    + acr

Versions.referenceFps : Float
Versions.referenceFps =
  use Float /
  24000.0 / 1001.0

Versions.relativeClose : Float -> Float -> Boolean
Versions.relativeClose a b =
  use Float - / <= >
  hi = if a > b then a else b
  d = if a > b then a - b else b - a
  if hi <= 0.0 then true else d / hi <= sameCutTolerance

Versions.resolutionRank : Nat -> Nat -> Nat
Versions.resolutionRank w h =
  use Nat >=
  if w >= 3000 || h >= 1700 then 5
  else
    if w >= 2300 || h >= 1300 then 4
    else
      if w >= 1800 || h >= 800 then 3
      else if w >= 1100 || h >= 700 then 2 else if h >= 540 then 1 else 0

Versions.rowToLib : ((((Text, Text), Int), Text), Text) -> LibRow
Versions.rowToLib = cases
  ((((fc, tid), sz), pj), nm) ->
    LibRow fc tid (Optional.getOrElse 0 (Nat.fromInt sz)) pj nm

Versions.rowToStampRow : ((((Text, Text), Text), Text), Int) -> StampRow
Versions.rowToStampRow = cases
  ((((tmdb, ck), edLabel), vLabel), d) ->
    StampRow tmdb ck edLabel vLabel (Universal.eq d +1)

Versions.run : Config ->{IO, Exception} ()
Versions.run cfg =
  use List size
  use Nat toText
  use Text ++
  tmdbs = fetchMultiTmdbs cfg
  total = size tmdbs
  _ =
    printLine
      ("[versions] " ++ toText total ++ " tmdb group(s) with multiple copies")
  _ = clearAll cfg
  chunks = List.chunk sessionGroups tmdbs
  runOne done chunk =
    use Nat +
    _ = runGroupChunk cfg chunk
    d = done + size chunk
    _ =
      printLine
        ("[versions] session done ("
          ++ toText d
          ++ "/"
          ++ toText total
          ++ " group(s), rss "
          ++ toText rssMb()
          ++ " MB)")
    d
  _ = List.foldLeft runOne 0 chunks
  printLine "[versions] done"

Versions.runGroupChunk : Config -> [Text] ->{IO, Exception} ()
Versions.runGroupChunk cfg chunk = myPg.singleIO (toClientConfig cfg) do
  pqGroup = prepareQuery selectLibFilesForTmdbSql
  pqCanon = prepareQuery canonicalMinSql
  pqEd = prepareQuery insertEditionSql
  pcVer = prepareCommand insertVersionSql
  _ = Db.foreach_ (writeGroup pqGroup pqCanon pqEd pcVer) chunk
  _ = PreparedQuery.close pqGroup
  _ = PreparedQuery.close pqCanon
  _ = PreparedQuery.close pqEd
  PreparedCommand.close pcVer

Versions.sameCutTolerance : Float
Versions.sameCutTolerance = 1.5e-2

Versions.selectLibFilesForTmdbSql :
  postgres.Query a (Text ->{g, g1} a) ((((Text, Text), Int), Text), Text)
Versions.selectLibFilesForTmdbSql =
  use Codec text
  sql
    "SELECT lm.folder_checksum, lm.tmdb_id, f.size_bytes, f.probe_json, f.original_name FROM library_movies lm JOIN files f ON f.crc32 = lm.crc32 WHERE lm.tmdb_id = "
    %% StatementBuilder.var text
    %% sql " AND f.probe_json IS NOT NULL"
    |> typedQuery (text ~ text ~ bigint ~ text ~ text)

Versions.selectLibFilesSql :
  postgres.Query r r ((((Text, Text), Int), Text), Text)
Versions.selectLibFilesSql =
  use Codec text
  sql
    "SELECT lm.folder_checksum, lm.tmdb_id, f.size_bytes, f.probe_json, f.original_name FROM library_movies lm JOIN files f ON f.crc32 = lm.crc32 WHERE lm.tmdb_id IS NOT NULL AND f.probe_json IS NOT NULL"
    |> typedQuery (text ~ text ~ bigint ~ text ~ text)

Versions.selectMultiTmdbSql : postgres.Query r r Text
Versions.selectMultiTmdbSql =
  sql
    "SELECT lm.tmdb_id FROM library_movies lm JOIN files f ON f.crc32 = lm.crc32 WHERE lm.tmdb_id IS NOT NULL AND f.probe_json IS NOT NULL GROUP BY lm.tmdb_id HAVING COUNT(*) > 1 ORDER BY lm.tmdb_id"
    |> typedQuery Codec.text

Versions.selectNfoChunkSql : postgres.Query b (Text -> b) (Text, Text)
Versions.selectNfoChunkSql =
  use Codec text
  use Text ++
  sql
    "SELECT lm.folder_checksum, lm.nfo_path FROM library_movies lm WHERE lm.nfo_path IS NOT NULL AND lm.folder_checksum > "
    %% StatementBuilder.var text
    %% sql (" ORDER BY lm.folder_checksum LIMIT " ++ Nat.toText stampChunk)
    |> typedQuery (text ~ text)

Versions.selectStampRowsSql :
  postgres.Query r r ((((Text, Text), Text), Text), Int)
Versions.selectStampRowsSql =
  use Codec text
  sql
    "SELECT lm.tmdb_id, mv.folder_checksum, me.label, mv.version_label, CASE WHEN mv.is_default THEN 1 ELSE 0 END FROM movie_versions mv JOIN movie_editions me ON me.edition_id = mv.edition_id JOIN library_movies lm ON lm.folder_checksum = mv.folder_checksum WHERE lm.nfo_path IS NOT NULL ORDER BY lm.tmdb_id, me.label, mv.score DESC"
    |> typedQuery (text ~ text ~ text ~ text ~ integer)

Versions.sessionGroups : Nat
Versions.sessionGroups = 32

Versions.Stamp.applyStamp : Optional (Text, Boolean) -> Text -> Text
Versions.Stamp.applyStamp stamp nfo =
  use Text join
  lines = Text.split ?\n nfo
  kept = List.filter (l -> Boolean.not (isStampLine l)) lines
  match stamp with
    Optional.None -> join "\n" kept
    Some (label, isDef) ->
      if containsText "</movie>" nfo then
        join "\n" (insertBeforeClose (stampLines label isDef) kept)
      else nfo

test> Versions.Stamp.applyStamp.test =
  use Text join
  use Universal eq
  nfo = join "\n" ["<movie>", "  <title>X</title>", "</movie>", ""]
  stamped = applyStamp (Some ("Director's Cut 2160p", true)) nfo
  expected =
    join
      "\n"
      [ "<movie>"
      , "  <title>X</title>"
      , "  <hasvideoversions>true</hasvideoversions>"
      , "  <videoassettitle>Director's Cut 2160p</videoassettitle>"
      , "  <isdefaultvideoversion>true</isdefaultvideoversion>"
      , "</movie>"
      , ""
      ]
  restamped = applyStamp (Some ("Director's Cut 2160p", true)) stamped
  stripped = applyStamp Optional.None stamped
  List.flatMap
    check [eq stamped expected, eq restamped expected, eq stripped nfo]

Versions.Stamp.countEqText : Text -> [Text] -> Nat
Versions.Stamp.countEqText x xs =
  use Nat +
  step n y = if Universal.eq x y then n + 1 else n
  List.foldLeft step 0 xs

Versions.Stamp.groupBy : (a ->{g} Text) -> [a] ->{g} [(Text, [a])]
Versions.Stamp.groupBy f xs =
  List.foldLeft (acc x -> Stamp.upsert (f x) x acc) [] xs

Versions.Stamp.insertBeforeClose : [Text] -> [Text] -> [Text]
Versions.Stamp.insertBeforeClose newLines lines =
  use List ++ +: reverse
  go acc = cases
    [] -> reverse acc ++ newLines
    l +: rest ->
      if containsText "</movie>" l then reverse acc ++ newLines ++ (l +: rest)
      else go (l +: acc) rest
  go [] lines

Versions.Stamp.isStampLine : Text -> Boolean
Versions.Stamp.isStampLine l =
  needles =
    [ "<hasvideoversions"
    , "<isdefaultvideoversion"
    , "<videoassettitle"
    , "<videoassetid"
    , "<videoassettype"
    ]
  List.any (n -> containsText n l) needles

Versions.Stamp.kodiLabelsForGroup : [StampRow] -> [(Text, (Text, Boolean))]
Versions.Stamp.kodiLabelsForGroup rows =
  use Nat >
  editions = Stamp.groupBy StampRow.editionLabel rows
  multiEdition = List.size editions > 1
  List.flatMap (labelEdition multiEdition) editions

test> Versions.Stamp.kodiLabelsForGroup.test =
  a = StampRow "122" "ck-a" "Theatrical Cut" "1080p x264 8bit ~aaaa1111" false
  b = StampRow "122" "ck-b" "Extended Cut" "2160p x265 10bit ~bbbb2222" true
  c = StampRow "122" "ck-c" "Extended Cut" "1080p x264 8bit ~cccc3333" false
  out = kodiLabelsForGroup [a, b, c]
  List.flatMap
    check
    [ Universal.eq
        out
        [ ("ck-a", ("Theatrical Cut", false))
        , ("ck-b", ("Extended Cut 2160p x265 10bit", true))
        , ("ck-c", ("Extended Cut 1080p x264 8bit", false))
        ]
    ]

Versions.Stamp.labelEdition :
  Boolean -> (Text, [StampRow]) -> [(Text, (Text, Boolean))]
Versions.Stamp.labelEdition multiEdition = cases
  (edLabel, members) ->
    use List map
    quals = map (r -> stripCrcSuffix (StampRow.versionLabel r)) members
    single = Universal.eq (List.size members) 1
    map (labelMember multiEdition edLabel quals single) members

Versions.Stamp.labelMember :
  Boolean -> Text -> [Text] -> Boolean -> StampRow -> (Text, (Text, Boolean))
Versions.Stamp.labelMember multiEdition edLabel quals single r =
  use Nat >
  use StampRow versionLabel
  use Text ++
  qual = stripCrcSuffix (versionLabel r)
  qualDup = countEqText qual quals > 1
  qualPart = if qualDup then versionLabel r else qual
  label =
    if single then edLabel
    else if multiEdition then edLabel ++ " " ++ qualPart else qualPart
  (StampRow.folderChecksum r, (label, StampRow.isDefault r))

Versions.Stamp.labelsForPair : (Text, [StampRow]) -> [(Text, (Text, Boolean))]
Versions.Stamp.labelsForPair = cases (_, rs) -> kodiLabelsForGroup rs

Versions.Stamp.lookupCk :
  Text -> [(Text, (Text, Boolean))] -> Optional (Text, Boolean)
Versions.Stamp.lookupCk ck = cases
  [] -> Optional.None
  (k, v) +: rest ->
    if Universal.eq k ck then Some v else Versions.Stamp.lookupCk ck rest

Versions.Stamp.patchOne :
  Boolean
  -> [(Text, (Text, Boolean))]
  -> Nat
  -> (Text, Text)
  ->{IO, Exception} Nat
Versions.Stamp.patchOne dry desired n = cases
  (ck, nfoPath) ->
    use Text ++
    stamp = lookupCk ck desired
    fp = FilePath nfoPath
    if Boolean.not (pathExists fp) then skipMissing stamp nfoPath n
    else
      origResult = catch do readFileUtf8 fp
      match origResult with
        Left f ->
          _ =
            printLine
              ("  [versions-nfo] read failed, skipped: "
                ++ nfoPath
                ++ " ("
                ++ Failure.message f
                ++ ")")
          n
        Right orig -> patchText dry stamp nfoPath orig n

Versions.Stamp.patchText :
  Boolean
  -> Optional (Text, Boolean)
  -> Text
  -> Text
  -> Nat
  ->{IO, Exception} Nat
Versions.Stamp.patchText dry stamp nfoPath orig n =
  use Nat +
  use Text ++
  missingClose = match stamp with
    Some _        -> Boolean.not (containsText "</movie>" orig)
    Optional.None -> false
  if missingClose then
    _ = printLine ("  [versions-nfo] no </movie> tag, skipped: " ++ nfoPath)
    n
  else
    desiredText = applyStamp stamp orig
    if Universal.eq desiredText orig then n
    else
      if dry then
        _ = printLine ("  would update: " ++ nfoPath)
        n + 1
      else
        wr = catch do writeFileUtf8 (FilePath nfoPath) desiredText
        match wr with
          Left f ->
            _ =
              printLine
                ("  [versions-nfo] WRITE FAILED: "
                  ++ nfoPath
                  ++ " ("
                  ++ Failure.message f
                  ++ ")")
            n
          Right _ ->
            _ = printLine ("  updated: " ++ nfoPath)
            n + 1

Versions.Stamp.skipMissing :
  Optional (Text, Boolean) -> Text -> Nat ->{IO, Exception} Nat
Versions.Stamp.skipMissing stamp nfoPath n = match stamp with
  Some _        ->
    use Text ++
    _ = printLine ("  [versions-nfo] missing nfo, skipped: " ++ nfoPath)
    n
  Optional.None -> n

Versions.Stamp.stampLines : Text -> Boolean -> [Text]
Versions.Stamp.stampLines label isDef =
  use List :+
  use Text ++
  base =
    [ "  <hasvideoversions>true</hasvideoversions>"
    , "  <videoassettitle>" ++ escapeXml label ++ "</videoassettitle>"
    ]
  if isDef then base :+ "  <isdefaultvideoversion>true</isdefaultvideoversion>"
  else base

Versions.Stamp.upsert : Text -> a -> [(Text, [a])] -> [(Text, [a])]
Versions.Stamp.upsert key v = cases
  [] -> [(key, [v])]
  (k, vs) +: rest ->
    if Universal.eq k key then (k, vs List.:+ v) List.+: rest
    else (k, vs) List.+: Versions.Stamp.upsert key v rest

Versions.stampChunk : Nat
Versions.stampChunk = 400

Versions.stampNfos : Config -> Boolean ->{IO, Exception} ()
Versions.stampNfos cfg dry =
  use List size
  use Nat + toText
  use Optional None
  use Text ++
  desired = loadDesired cfg
  _ =
    printLine
      ("[versions-nfo] "
        ++ toText (size desired)
        ++ " folder(s) carry version stamps")
  runChunk lastCk = myPg.singleIO (toClientConfig cfg) do
    pq = prepareQuery selectNfoChunkSql
    rowsResult = catch do
      portal = bindQuery pq (pt lastCk)
      (rs, _) = executeQueryPortal portal 0
      rs
    rows = match rowsResult with
      Left f   ->
        _ = printLine ("[versions-nfo] QUERY FAILED: " ++ Failure.message f)
        []
      Right rs -> rs
    changed = List.foldLeft (patchOne dry desired) 0 rows
    _ = PreparedQuery.close pq
    match lastOf rows with
      None         -> None
      Some (ck, _) -> Some (ck, size rows, changed)
  loop lastCk checked changed =
    match runChunk lastCk with
      None -> (checked, changed)
      Some (ck, n, c) ->
        _ =
          printLine
            ("[versions-nfo] chunk done ("
              ++ toText n
              ++ " row(s), rss "
              ++ toText rssMb()
              ++ " MB)")
        loop ck (checked + n) (changed + c)
  (checked, changed) = loop "" 0 0
  verbed = if dry then "would update" else "updated"
  printLine
    ("[versions-nfo] checked "
      ++ toText checked
      ++ " nfo(s), "
      ++ verbed
      ++ " "
      ++ toText changed)

test> Versions.standardPicksClosest.test =
  check (Universal.eq (pickStandardIndex (Some 120) [7197.0, 7680.0]) (Some 0))

Versions.stripCrcSuffix : Text -> Text
Versions.stripCrcSuffix t = match Text.indexOf " ~" t with
  Some i        -> Text.take i t
  Optional.None -> t

test> Versions.stripCrcSuffix.test =
  use Universal eq
  List.flatMap
    check
    [ eq (stripCrcSuffix "2160p x265 10bit ~a1b2c3") "2160p x265 10bit"
    , eq (stripCrcSuffix "1080p x264 8bit") "1080p x264 8bit"
    ]

Versions.testFacts :
  Text -> Float -> Float -> Nat -> Nat -> Nat -> Text -> Text -> MediaFacts
Versions.testFacts crc dur fps w h depth vcodec name =
  MediaFacts crc crc 0 dur fps w h depth vcodec Optional.None "ac3" 6 name

Versions.toMinutes : Float -> Nat
Versions.toMinutes sec =
  use Float + /
  m = sec / 60.0 + 0.5
  Optional.getOrElse 0 (Float.toNat (Float.floor m))

Versions.upsertGroup :
  Text -> MediaFacts -> [(Text, [MediaFacts])] -> [(Text, [MediaFacts])]
Versions.upsertGroup key mf = cases
  [] -> [(key, [mf])]
  (k, ms) +: rest ->
    if Universal.eq k key then (k, ms List.:+ mf) List.+: rest
    else (k, ms) List.+: Versions.upsertGroup key mf rest

Versions.versionLabel : MediaFacts -> Text
Versions.versionLabel f =
  use Text ++
  vf = vfTag (MediaFacts.width f) (MediaFacts.height f)
  vc = vcTag (MediaFacts.videoCodec f)
  depth = Nat.toText (MediaFacts.bitDepth f) ++ "bit"
  vf ++ " " ++ vc ++ " " ++ depth ++ " ~" ++ MediaFacts.crc32 f

Versions.videoCodecRank : Text -> Nat
Versions.videoCodecRank c =
  lower = Text.toLowercase c
  isIn xs = List.any (x -> Universal.eq x lower) xs
  if isIn ["av1"] then 3
  else
    if isIn ["hevc", "h265", "x265"] then 2
    else if isIn ["avc", "h264", "x264"] then 1 else 0

Versions.writeEdition :
  PreparedQuery rE aE Int
  -> PreparedCommand rV aV
  -> Text
  -> Edition
  ->{Postgres} ()
Versions.writeEdition pqEd pcVer tmdbId ed =
  use Db pi
  use List ++
  use Nat toInt
  editionIdOpt = 
    catch do
      portal =
        bindQuery
          pqEd
          (pt tmdbId
            ++ pt (editionKey ed)
            ++ pt (Edition.label ed)
            ++ pi (toInt (runtimeSec ed))
            ++ [if isStandard ed then Some "t" else Some "f"])
      (rows, _) = executeQueryPortal portal 0
      rows
  match editionIdOpt with
    Left _ -> ()
    Right rs ->
      match rs with
        edId +: _ ->
          writeOne a =
            f = facts a
            _ = 
              catch do
                bindAndExecuteCommand
                  pcVer
                  (pi edId
                    ++ pt (MediaFacts.folderChecksum f)
                    ++ pt (MediaFacts.crc32 f)
                    ++ pi (toInt (score a))
                    ++ pt (Assigned.versionLabel a)
                    ++ [if Assigned.isDefault a then Some "t" else Some "f"])
            ()
          Db.foreach_ writeOne (members ed)
        [] -> ()

Versions.writeGroup :
  PreparedQuery r1 a1 ((((Text, Text), Int), Text), Text)
  -> PreparedQuery r a Int
  -> PreparedQuery rE aE Int
  -> PreparedCommand rV aV
  -> Text
  ->{IO, Exception, Postgres} ()
Versions.writeGroup pqGroup pqCanon pqEd pcVer tmdbId =
  use List map
  use Nat >
  use Text ++
  rowsResult = catch do
    portal = bindQuery pqGroup (pt tmdbId)
    (rs, _) = executeQueryPortal portal 0
    rs
  rows =
    match rowsResult with
      Left f ->
        _ =
          printLine
            ("[versions] group "
              ++ tmdbId
              ++ " QUERY FAILED: "
              ++ Failure.message f)
        []
      Right rs -> map rowToLib rs
  fs = map at2 (List.filterMap factsForRow rows)
  if List.size fs > 1 then
    canon = canonicalMinFor pqCanon tmdbId
    editions = analyze canon fs
    Db.foreach_ (ed -> writeEdition pqEd pcVer tmdbId ed) editions
  else ()

versionsRun : '{IO, Exception} ()
versionsRun = do Versions.run fromEnv()

Video.fromJson : '{unison_json_1_3_5.Decoder} Video
Video.fromJson = do
  use Decoder nat
  use object at!
  codec = at! "codec" Decoder.text
  aspect = at! "aspect" Decoder.float
  width = at! "width" nat
  height = at! "height" nat
  Video.Video codec aspect width height

Video.toJson : Video -> Json
Video.toJson v =
  use Json nat
  Json.object
    [ ("codec", Json.text (Video.codec v))
    , ("aspect", Json.float (aspect v))
    , ("width", nat (Video.width v))
    , ("height", nat (Video.height v))
    ]

videoExtensions : [Text]
videoExtensions =
  [ ".mkv"
  , ".mp4"
  , ".m4v"
  , ".avi"
  , ".mov"
  , ".wmv"
  , ".flv"
  , ".mpeg"
