Tv.Tmdb.findByImdbURI : Text -> URI
Tv.Tmdb.findByImdbURI imdbId =
  use Path /
  use Query &
  path = Path.root / "3" / "find" / imdbId
  q = Query.empty & ("external_source", "imdb_id")
  URI Scheme.https (Some Tmdb.apiAuthority) path (fromQuery q) Fragment.empty

Tv.Tmdb.findShowByImdb : Text -> Text ->{IO} Either Text Nat
Tv.Tmdb.findShowByImdb token imdbId =
  req = authedGet token (findByImdbURI imdbId)
  match 
    catch do
      IO.Threads.run do
        unison_http_16_0_0.client.Http.run do
          resp = request req
          ok = unison_http_15_0_0.HttpResponse.ensureSuccess resp
          body = bodyText ok
          unison_json_1_4_2.Decoder.run findShowResultFromJson body
   with
    Right v -> v
    Left f  -> Left (Failure.message f)

Tv.Tmdb.findShowResultFromJson : '{unison_json_1_3_5.Decoder} Either Text Nat
Tv.Tmdb.findShowResultFromJson =
  do
    use Decoder array nat optional!
    use Optional getOrElse
    use object at at!
    parseShowId = do at! "id" nat
    parseEpShowId = do at! "show_id" nat
    tvShows = getOrElse [] (optional! (at "tv_results" (array parseShowId)))
    match tvShows with
      id +: _ -> Right id
      [] ->
        tvEps =
          getOrElse
            [] (optional! (at "tv_episode_results" (array parseEpShowId)))
        match tvEps with
          showId +: _ -> Right showId
          []          -> Left "no tv_results or tv_episode_results for IMDB ID"

Tv.Tmdb.pickBestShow : [(ShowResult, Nat)] -> Optional (ShowResult, Nat)
Tv.Tmdb.pickBestShow scored = pickBest ShowResult.popularity scored

Tv.Tmdb.readSeasonBodyWith :
  PreparedQuery r a b -> Nat -> Nat ->{Postgres} Optional b
Tv.Tmdb.readSeasonBodyWith pq showId season = match 
  catch do
    use Db pi
    use List ++
    use Nat toInt
    portal = bindQuery pq (pi (toInt showId) ++ pi (toInt season))
    (rows, _) = executeQueryPortal portal 0
    rows
 with
  Left _   -> Optional.None
  Right rs ->
    match rs with
      []       -> Optional.None
      raw +: _ -> Some raw

Tv.Tmdb.scoreShow : Text -> Optional Nat -> Optional Nat -> ShowResult -> Nat
Tv.Tmdb.scoreShow queryTitle queryYear hintTmdbId r =
  use Nat + - > >=
  use Optional None
  use Tmdb normalize
  use Universal eq
  q = normalize queryTitle
  t = normalize (ShowResult.name r)
  o = normalize (ShowResult.originalName r)
  exactMatch = eq q t || eq q o
  ovT = tokenOverlapPercent q t
  ovO = tokenOverlapPercent q o
  bestOv = if ovT > ovO then ovT else ovO
  titleScore =
    if exactMatch then 40
    else if bestOv >= 75 then 20 else if bestOv >= 50 then 10 else 0
  yearScore = match queryYear with
    None    -> 0
    Some py ->
      match releaseYear (ShowResult.firstAirDate r) with
        None    -> 0
        Some ry ->
          if eq ry py then 20
          else
            diff = if ry > py then ry - py else py - ry
            if eq diff 1 then 10 else 0
  idOk = match hintTmdbId with
    Some n -> eq n (ShowResult.tmdbId r)
    None   -> false
  idScore = if idOk then 50 else 0
  idScore + titleScore + yearScore

Tv.Tmdb.search :
  Text -> Text -> Optional Nat ->{IO} Either Text Tv.Tmdb.SearchResponse
Tv.Tmdb.search token title year =
  req = authedGet token (Tv.Tmdb.searchURI title year)
  match 
    catch do
      IO.Threads.run do
        unison_http_16_0_0.client.Http.run do
          resp = request req
          ok = unison_http_15_0_0.HttpResponse.ensureSuccess resp
          body = bodyText ok
          unison_json_1_4_2.Decoder.run Tv.Tmdb.SearchResponse.fromJson body
   with
    Right v -> Right v
    Left f  -> Left (Failure.message f)

Tv.Tmdb.SearchResponse.fromJson :
  '{unison_json_1_3_5.Decoder} Tv.Tmdb.SearchResponse
Tv.Tmdb.SearchResponse.fromJson =
  do
    results =
      Optional.getOrElse
        []
        (Decoder.optional!
          (object.at "results" (Decoder.array ShowResult.fromJson)))
    Tv.Tmdb.SearchResponse.SearchResponse results

Tv.Tmdb.SearchResponse.toJson : Tv.Tmdb.SearchResponse -> Json
Tv.Tmdb.SearchResponse.toJson r =
  Json.object
    [ ( "results"
      , Json.array
          (List.map ShowResult.toJson (Tv.Tmdb.SearchResponse.results r))
      )
    ]

Tv.Tmdb.searchURI : Text -> Optional Nat -> URI
Tv.Tmdb.searchURI title _year =
  use Path /
  use Query &
  path = Path.root / "3" / "search" / "tv"
  q = Query.empty & ("query", title)
  URI Scheme.https (Some Tmdb.apiAuthority) path (fromQuery q) Fragment.empty

Tv.Tmdb.Season.fromJson : '{unison_json_1_3_5.Decoder} Season
Tv.Tmdb.Season.fromJson =
  do
    use Decoder optional!
    use Optional getOrElse
    use object at
    season = getOrElse 0 (optional! (at "season_number" Decoder.nat))
    episodes =
      getOrElse
        [] (optional! (at "episodes" (Decoder.array EpisodeDetails.fromJson)))
    Season season episodes

test> Tv.Tmdb.Season.parse.test =
  match catch do
    unison_json_1_4_2.Decoder.run Season.fromJson exampleSeasonJson with
    Left f -> [Fail (Failure.message f)]
    Right s ->
      List.flatMap
        check
        [ Universal.eq (Season.season s) 1
        , Universal.eq (List.size (Season.episodes s)) 2
        , Universal.eq
            (Optional.map EpisodeDetails.title (episodeFor s 1)) (Some "Pilot")
        , Universal.eq
            (Optional.map EpisodeDetails.runtimeMin (episodeFor s 2))
            (Some Optional.None)
        , Universal.eq (episodeFor s 7) Optional.None
        ]

Tv.Tmdb.seasonRaw : Text -> Nat -> Nat ->{IO} Either Text Text
Tv.Tmdb.seasonRaw token showId season =
  req = authedGet token (seasonURI showId season)
  match 
    catch do
      IO.Threads.run do
        unison_http_16_0_0.client.Http.run do
          resp = request req
          ok = unison_http_15_0_0.HttpResponse.ensureSuccess resp
          bodyText ok
   with
    Right v -> Right v
    Left f  -> Left (Failure.message f)

Tv.Tmdb.seasonURI : Nat -> Nat -> URI
Tv.Tmdb.seasonURI showId season =
  use Nat toText
  use Path /
  path = Path.root / "3" / "tv" / toText showId / "season" / toText season
  URI
    Scheme.https
    (Some Tmdb.apiAuthority)
    path
    (fromQuery Query.empty)
    Fragment.empty

