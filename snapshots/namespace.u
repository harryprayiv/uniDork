Subs.fetchAndSaveByImdb :
  Text
  -> Nat
  -> Text
  -> FilePath
  -> Text
  -> [Text]
  ->{IO, Exception} [SaveOutcome]
Subs.fetchAndSaveByImdb apiKey delayMs imdbId targetDir baseName langs =
  use List map
  langsParam = languagesParam langs
  match withThrottle delayMs do searchByImdb apiKey imdbId langsParam with
    Left err   -> map (l -> Errored (normLang l) err) langs
    Right resp ->
      allFiles = allUnpackFiles resp
      map (saveOneLanguage delayMs targetDir baseName allFiles) langs

Subs.fetchAndSaveByTmdb :
  Text
  -> Nat
  -> Nat
  -> FilePath
  -> Text
  -> [Text]
  ->{IO, Exception} [SaveOutcome]
Subs.fetchAndSaveByTmdb apiKey delayMs tmdbId targetDir baseName langs =
  use List map
  langsParam = languagesParam langs
  match withThrottle delayMs do searchByTmdb apiKey tmdbId langsParam with
    Left err   -> map (l -> Errored (normLang l) err) langs
    Right resp ->
      allFiles = allUnpackFiles resp
      map (saveOneLanguage delayMs targetDir baseName allFiles) langs

Subs.Fix.checkOneRow :
  Optional Text
  -> [Text]
  -> Nat
  -> Boolean
  -> ((((Text, Text), Optional Text), Int), Optional Int)
  ->{IO, Exception} Nat
Subs.Fix.checkOneRow tokenOpt subLangs delayMs dryRun = cases
  ((((folderText, base), imdbOpt), tmdbInt), _) ->
    use Optional None
    use Text ++
    folder = FilePath folderText
    if Boolean.not (isDirectory folder) then
      _ = printLine ("  SKIP (folder gone, run move or sweep): " ++ folderText)
      0
    else
      missing = missingLangs folder base subLangs
      match missing with
        [] -> 0
        _ ->
          _ =
            printLine
              ("  "
                ++ base
                ++ " missing: "
                ++ Text.join ", " (List.map normLang missing))
          if dryRun then 1
          else
            match tokenOpt with
              None -> 0
              Some token ->
                tmdbNat = Optional.getOrElse 0 (Nat.fromInt tmdbInt)
                outcomes =
                  match imdbOpt with
                    Some imdb ->
                      fetchAndSaveByImdb token delayMs imdb folder base missing
                    None ->
                      fetchAndSaveByTmdb
                        token delayMs tmdbNat folder base missing
                _ = logSubOutcomes outcomes
                1

Subs.Fix.hasSidecarFor : [Text] -> Text -> Text -> Boolean
Subs.Fix.hasSidecarFor entries base lang =
  use Text ++
  prefix = base ++ "." ++ normLang lang ++ "."
  List.any (n -> startsWith prefix n) entries

Subs.Fix.missingLangs : FilePath -> Text -> [Text] ->{IO} [Text]
Subs.Fix.missingLangs folder base langs =
  match catch do directoryContents.texts folder with
    Left _ -> []
    Right entries ->
      List.filter (l -> Boolean.not (hasSidecarFor entries base l)) langs

Subs.Fix.run : Config -> Boolean ->{IO, Exception} ()
Subs.Fix.run cfg dryRun =
  use List size
  use Nat + toText
  use Optional None
  bufferRoot = buffer (paths cfg)
  subLangs = Tuning.subLangs (tuning cfg)
  delayMs = subDelayMs (tuning cfg)
  chunkLimit = Nat.toInt (subsChunk (tuning cfg))
  mountUp = match deviceOf bufferRoot with
    Some _ -> true
    None   -> false
  if Boolean.not mountUp then
    printLine ("[subs] buffer root not mounted, refusing: " Text.++ bufferRoot)
  else
    if Universal.eq (size subLangs) 0 then
      printLine "[subs] no languages configured (UNIDORK_TUNE_SUB_LANGS)"
    else
      tokenOpt = match catch do readSubToken cfg with
        Right t -> Some t
        Left _  -> None
      match (dryRun, tokenOpt) with
        (false, None) ->
          printLine
            ("[subs] no sub token readable at " Text.++ subToken (paths cfg))
        _ ->
          _ =
            if dryRun then printLine "[subs] DRY RUN: no files will be created"
            else ()
          fetchChunk lastId = 
            myPg.singleIO (toClientConfig cfg) do
              pqRows = prepareQuery selectBufferMoviesChunkSql
              rows =
                match 
                  catch do
                    use List ++
                    portal =
                      bindQuery
                        pqRows (pobi (Some lastId) ++ pobi (Some chunkLimit))
                    (rs, _) = executeQueryPortal portal 0
                    rs
                 with
                  Left f ->
                    use Text ++
                    _ =
                      printLine ("[subs] QUERY FAILED: " ++ Failure.message f)
                    []
                  Right rs -> rs
              _ = PreparedQuery.close pqRows
              rows
          checkRow counts = cases
            (((((_, folder), name), imdb), tmdb), yr) ->
              (c, f) = counts
              n =
                checkOneRow
                  tokenOpt
                  subLangs
                  delayMs
                  dryRun
                  ((((folder, name), imdb), tmdb), yr)
              (c + 1, f + n)
          loop lastId checked fetched =
            use Text ++
            rows = fetchChunk lastId
            match lastOf rows with
              None -> (checked, fetched)
              Some (((((fid, _), _), _), _), _) ->
                (c, f) = List.foldLeft checkRow (checked, fetched) rows
                _ =
                  printLine
                    ("[subs] chunk done ("
                      ++ toText (size rows)
                      ++ " movie(s), rss "
                      ++ toText rssMb()
                      ++ " MB)")
                loop fid c f
          (checked, fetched) = loop +0 0 0
          printLine
            ("[subs] done ("
              Text.++ toText checked
              Text.++ " checked, "
              Text.++ toText fetched
              Text.++ " with missing sidecars)")

Subs.Fix.selectBufferMoviesChunkSql :
  postgres.Query
    r
    (Int ->{g2, g3} Int ->{g, g1} r)
    (((((Int, Text), Text), Optional Text), Int), Optional Int)
Subs.Fix.selectBufferMoviesChunkSql =
  use Codec optional text
  use StatementBuilder var
  sql
    "SELECT f.file_id, f.proposed_folder, f.proposed_name, m.imdb_id, m.tmdb_id, m.year FROM files f JOIN associations a ON a.file_id = f.file_id JOIN movies m ON m.tmdb_id = a.tmdb_id WHERE f.stage = 'buffer' AND f.media_kind = 'movie' AND f.proposed_folder IS NOT NULL AND f.proposed_name IS NOT NULL AND f.file_id > "
    %% var bigint
    %% sql " ORDER BY f.file_id LIMIT "
    %% var bigint
    |> typedQuery
      (bigint ~ text ~ text ~ optional text ~ integer ~ optional integer)

Subs.freeUndPath : FilePath -> Text -> Text ->{IO, Exception} Optional FilePath
Subs.freeUndPath targetFolder base ext =
  go n =
    use Nat + >=
    use Text ++
    name =
      if Universal.eq n 1 then base ++ ".und" ++ ext
      else base ++ ".und." ++ Nat.toText n ++ ext
    fp = pathJoin targetFolder name
    if pathExists fp then if n >= 9 then Optional.None else go (n + 1)
    else Some fp
  go 1

Subs.harvestLocal : [Text] -> Text -> FilePath -> Text ->{IO, Exception} [Text]
Subs.harvestLocal langs sourceFolderText targetFolder base =
  use Failure message
  use List :+
  use Optional None
  use Text ++
  sourceFolder = FilePath sourceFolderText
  subs = collectLocalSubs sourceFolder
  step acc = cases
    (fp, name) ->
      ext = subExt name
      match detectLang langs name with
        Some l ->
          code = normLang l
          dest = pathJoin targetFolder (base ++ "." ++ code ++ ext)
          already = List.any (s -> Universal.eq s code) acc
          if pathExists dest then if already then acc else acc :+ code
          else
            match catch do renameFile fp dest with
              Right _ ->
                _ =
                  printLine
                    ("    SUB local " ++ code ++ " -> " ++ filePathText dest)
                if already then acc else acc :+ code
              Left f ->
                _ = printLine ("    SUB local move failed: " ++ message f)
                acc
        None ->
          match freeUndPath targetFolder base ext with
            None -> acc
            Some dest ->
              match catch do renameFile fp dest with
                Right _ ->
                  _ =
                    printLine
                      ("    SUB local (unknown lang) -> " ++ filePathText dest)
                  acc
                Left f ->
                  _ = printLine ("    SUB local move failed: " ++ message f)
                  acc
  List.foldLeft step [] subs

Subs.imdbSearchURI : Text -> Text -> Text -> URI
Subs.imdbSearchURI apiKey imdbId languages =
  use Path /
  use Query &
  path = Path.root / "api" / "v1" / "subtitles"
  q =
    Query.empty
      & ("api_key", apiKey)
      & ("type", "movie")
      & ("subs_per_page", "30")
      & ("unpack", "1")
      & ("imdb_id", imdbId)
      & ("languages", languages)
  URI Scheme.https (Some Subs.apiAuthority) path (fromQuery q) Fragment.empty

Subs.isFullSeason : SubtitleItem -> Boolean
Subs.isFullSeason item = match fullSeason item with
  Some true -> true
  _         -> false

Subs.isHi : SubtitleItem -> Boolean
Subs.isHi item = match SubtitleItem.hearingImpaired item with
  Some true -> true
  _         -> false

Subs.isSubtitleFile : Text -> Boolean
Subs.isSubtitleFile name =
  lower = Text.toLowercase name
  List.any (e -> endsWith e lower) subtitleExtensions

Subs.langAliasSet : Text -> [Text]
Subs.langAliasSet l =
  use List +:
  low = normLang l
  match toIso6392 low with
    Some iso3     -> distinctText (low +: (iso3 +: titleAliases iso3))
    Optional.None -> [low]

Subs.languageMatches : Text -> SubtitleItem -> Boolean
Subs.languageMatches target item = match SubtitleItem.language item with
  Optional.None -> false
  Some la       -> Universal.eq (normLang la) (normLang target)

Subs.languagesParam : [Text] -> Text
Subs.languagesParam langs = Text.join "," (List.map Text.toUppercase langs)

test> Subs.languagesParam.test =
  use Universal eq
  List.flatMap
    check
    [ eq (languagesParam ["en", "es", "th"]) "EN,ES,TH"
    , eq (languagesParam ["EN"]) "EN"
    , eq (languagesParam []) ""
    ]

Subs.looksRateLimited : Text -> Boolean
Subs.looksRateLimited e =
  lower = Text.toLowercase e
  containsText "429" lower || containsText "too many" lower
    || containsText "rate" lower

Subs.MovieResult.fromJson : '{unison_json_1_3_5.Decoder} MovieResult
Subs.MovieResult.fromJson = do
  use Decoder nat optional! text
  use object at at!
  imdbId = optional! (at "imdb_id" text)
  tmdbId = optional! (at "tmdb_id" nat)
  sdId = optional! (at "sd_id" nat)
  kind = at! "type" text
  name = at! "name" text
  year = optional! (at "year" nat)
  MovieResult imdbId tmdbId sdId kind name year

Subs.normLang : Text -> Text
Subs.normLang t = Text.toLowercase (Text.trim t)

test> Subs.parseMovieFields.test =
  match catch do
    unison_json_1_4_2.Decoder.run
      Subs.SearchResponse.fromJson exampleSearchJson with
    Left f -> [Fail (Failure.message f)]
    Right r ->
      match List.head (Subs.SearchResponse.results r) with
        Optional.None -> [Fail "no movie result"]
        Some m ->
          List.flatMap
            check
            [ Universal.eq (MovieResult.imdbId m) (Some "tt1375666")
            , Universal.eq (MovieResult.tmdbId m) (Some 27205)
            , Universal.eq (sdId m) (Some 123456)
            , Universal.eq (MovieResult.name m) "Inception"
            , Universal.eq (kind m) "movie"
            , Universal.eq (MovieResult.year m) (Some 2010)
            ]

test> Subs.parseShape.test =
  match catch do
    unison_json_1_4_2.Decoder.run
      Subs.SearchResponse.fromJson exampleSearchJson with
    Left f -> [Fail (Failure.message f)]
    Right r ->
      List.flatMap
        check
        [ SearchResponse.ok r
        , Universal.eq (List.size (Subs.SearchResponse.results r)) 1
        , Universal.eq (List.size (SearchResponse.subtitles r)) 3
        ]

test> Subs.parseUnpacked.test =
  match catch do
    unison_json_1_4_2.Decoder.run
      Subs.SearchResponse.fromJson exampleUnpackedJson with
    Left f  -> [Fail (Failure.message f)]
    Right r ->
      flat = allUnpackFiles r
      List.flatMap check [Universal.eq (List.size flat) 3]

test> Subs.pickBestDropsFullSeason.test =
  pack : SubtitleItem
  pack =
    SubtitleItem
      "Season Pack"
      "s1.zip"
      "/subtitle/pack.zip"
      (Some "EN")
      (Some false)
      (Some true)
      (Some 1)
      (Some 1)
      []
  match pickBestForMovie "EN" [pack] with
    Some _        -> [Fail "should have dropped the full-season pack"]
    Optional.None -> check true

test> Subs.pickBestEmpty.test = match pickBestForMovie "EN" [] with
  Some _        -> [Fail "empty input should yield None"]
  Optional.None -> check true

test> Subs.pickBestFallsBackToHi.test =
  use Optional None
  hi : SubtitleItem
  hi =
    SubtitleItem
      "HI release"
      "hi.srt"
      "/subtitle/x.zip"
      (Some "EN")
      (Some true)
      (Some false)
      None
      None
      []
  match pickBestForMovie "EN" [hi] with
    None -> [Fail "should have picked the HI track as fallback"]
    Some chosen ->
      check (Universal.eq (SubtitleItem.urlPath chosen) "/subtitle/x.zip")

Subs.pickBestForMovie : Text -> [SubtitleItem] -> Optional SubtitleItem
Subs.pickBestForMovie lang items =
  use List filter head
  notSeason = filter (i -> (if isFullSeason i then false else true)) items
  withLang = filter (languageMatches lang) notSeason
  pool = if Universal.eq (List.size withLang) 0 then notSeason else withLang
  nonHi = filter (i -> (if isHi i then false else true)) pool
  match head nonHi with
    Some s        -> Some s
    Optional.None -> head pool

test> Subs.pickBestLanguageFallback.test =
  use Optional None
  fr : SubtitleItem
  fr =
    SubtitleItem
      "Only French"
      "fr.srt"
      "/subtitle/fr.zip"
      (Some "FR")
      (Some false)
      (Some false)
      None
      None
      []
  match pickBestForMovie "EN" [fr] with
    None -> [Fail "should fall back to the full pool"]
    Some chosen ->
      check (Universal.eq (SubtitleItem.urlPath chosen) "/subtitle/fr.zip")

test> Subs.pickBestPrefersNonHi.test =
  match catch do
    unison_json_1_4_2.Decoder.run
      Subs.SearchResponse.fromJson exampleSearchJson with
    Left f -> [Fail (Failure.message f)]
    Right r ->
      use Universal eq
      subs = SearchResponse.subtitles r
      match pickBestForMovie "EN" subs with
        Optional.None -> [Fail "expected a pick"]
        Some chosen ->
          List.flatMap
            check
            [ eq (SubtitleItem.urlPath chosen) "/subtitle/1111-2222.zip"
            , eq (isHi chosen) false
            , eq (SubtitleItem.language chosen) (Some "EN")
            ]

test> Subs.pickUnpackFallsBackToHi.test =
  hi : UnpackFile
  hi = UnpackFile "fHI" "x.srt" "rel" "EN" "srt" true 100 "/subtitle/n/fHI"
  match pickUnpackForLanguage "EN" [hi] with
    Optional.None -> [Fail "should have picked the HI unpack as fallback"]
    Some chosen   -> check (Universal.eq (fileNId chosen) "fHI")

Subs.pickUnpackForLanguage : Text -> [UnpackFile] -> Optional UnpackFile
Subs.pickUnpackForLanguage lang files =
  use List filter head
  langMatches = filter (unpackLanguageMatches lang) files
  srtMatches = filter unpackIsSrt langMatches
  pool =
    if Universal.eq (List.size srtMatches) 0 then langMatches else srtMatches
  nonHi = filter (uf -> (if unpackIsHi uf then false else true)) pool
  match head nonHi with
    Some s        -> Some s
    Optional.None -> head pool

test> Subs.pickUnpackPicksEachLanguage.test =
  match catch do
    unison_json_1_4_2.Decoder.run
      Subs.SearchResponse.fromJson exampleUnpackedJson with
    Left f -> [Fail (Failure.message f)]
    Right r ->
      use Optional map
      use Universal eq
      flat = allUnpackFiles r
      en = pickUnpackForLanguage "EN" flat
      es = pickUnpackForLanguage "ES" flat
      th = pickUnpackForLanguage "TH" flat
      enId = map fileNId en
      esId = map fileNId es
      List.flatMap
        check
        [ eq enId (Some "fileEN1")
        , eq esId (Some "fileES1")
        , eq th Optional.None
        ]

test> Subs.pickUnpackPrefersNonHi.test =
  match catch do
    unison_json_1_4_2.Decoder.run
      Subs.SearchResponse.fromJson exampleUnpackedJson with
    Left f -> [Fail (Failure.message f)]
    Right r ->
      use Universal eq
      flat = allUnpackFiles r
      match pickUnpackForLanguage "EN" flat with
        Optional.None -> [Fail "expected an EN pick"]
        Some chosen ->
          List.flatMap
            check
            [ eq (fileNId chosen) "fileEN1"
            , eq (UnpackFile.hearingImpaired chosen) false
            , eq (UnpackFile.format chosen) "srt"
            ]

Subs.saveOneLanguage :
  Nat -> FilePath -> Text -> [UnpackFile] -> Text ->{IO, Exception} SaveOutcome
Subs.saveOneLanguage delayMs targetDir baseName allFiles lang =
  use Text ++
  langCode = normLang lang
  match pickUnpackForLanguage lang allFiles with
    Optional.None -> SaveOutcome.NotFound langCode
    Some uf       ->
      match withThrottle delayMs do downloadUnpackRaw uf with
        Left err   -> Errored langCode err
        Right body ->
          ext = normLang (UnpackFile.format uf)
          filename = baseName ++ "." ++ langCode ++ "." ++ ext
          path = pathJoin targetDir filename
          match catch do writeFileUtf8 path body with
            Left f  -> Errored langCode (Failure.message f)
            Right _ -> Saved langCode (filePathText path)

Subs.searchByImdb : Text -> Text -> Text ->{IO} Either Text Subs.SearchResponse
Subs.searchByImdb apiKey imdbId languages =
  req = searchRequestImdb apiKey imdbId languages
  match 
    catch do
      IO.Threads.run do
        unison_http_16_0_0.client.Http.run do
          resp = request req
          ok = unison_http_15_0_0.HttpResponse.ensureSuccess resp
          body = bodyText ok
          unison_json_1_4_2.Decoder.run Subs.SearchResponse.fromJson body
   with
    Right v -> Right v
    Left f  -> Left (Failure.message f)

Subs.searchByTmdb : Text -> Nat -> Text ->{IO} Either Text Subs.SearchResponse
Subs.searchByTmdb apiKey tmdbId languages =
  req = searchRequestTmdb apiKey tmdbId languages
