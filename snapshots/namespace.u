Tv.Resolve.resolveShowPick :
  Text
  -> [Text]
  -> Optional Text
  -> Tv.Resolve.FileRow
  -> Int
  ->{TvMetaApi, TvCatalog} Either Tv.Resolve.Outcome (Nat, Nat, Text)
Tv.Resolve.resolveShowPick token folders fileTitle row fid =
  use Optional None
  imdbCandidate = match hintImdbId row with
    Some i -> Some i
    None   -> imdbTagFromFolders folders
  imdbHint = match imdbCandidate with
    None      -> None
    Some imdb ->
      dbHit = lookupShowByImdbDb imdb
      match dbHit with
        Some sid -> Some sid
        None     ->
          apiHit = findShowByImdbApi imdb
          match apiHit with
            Right sid -> Some sid
            Left _    -> None
  match imdbHint with
    Some sid -> Right (sid, 95, "imdb_find")
    None ->
      rawTitle = match Tv.Resolve.FileRow.hintTitle row with
        Some t -> Some t
        None   -> fileTitle
      match rawTitle with
        None -> Left (NoShowHint fid)
        Some raw ->
          (cleaned, yearFromTitle) = cleanShowQuery raw
          yearOpt = match yearFromTitle with
            Some y -> Some y
            None   -> Tv.Resolve.FileRow.hintYear row
          if Universal.eq (Text.size cleaned) 0 then Left (NoShowHint fid)
          else
            searchResult = searchShows cleaned yearOpt
            match searchResult with
              Left err -> Left (NoShowMatch fid err)
              Right resp ->
                candidates = Tv.Tmdb.SearchResponse.results resp
                scored =
                  List.map
                    (r -> (r, scoreShow cleaned yearOpt None r)) candidates
                match pickBestShow scored with
                  None -> Left (NoShowMatch fid "no single high-scoring match")
                  Some (r, s) -> Right (ShowResult.tmdbId r, s, "title_year")

Tv.Resolve.rowToFile :
  ( ( ((((Int, Text), Optional Text), Optional Int), Optional Int),
    Optional Text),
    Text)
  -> Tv.Resolve.FileRow
Tv.Resolve.rowToFile = cases
  ((((((fid, oname), ht), hy), hsid), himdb), opath) ->
    Tv.Resolve.FileRow.FileRow
      fid oname ht (optIntToNat hy) (optIntToNat hsid) himdb opath

Tv.Resolve.run : Config ->{IO, Exception} ()
Tv.Resolve.run cfg = Tv.Resolve.runWith false cfg

Tv.Resolve.runWith : Boolean -> Config ->{IO, Exception} ()
Tv.Resolve.runWith dryRun cfg =
  use Nat +
  use Optional None
  use Text ++
  token = readTmdbToken cfg
  label = if dryRun then "[tv-identify] " else "[tv-resolve] "
  runChunk lastId = 
    myPg.singleIO (toClientConfig cfg) do
      pqFiles = prepareQuery selectUnresolvedTvChunkSql
      pqSearch = prepareQuery Tv.Tmdb.selectSearchSql
      pcSearch = prepareCommand Tv.Tmdb.upsertSearchSql
      pqShow = prepareQuery selectShowSql
      pcShow = prepareCommand upsertShowSql
      pqSeason = prepareQuery selectSeasonSql
      pcSeason = prepareCommand upsertSeasonSql
      pcEp = prepareCommand upsertEpisodeSql
      pcAssoc = prepareCommand upsertEpAssocSql
      pcDel = prepareCommand deleteFileAssocSql
      pqShowByImdb = prepareQuery selectShowByImdbSql
      rowsResult = catch do
        portal = bindQuery pqFiles (pobi (Some lastId))
        (rs, _) = executeQueryPortal portal 0
        rs
      rows = match rowsResult with
        Left f   ->
          _ = printLine (label ++ "QUERY FAILED: " ++ Failure.message f)
          []
        Right rs -> List.map Tv.Resolve.rowToFile rs
      metaGo = cases
        { r } -> r
        { searchShows title year -> k } ->
          handle
            k (Tv.Tmdb.cachedSearchWith pqSearch pcSearch token title year)
          with metaGo
        { showDetails showId -> k } ->
          handle k (cachedShowDetailsWith pqShow pcShow token showId)
          with metaGo
        { seasonFor showId season -> k } ->
          handle
            k (cachedSeasonWith pqSeason pcSeason pcEp token showId season)
          with metaGo
        { findShowByImdbApi imdb -> k } ->
          handle k (findShowByImdb token imdb) with metaGo
      catalogGo = cases
        { r } -> r
        { lookupShowByImdbDb imdb -> k } ->
          handle k (lookupShowByImdb pqShowByImdb imdb) with catalogGo
        { recordEpisodeMatch fid showId seasonNum eps conf source -> k } ->
          _ =
            Tv.Resolve.writeMatch
              pcAssoc pcDel fid showId seasonNum eps conf source
          handle k() with catalogGo
      runOne row =
        outcome =
          handle handle Tv.Resolve.resolveOne dryRun token row with catalogGo
          with metaGo
        Tv.Resolve.printOutcome outcome
      _ = Db.foreach_ runOne rows
      _ = PreparedQuery.close pqFiles
      _ = PreparedQuery.close pqSearch
      _ = PreparedCommand.close pcSearch
      _ = PreparedQuery.close pqShow
      _ = PreparedCommand.close pcShow
      _ = PreparedQuery.close pqSeason
      _ = PreparedCommand.close pcSeason
      _ = PreparedCommand.close pcEp
      _ = PreparedCommand.close pcAssoc
      _ = PreparedCommand.close pcDel
      _ = PreparedQuery.close pqShowByImdb
      match lastOf rows with
        Some lastRow ->
          Some (Tv.Resolve.FileRow.fileId lastRow, List.size rows)
        None -> None
  loop lastId done =
    match runChunk lastId with
      None -> done
      Some (nextId, n) ->
        _ =
          printLine
            (label
              ++ "chunk done ("
              ++ Nat.toText n
              ++ " file(s), cursor at file_id "
              ++ Int.toText nextId
              ++ ", rss "
              ++ Nat.toText rssMb()
              ++ " MB)")
        loop nextId (done + n)
  total = loop +0 0
  printLine
    (label
      ++ "done ("
      ++ Nat.toText total
      ++ " file(s)"
      ++ (if dryRun then ", no writes)" else ")"))

Tv.Resolve.selectUnresolvedTvChunkSql :
  postgres.Query
    r
    (Int ->{g, g1} r)
    ( ( ((((Int, Text), Optional Text), Optional Int), Optional Int),
      Optional Text),
      Text)
Tv.Resolve.selectUnresolvedTvChunkSql =
  use Codec optional text
  use Text ++
  sql
    "SELECT f.file_id, f.original_name, f.hint_title, f.hint_year, f.hint_show_tmdb_id, f.hint_imdb_id, f.original_path FROM files f LEFT JOIN episode_associations a ON a.file_id = f.file_id WHERE a.file_id IS NULL AND f.media_kind = 'episode' AND f.stage = 'staging' AND f.file_id > "
    %% StatementBuilder.var bigint
    %% sql (" ORDER BY f.file_id LIMIT " ++ Nat.toText resolveChunkSize)
    |> typedQuery
      (bigint
        ~ text
        ~ optional text
        ~ optional integer
        ~ optional integer
        ~ optional text
        ~ text)

Tv.Resolve.selectUnresolvedTvSql :
  postgres.Query
    r
    r
    ( ( ((((Int, Text), Optional Text), Optional Int), Optional Int),
      Optional Text),
      Text)
Tv.Resolve.selectUnresolvedTvSql =
  use Codec optional text
  sql
    "SELECT f.file_id, f.original_name, f.hint_title, f.hint_year, f.hint_show_tmdb_id, f.hint_imdb_id, f.original_path FROM files f LEFT JOIN episode_associations a ON a.file_id = f.file_id WHERE a.file_id IS NULL AND f.media_kind = 'episode' AND f.stage = 'staging'"
    |> typedQuery
      (bigint
        ~ text
        ~ optional text
        ~ optional integer
        ~ optional integer
        ~ optional text
        ~ text)

Tv.Resolve.upsertEpAssocSql :
  Command b (Int -> Int -> Int -> Int -> Int -> Text -> b)
Tv.Resolve.upsertEpAssocSql =
  use StatementBuilder var
  sql
    "INSERT INTO episode_associations (file_id, tmdb_show_id, season, episode, confidence, match_source) VALUES ("
    %% var bigint
    %% sql ", "
    %% var integer
    %% sql ", "
    %% var integer
    %% sql ", "
    %% var integer
    %% sql ", "
    %% var integer
    %% sql ", "
    %% var Codec.text
    %% sql
         ") ON CONFLICT (file_id, tmdb_show_id, season, episode) DO UPDATE SET confidence = EXCLUDED.confidence, match_source = EXCLUDED.match_source, associated_at = NOW()"
    |> buildCommand

Tv.Resolve.writeMatch :
  PreparedCommand r1 a1
  -> PreparedCommand r a
  -> Int
  -> Nat
  -> Nat
  -> [Nat]
  -> Nat
  -> Text
  ->{Postgres} ()
Tv.Resolve.writeMatch
  pcAssoc pcDel fileId showId seasonNum eps confidence source =
  _ = catch do bindAndExecuteCommand pcDel (pobi (Some fileId))
  one ep =
    use Db pi
    use List ++
    use Nat toInt
    _ = 
      catch do
        bindAndExecuteCommand
          pcAssoc
          (pobi (Some fileId)
            ++ pi (toInt showId)
            ++ pi (toInt seasonNum)
            ++ pi (toInt ep)
            ++ pi (toInt confidence)
            ++ pt source)
    ()
  Db.foreach_ one eps

Tv.Stage.collectVideos : FilePath -> Nat ->{IO, Exception} [Text]
Tv.Stage.collectVideos dir depth =
  use List ++ :+
  use Nat + >=
  use Universal eq
  entries = directoryContents.texts dir
  step acc n =
    if eq n "." then acc
    else
      if eq n ".." then acc
      else
        fp = pathJoin dir n
        if isDirectory fp then
          if depth >= maxDepth then acc
          else
            if isExtrasDir n then acc
            else acc ++ Tv.Stage.collectVideos fp (depth + 1)
        else
          if isVideo n && Boolean.not (isSampleName n) then
            acc :+ filePathText fp
          else acc
  List.foldLeft step [] entries

Tv.Stage.episodeHints :
  Text
  -> Text
  ->{IO, Exception} ( Optional Text,
    Optional Nat,
    Optional Nat,
    Optional Text,
    Optional Nat,
    Optional Nat)
Tv.Stage.episodeHints root videoPath =
  use List head
  use Optional None
  use Universal eq
  fileName = filePathBasename (FilePath videoPath)
  parsed = parseEpisodeName (basenameNoExt fileName)
  folders = relFolders root videoPath
  topFolderOpt = head folders
  folderParse = match topFolderOpt with
    None   -> None
    Some f -> parseShowFolder f
  folderTitle = Optional.map (cases (t, _) -> t) folderParse
  title = match parsed with
    Some p ->
      match titlePrefix p with
        Some t -> Some t
        None   -> folderTitle
    None   -> folderTitle
  year = match folderParse with
    Some (_, y) -> y
    None        -> None
  immediateFolder = parentDir (FilePath videoPath)
  showId =
    match readShowTmdbId immediateFolder with
      Some i -> Some i
      None ->
        match topFolderOpt with
          None -> None
          Some top ->
            topFp = pathJoin (FilePath root) top
            if eq (filePathText topFp) (filePathText immediateFolder) then None
            else readShowTmdbId topFp
  imdbId =
    match showId with
      Some _ -> None
      None ->
        match scanFolderForImdb immediateFolder with
          Some id -> Some id
          None ->
            match topFolderOpt with
              None -> None
              Some top ->
                topFp = pathJoin (FilePath root) top
                if eq (filePathText topFp) (filePathText immediateFolder) then
                  None
                else scanFolderForImdb topFp
  (seasonH, epH) =
    match parsed with
      Some p ->
        r = ParsedEpisode.ref p
        (Some (EpisodeRef.season r), head (EpisodeRef.episodes r))
      None   -> (None, None)
  (title, year, showId, imdbId, seasonH, epH)

Tv.Stage.isExtrasDir : Text -> Boolean
Tv.Stage.isExtrasDir name =
  lower = Text.toLowercase (Text.trim name)
  blocked =
    [ "featurettes"
    , "featuretts"
    , "extras"
    , "extra"
    , "special features"
    , "deleted scenes"
    , "behind the scenes"
    , "bonus"
    , "bonus features"
    , "interviews"
    , "trailers"
    , "trailer"
    , "samples"
    , "sample"
    , "subs"
    , "subtitles"
    , "proof"
    , "screens"
    , "screenshots"
    , "artwork"
    , "covers"
    , "@eadir"
    ]
  List.any (x -> Universal.eq x lower) blocked

Tv.Stage.isSampleName : Text -> Boolean
Tv.Stage.isSampleName n = match Text.indexOf "sample" (Text.toLowercase n) with
  Some _        -> true
  Optional.None -> false

Tv.Stage.maxDepth : Nat
Tv.Stage.maxDepth = 4

Tv.Stage.relFolders : Text -> Text -> [Text]
Tv.Stage.relFolders root fullPath =
  use List reverse
  use Nat >
  use Text ++ size
  prefix = root ++ "/"
  rel =
    if startsWith prefix fullPath then Text.drop (size prefix) fullPath
    else fullPath
  parts = List.filter (p -> size p > 0) (Text.split ?/ rel)
  match reverse parts with
    _ +: restRev -> reverse restRev
    []           -> []

test> Tv.Stage.relFolders.test =
  use Universal eq
  List.flatMap
    check
    [ eq
        (relFolders "/x" "/x/Show (2022)/Season 01/ep.mkv")
        ["Show (2022)", "Season 01"]
    , eq (relFolders "/x" "/x/Pack.S01.2160p/ep.mkv") ["Pack.S01.2160p"]
    , eq (relFolders "/x" "/x/loose.mkv") []
    ]

Tv.Stage.runChunk :
  Text
  -> Text
  -> PreparedCommand r1 a1
  -> PreparedCommand r a
  -> [((), Text)]
  ->{IO, Exception, Postgres} ()
Tv.Stage.runChunk root stage pcFiles pcGate chunk =
  results = forkChunk chunk
  Db.foreach_
    (cases
      (_, videoPath, outcome) ->
        match outcome with
          Left _ -> ()
          Right pr ->
            originalName = filePathBasename (FilePath videoPath)
            hints = episodeHints root videoPath
            _ =
              Tv.Stage.upsertFileWith
                pcFiles videoPath originalName hints stage pr
            mtime = match fileStat videoPath with
              Some (mt, _)  -> effectiveMtime videoPath mt
              Optional.None -> +0
            upsertProbeCacheWith pcGate videoPath mtime pr)
    results

Tv.Stage.runProbeAtTv : Config -> Text -> Text ->{IO, Exception} ()
Tv.Stage.runProbeAtTv cfg rootText stage =
  use Db foreach_
  use List foldLeft map size
  use Nat + - toText
  use PreparedCommand close
  use Text ++
  jobs = probeJobs (tuning cfg)
  root = FilePath rootText
  if isDirectory root then
    work = map (v -> ((), v)) (collectVideos root 0)
    _ =
      printLine
        ("[tv-probe] "
          ++ rootText
          ++ " ("
          ++ stage
          ++ "): "
          ++ toText (size work)
          ++ " video(s) found")
    toProbe = partitionWorkDb cfg work
    sumStep acc = cases (b, _) -> acc + b
    totalBytes = foldLeft sumStep 0 toProbe
    totalFiles = size toProbe
    _ =
      printLine
        (Text.join
          ""
          [ "[tv-probe] to probe: "
          , toText totalFiles
          , " ("
          , gigabytes totalBytes
          , "), cached: "
          , toText (size work - totalFiles)
          ])
    counter = IO.ref (0, 0)
    startEpoch = epochSeconds()
    chunks = List.chunk jobs toProbe
    groups = List.chunk (connChunks (tuning cfg)) chunks
    runGroup group = myPg.singleIO (toClientConfig cfg) do
      pcFiles = prepareCommand Tv.Stage.upsertFileSql
      pcGate = prepareCommand upsertProbeCacheSql
      probeChunk chunk =
        chunkBytes = foldLeft sumStep 0 chunk
        items = map (cases (_, item) -> item) chunk
        _ = Tv.Stage.runChunk rootText stage pcFiles pcGate items
        (dF, dB) = mutable.Ref.read counter
        _ = mutable.Ref.write counter (dF + size items, dB + chunkBytes)
        Progress.report "files" totalFiles totalBytes startEpoch counter
      _ = foreach_ probeChunk group
      _ = close pcFiles
      close pcGate
    _ = foreach_ runGroup groups
    printLine "[probe] done"
  else printLine ("[tv-probe] root not found: " ++ rootText)

Tv.Stage.runProbeTv : Config ->{IO, Exception} ()
Tv.Stage.runProbeTv cfg =
  _ = Tv.Db.createSchema cfg
  runProbeAtTv cfg (tvIntake (paths cfg)) "staging"

Tv.Stage.upsertFileSql :
  Command
    b
    (Text
    -> Int
    -> Text
    -> Text
    -> Float
    -> Text
    -> Int
    -> Int
    -> Int
    -> Text
    -> Optional Text
    -> Optional Int
    -> Optional Int
    -> Optional Text
    -> Optional Int
    -> Optional Int
    -> Text
    -> Text
    -> b)
Tv.Stage.upsertFileSql =
  use Codec optional text
  use StatementBuilder var
  sql
    "INSERT INTO files (crc32, size_bytes, original_path, original_name, duration_sec, video_codec, width, height, bit_depth, probe_json, hint_title, hint_year, hint_show_tmdb_id, hint_imdb_id, hint_season, hint_episode, stage, media_kind) VALUES ("
    %% var text
    %% sql ", "
    %% var bigint
    %% sql ", "
    %% var text
    %% sql ", "
    %% var text
    %% sql ", "
    %% var Codec.double
    %% sql ", "
    %% var text
    %% sql ", "
    %% var integer
    %% sql ", "
    %% var integer
    %% sql ", "
    %% var integer
    %% sql ", "
    %% var text
    %% sql ", "
    %% var (optional text)
    %% sql ", "
    %% var (optional integer)
    %% sql ", "
    %% var (optional integer)
    %% sql ", "
    %% var (optional text)
    %% sql ", "
    %% var (optional integer)
    %% sql ", "
    %% var (optional integer)
    %% sql ", "
    %% var text
    %% sql ", "
    %% var text
    %% sql
         ") ON CONFLICT (crc32, size_bytes) DO UPDATE SET original_path = EXCLUDED.original_path, original_name = EXCLUDED.original_name, duration_sec = EXCLUDED.duration_sec, video_codec = EXCLUDED.video_codec, width = EXCLUDED.width, height = EXCLUDED.height, bit_depth = EXCLUDED.bit_depth, probe_json = EXCLUDED.probe_json, hint_title = COALESCE(EXCLUDED.hint_title, files.hint_title), hint_year = COALESCE(EXCLUDED.hint_year, files.hint_year), hint_show_tmdb_id = COALESCE(EXCLUDED.hint_show_tmdb_id, files.hint_show_tmdb_id), hint_imdb_id = COALESCE(EXCLUDED.hint_imdb_id, files.hint_imdb_id), hint_season = COALESCE(EXCLUDED.hint_season, files.hint_season), hint_episode = COALESCE(EXCLUDED.hint_episode, files.hint_episode), stage = EXCLUDED.stage, media_kind = EXCLUDED.media_kind, probed_at = NOW()"
    |> buildCommand

Tv.Stage.upsertFileWith :
  PreparedCommand r a
  -> Text
  -> Text
  -> ( Optional Text,
    Optional Nat,
    Optional Nat,
    Optional Text,
    Optional Nat,
    Optional Nat)
  -> Text
  -> ProbeResult
  ->{Postgres} ()
Tv.Stage.upsertFileWith pc originalPath originalName hints stage pr =
  use Db pi
  use List ++
  use Nat toInt
  use Optional map
  (hintTitle, hintYear, hintShowId, hintImdb, hintSeason, hintEpisode) = hints
  vid = ProbeResult.video pr
  probeJson = Json.toText (ProbeResult.toJson pr)
  _ = 
    catch do
      bindAndExecuteCommand
        pc
        (pt (ProbeResult.crc32 pr)
          ++ pobi (Some (toInt (ProbeResult.sizeBytes pr)))
          ++ pt originalPath
          ++ pt originalName
          ++ pf (ProbeResult.durationSec pr)
          ++ pt (VideoInfo.codec vid)
          ++ pi (toInt (VideoInfo.width vid))
          ++ pi (toInt (VideoInfo.height vid))
          ++ pi (toInt (VideoInfo.bitDepth vid))
          ++ pt probeJson
          ++ pot hintTitle
          ++ poi (map toInt hintYear)
          ++ poi (map toInt hintShowId)
          ++ pot hintImdb
          ++ poi (map toInt hintSeason)
          ++ poi (map toInt hintEpisode)
          ++ pt stage
          ++ pt "episode")
  ()

Tv.Tmdb.authedGet : Text -> URI -> HttpRequest
Tv.Tmdb.authedGet token uri =
  use HttpRequest addHeader
  use Text ++
  HttpRequest.get uri
    |> addHeader "Authorization" ("Bearer " ++ token)
    |> addHeader "Accept" "application/json"

Tv.Tmdb.cachedSearchWith :
  PreparedQuery r1 a1 Text
  -> PreparedCommand r a
  -> Text
  -> Text
  -> Optional Nat
  ->{IO, Postgres} Either Text Tv.Tmdb.SearchResponse
Tv.Tmdb.cachedSearchWith pq pc token title year =
  key = yearKey year
  match readCachedWith pq Tv.Tmdb.SearchResponse.fromJson title key with
    Some cached   -> cached
    Optional.None ->
      result = Tv.Tmdb.search token title year
      _ = writeCachedWith pc Tv.Tmdb.SearchResponse.toJson title key result
      result

Tv.Tmdb.cachedSeasonWith :
  PreparedQuery r2 a2 Text
  -> PreparedCommand r1 a1
  -> PreparedCommand r a
  -> Text
  -> Nat
  -> Nat
  ->{IO, Postgres} Either Text Season
Tv.Tmdb.cachedSeasonWith pqSeason pcSeason pcEp token showId season =
  use Db pi
  use List ++
  use Nat toInt
  parse body =
    match catch do unison_json_1_4_2.Decoder.run Season.fromJson body with
      Right s -> Right s
      Left f  -> Left (Failure.message f)
  match readSeasonBodyWith pqSeason showId season with
    Some body -> parse body
    Optional.None ->
      match seasonRaw token showId season with
        Left err -> Left err
        Right body ->
          match parse body with
            Left e -> Left e
            Right s ->
              _ = 
                catch do
                  bindAndExecuteCommand
                    pcSeason
                    (pi (toInt showId) ++ pi (toInt season) ++ pt body)
              _ = writeEpisodesWith pcEp showId s
              Right s

Tv.Tmdb.cachedShowDetailsWith :
  PreparedQuery r1 a1 Text
  -> PreparedCommand r a
  -> Text
  -> Nat
  ->{IO, Postgres} Either Text ShowDetails
Tv.Tmdb.cachedShowDetailsWith pq pc token showId =
  parse body =
    match catch do unison_json_1_4_2.Decoder.run ShowDetails.fromJson body with
      Right d -> Right d
      Left f  -> Left (Failure.message f)
  match readShowBodyWith pq showId with
    Some body     -> parse body
    Optional.None ->
      match Tv.Tmdb.detailsRaw token showId with
        Left err   -> Left err
        Right body ->
          _ = writeShowBodyWith pc showId body
          parse body

Tv.Tmdb.contentRatingFromJson : '{unison_json_1_3_5.Decoder} (Text, Text)
Tv.Tmdb.contentRatingFromJson = do
  use Decoder text
  country = object.at! "iso_3166_1" text
  rating = Optional.getOrElse "" (Decoder.optional! (object.at "rating" text))
  (country, rating)

Tv.Tmdb.detailsRaw : Text -> Nat ->{IO} Either Text Text
Tv.Tmdb.detailsRaw token showId =
  req = authedGet token (Tv.Tmdb.detailsURI showId)
  match 
    catch do
      IO.Threads.run do
        unison_http_16_0_0.client.Http.run do
          resp = request req
          ok = unison_http_15_0_0.HttpResponse.ensureSuccess resp
          bodyText ok
   with
    Right v -> Right v
    Left f  -> Left (Failure.message f)

Tv.Tmdb.detailsURI : Nat -> URI
Tv.Tmdb.detailsURI showId =
  use Path /
  use Query &
  path = Path.root / "3" / "tv" / Nat.toText showId
  q =
    Query.empty
      & ("append_to_response", "external_ids,content_ratings,credits")
  URI Scheme.https (Some Tmdb.apiAuthority) path (fromQuery q) Fragment.empty

Tv.Tmdb.EpisodeDetails.fromJson : '{unison_json_1_3_5.Decoder} EpisodeDetails
Tv.Tmdb.EpisodeDetails.fromJson =
  do
    use Decoder nat optional! text
    use Optional getOrElse
    use object at at!
    episodeId = getOrElse 0 (optional! (at "id" nat))
    season = at! "season_number" nat
    episode = at! "episode_number" nat
    title = getOrElse "" (optional! (at "name" text))
    airDate = getOrElse "" (optional! (at "air_date" text))
    runtimeMin = optional! (at "runtime" nat)
    overview = getOrElse "" (optional! (at "overview" text))
    voteAverage = getOrElse 0.0 (optional! (at "vote_average" Decoder.float))
    voteCount = getOrElse 0 (optional! (at "vote_count" nat))
    EpisodeDetails
      episodeId
      season
      episode
      title
      airDate
      runtimeMin
      overview
      voteAverage
      voteCount

Tv.Tmdb.episodeFor : Season -> Nat -> Optional EpisodeDetails
Tv.Tmdb.episodeFor s epNum =
  List.find
    (e -> Universal.eq (EpisodeDetails.episode e) epNum) (Season.episodes s)

