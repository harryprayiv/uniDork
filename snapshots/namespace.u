    |> typedQuery bigint

Versions.insertVersionSql :
  Command
    b
    (Int
    ->{g10, g11} Text
    ->{g8, g9} Text
    ->{g6, g7} Int
    ->{g4, g5} Text
    ->{g2, g3} Boolean
