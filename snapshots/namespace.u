    |> HttpRequest.addHeader "Accept" "application/json"

Subs.SearchResponse.fromJson : '{unison_json_1_3_5.Decoder} Subs.SearchResponse
Subs.SearchResponse.fromJson =
  do
    use Decoder array optional!
    use Optional getOrElse
    use object at
    ok = object.at! "status" Decoder.boolean
    error = optional! (at "error" Decoder.text)
    results =
      getOrElse [] (optional! (at "results" (array MovieResult.fromJson)))
    subtitles =
      getOrElse [] (optional! (at "subtitles" (array SubtitleItem.fromJson)))
    Subs.SearchResponse.SearchResponse ok error results subtitles

Subs.subDirNames : [Text]
Subs.subDirNames = ["subs", "subtitles", "sub"]

Subs.subExt : Text -> Text
Subs.subExt name =
  lower = Text.toLowercase name
  match List.find (e -> endsWith e lower) subtitleExtensions with
    Some e        -> e
    Optional.None -> ""

Subs.subsInDir : FilePath -> Text ->{IO, Exception} [(FilePath, Text)]
Subs.subsInDir folder dirName =
  dfp = pathJoin folder dirName
  match catch do directoryContents.texts dfp with
    Left _ -> []
    Right es2 ->
      List.filterMap
        (n ->
          (if isSubtitleFile n then Some (pathJoin dfp n, n)
          else Optional.None))
        es2

