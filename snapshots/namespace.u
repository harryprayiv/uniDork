Tv.Tmdb.writeEpisodesWith :
  PreparedCommand r a -> Nat -> Season ->{Postgres} ()
Tv.Tmdb.writeEpisodesWith pcEp showId s =
  one ep =
    use Db pi
    use List ++
    use Nat toInt
    _ = 
      catch do
        bindAndExecuteCommand
          pcEp
          (pi (toInt showId)
            ++ pi (toInt (EpisodeDetails.season ep))
            ++ pi (toInt (EpisodeDetails.episode ep))
            ++ pt (EpisodeDetails.title ep)
            ++ pt (airDate ep)
            ++ poi (Optional.map toInt (EpisodeDetails.runtimeMin ep)))
    ()
  Db.foreach_ one (Season.episodes s)

Tv.Tmdb.writeShowBodyWith : PreparedCommand r a -> Nat -> Text ->{Postgres} ()
Tv.Tmdb.writeShowBodyWith pc showId body =
  match catch do unison_json_1_4_2.Decoder.run ShowDetails.fromJson body with
    Left _ -> ()
    Right d ->
      use List ++
      use Nat toInt
      use Optional None
      yearOpt = match releaseYear (ShowDetails.firstAirDate d) with
        Some y -> Some (toInt y)
        None   -> None
      tvdbText = Optional.map Nat.toText (tvdbId d)
      _ = 
        catch do
          bindAndExecuteCommand
            pc
            (Db.pi (toInt showId)
              ++ pot (ShowDetails.imdbId d)
              ++ pot tvdbText
              ++ pt (ShowDetails.name d)
              ++ pt (ShowDetails.originalName d)
              ++ pt (ShowDetails.originalLanguage d)
              ++ poi yearOpt
              ++ pt (ShowDetails.status d)
              ++ pt (ShowDetails.rating d)
              ++ pt body)
      ()

Tv.Tmdb.yearKey : Optional Nat -> Int
Tv.Tmdb.yearKey = cases
  Optional.None -> -1
  Some y        -> Nat.toInt y

uniDork.alreadyImported : PreparedQuery r a Text -> Text ->{Postgres} Boolean
uniDork.alreadyImported pq claimedCrc =
  if Universal.eq claimedCrc "" then false
  else
    match 
      catch do
        portal = bindQuery pq (pt claimedCrc)
        (rows, _) = executeQueryPortal portal 0
        rows
     with
      Left _   -> false
      Right rs ->
        match rs with
          _ +: _ -> true
          []     -> false

uniDork.batchedMain : Config -> Boolean -> Text ->{IO, Exception} ()
uniDork.batchedMain cfg force configPath =
  use List foldLeft size
  use Nat + toText
  use Text join
  configText = readFileUtf8 (FilePath configPath)
  dirs = List.filterMap parseConfigLine (lines configText)
  _ = Db.createSchema cfg
  _ = printLine "collecting folders..."
  folders = collectFolders dirs
  total = size folders
  _ = printLine (join "" ["found ", toText total, " folders to process"])
  sized = List.map (f -> (f, folderVideoBytes f)) folders
  sumStep acc = cases (_, b) -> acc + b
  totalBytes = foldLeft sumStep 0 sized
  _ =
    printLine
      (join
        ""
        [ "[import] plan: "
        , gigabytes totalBytes
        , " of video (already-imported folders skip fast)"
        ])
  counter = IO.ref (0, 0)
  startEpoch = epochSeconds()
  batches = List.chunk batchSize sized
  nBatches = size batches
  _ =
    printLine
      (join
        ""
        [ "processing in "
        , toText nBatches
        , " batches of (up to) "
        , toText batchSize
        ])
  step i batch =
    _ =
      runBatchSafe
        cfg force i nBatches total totalBytes startEpoch counter batch
    i + 1
  _ = foldLeft step 1 batches
  printLine "done"

uniDork.batchedRun : Config ->{IO, Exception} ()
uniDork.batchedRun cfg =
  args = getArgs()
  force = List.any (a -> Universal.eq a "--force") args
  nonFlag = List.filter (a -> Boolean.not (startsWith "--" a)) args
  configPath = match nonFlag with
    _ +: rest ->
      match rest with
        p +: _ -> p
        []     -> libraryConfig (paths cfg)
    []        -> libraryConfig (paths cfg)
  batchedMain cfg force configPath

uniDork.batchSize : Nat
uniDork.batchSize = 50

uniDork.collectFolders : [FilePath] ->{IO, Exception} [FilePath]
uniDork.collectFolders roots =
  use List +:
  use Universal eq
  addIfDir : FilePath -> [FilePath] -> Text ->{IO, Exception} [FilePath]
  addIfDir root acc name =
    if eq name "." then acc
    else
      if eq name ".." then acc
      else
        fp = pathJoin root name
        if isDirectory fp then fp +: acc else acc
  perRoot root =
    basenames = directoryContents.texts root
    _ =
      printLine
        (Text.join
          ""
          [ "scanning: "
          , filePathText root
          , " ("
          , Nat.toText (List.size basenames)
          , " entries)"
          ])
    List.reverse (List.foldLeft (addIfDir root) [] basenames)
  List.flatMap perRoot roots

uniDork.hasFlag : flag -> [flag] -> Boolean
uniDork.hasFlag flag flagArgs = List.any (a -> Universal.eq a flag) flagArgs

uniDork.nonFlags : [Text] -> [Text]
uniDork.nonFlags flagArgs =
  List.filter (a -> Boolean.not (startsWith "--" a)) flagArgs

uniDork.processBatch :
  Config
  -> Boolean
  -> Nat
  -> Nat
  -> Nat
  -> mutable.Ref {IO} (Nat, Nat)
  -> [(FilePath, Nat)]
  ->{IO, Exception} ()
uniDork.processBatch
  cfg force totalFolders totalBytes startEpoch counter folders = 
  myPg.singleIO (toClientConfig cfg) do
    use Nat +
    pqImported = prepareQuery selectImportedCrcSql
    pcFiles = prepareCommand Stage.upsertFileSql
    pcUpsert = prepareCommand upsertMovieSql
    pcVid = prepareCommand insertVideoSql
    pcDVid = prepareCommand (deleteChildSql "movie_video_streams")
    pcAud = prepareCommand insertAudioSql
    pcDAud = prepareCommand (deleteChildSql "movie_audio_tracks")
    pcSub = prepareCommand insertSubSql
    pcDSub = prepareCommand (deleteChildSql "movie_subtitles")
    pcAct = prepareCommand insertActorSql
    pcDAct = prepareCommand (deleteChildSql "movie_actors")
    pcGen = prepareCommand insertGenreSql
    pcDGen = prepareCommand (deleteChildSql "movie_genres")
    pcTag = prepareCommand insertTagSql
    pcDTag = prepareCommand (deleteChildSql "movie_tags")
    pcCou = prepareCommand insertCountrySql
    pcDCou = prepareCommand (deleteChildSql "movie_countries")
    pcStu = prepareCommand insertStudioSql
    pcDStu = prepareCommand (deleteChildSql "movie_studios")
    pcDir = prepareCommand insertDirectorSql
    pcDDir = prepareCommand (deleteChildSql "movie_directors")
    pcCre = prepareCommand insertCreditSql
    pcDCre = prepareCommand (deleteChildSql "movie_credits")
    oneWithProgress = cases
      (folder, bytes) ->
        _ =
          processOne
            cfg
            force
            pqImported
            pcFiles
            pcUpsert
            pcVid
            pcDVid
            pcAud
            pcDAud
            pcSub
            pcDSub
            pcAct
            pcDAct
            pcGen
            pcDGen
            pcTag
            pcDTag
            pcCou
            pcDCou
            pcStu
            pcDStu
            pcDir
            pcDDir
            pcCre
            pcDCre
            folder
        (dF, dB) = mutable.Ref.read counter
        _ = mutable.Ref.write counter (dF + 1, dB + bytes)
        Progress.report "folders" totalFolders totalBytes startEpoch counter
    _ = Db.foreach_ oneWithProgress folders
    _ = PreparedQuery.close pqImported
    _ = PreparedCommand.close pcFiles
    _ = PreparedCommand.close pcUpsert
    _ = PreparedCommand.close pcVid
    _ = PreparedCommand.close pcDVid
    _ = PreparedCommand.close pcAud
    _ = PreparedCommand.close pcDAud
    _ = PreparedCommand.close pcSub
    _ = PreparedCommand.close pcDSub
    _ = PreparedCommand.close pcAct
    _ = PreparedCommand.close pcDAct
    _ = PreparedCommand.close pcGen
    _ = PreparedCommand.close pcDGen
    _ = PreparedCommand.close pcTag
    _ = PreparedCommand.close pcDTag
    _ = PreparedCommand.close pcCou
    _ = PreparedCommand.close pcDCou
    _ = PreparedCommand.close pcStu
    _ = PreparedCommand.close pcDStu
    _ = PreparedCommand.close pcDir
    _ = PreparedCommand.close pcDDir
    _ = PreparedCommand.close pcCre
    PreparedCommand.close pcDCre

uniDork.processOne :
  Config
  -> Boolean
  -> PreparedQuery rI aI Text
  -> PreparedCommand rF aF
  -> PreparedCommand r20 a20
  -> PreparedCommand r19 a19
  -> PreparedCommand r18 a18
  -> PreparedCommand r17 a17
  -> PreparedCommand r16 a16
  -> PreparedCommand r15 a15
  -> PreparedCommand r14 a14
  -> PreparedCommand r13 a13
  -> PreparedCommand r12 a12
  -> PreparedCommand r11 a11
  -> PreparedCommand r10 a10
  -> PreparedCommand r9 a9
  -> PreparedCommand r8 a8
  -> PreparedCommand r7 a7
  -> PreparedCommand r6 a6
  -> PreparedCommand r5 a5
  -> PreparedCommand r4 a4
  -> PreparedCommand r3 a3
  -> PreparedCommand r2 a2
  -> PreparedCommand r1 a1
  -> PreparedCommand r a
  -> FilePath
  ->{IO, Exception, Postgres} ()
uniDork.processOne
  _cfg
  force
  pqImported
  pcFiles
  pcUpsert
  pcVid
  pcDVid
  pcAud
  pcDAud
  pcSub
  pcDSub
  pcAct
  pcDAct
  pcGen
  pcDGen
  pcTag
  pcDTag
  pcCou
  pcDCou
  pcStu
  pcDStu
  pcDir
  pcDDir
  pcCre
  pcDCre
  folder =
  use Optional None
  use Text ++
  use Universal eq
  folderName = filePathBasename folder
  claimedCrc = FolderMeta.checksum (parseFolderName folderName)
  claimedText = Optional.getOrElse "" claimedCrc
  skip = if force then false else alreadyImported pqImported claimedText
  if skip then printLine ("  skip (already imported): " ++ claimedText)
  else
    match processFolder folder with
      Left _ ->
        _ = printLine ("  no nfo: " ++ filePathText folder)
        ()
      Right m ->
        probeOutcome = match videoFilePath m with
          None         -> None
          Some vidPath ->
            match catch do probeWithCrc vidPath with
              Right (Right pr) -> Some (vidPath, pr)
              _                -> None
        match probeOutcome with
          None ->
            _ = printLine ("  WARN: no probe for " ++ claimedText)
            upsertWith
              pcUpsert
              pcVid
              pcDVid
              pcAud
              pcDAud
              pcSub
              pcDSub
              pcAct
              pcDAct
              pcGen
              pcDGen
              pcTag
              pcDTag
              pcCou
              pcDCou
              pcStu
              pcDStu
              pcDir
              pcDDir
              pcCre
              pcDCre
              None
              None
              None
              m
          Some (vidPath, pr) ->
            verifiedCrc = ProbeResult.crc32 pr
            verifiedSize = ProbeResult.sizeBytes pr
            originalName = filePathBasename (FilePath vidPath)
            _ =
              Stage.upsertFileWith
                pcFiles vidPath originalName (None, None, None) "library" pr
            _ =
              if eq claimedText "" then ()
              else
                if eq verifiedCrc claimedText then ()
                else
                  printLine
                    (Text.join
                      ""
                      [ "  CRC MISMATCH: folder claims ~"
                      , claimedText
                      , " but bytes hash to ~"
                      , verifiedCrc
                      , " (corrected in-place)"
                      ])
            actualRuntime = Some (durationSeconds (ProbeResult.durationSec pr))
            upsertWith
              pcUpsert
              pcVid
              pcDVid
              pcAud
              pcDAud
              pcSub
              pcDSub
              pcAct
              pcDAct
              pcGen
              pcDGen
              pcTag
              pcDTag
              pcCou
              pcDCou
              pcStu
              pcDStu
              pcDir
              pcDDir
              pcCre
              pcDCre
              (Some verifiedCrc)
              (Some verifiedSize)
              actualRuntime
              m

uniDork.renameNewCombined : Config -> Text -> Boolean -> '{IO, Exception} ()
uniDork.renameNewCombined cfg fullFormat dryRun =
  do
    use List reverse
    parts = Text.split ?/ fullFormat
    match reverse parts with
      [] ->
        _ = printLine "empty format"
        ()
      [_] ->
        _ =
          printLine
            "format must contain '/' separating folder and file templates"
        ()
      fileFmt +: folderParts ->
        folderFmt = Text.join "/" (reverse folderParts)
        runNew cfg folderFmt fileFmt dryRun ()

uniDork.runBatchSafe :
  Config
  -> Boolean
  -> Nat
  -> Nat
  -> Nat
  -> Nat
  -> Nat
  -> mutable.Ref {IO} (Nat, Nat)
  -> [(FilePath, Nat)]
  ->{IO, Exception} ()
uniDork.runBatchSafe
  cfg force i n totalFolders totalBytes startEpoch counter batch =
  use Nat toText
  use Text join
  _ =
    printLine
      (join
        ""
        [ "batch "
        , toText i
        , "/"
        , toText n
        , " ("
        , toText (List.size batch)
        , " folders)"
        ])
  match catch do
    processBatch cfg force totalFolders totalBytes startEpoch counter batch with
    Right _ -> ()
    Left f  -> printLine (join "" ["  BATCH FAILED: ", Failure.message f])

Versions.analyze : Optional Nat -> [MediaFacts] -> [Edition]
Versions.analyze canonicalMin facts =
  use Optional None getOrElse
  use Text ++
  use Versions nth
  clusters = clusterByCut facts
  runtimes = List.map clusterRuntimeSec clusters
  stdIdx = match pickStandardIndex canonicalMin runtimes with
    Some i -> Some i
    None   -> fallbackStandardIndex clusters
  stdRuntime = match stdIdx with
    Some i -> getOrElse 0.0 (nth i runtimes)
    None   -> 0.0
  defaultCrc = match stdIdx with
    Some i ->
      match nth i clusters with
        Some cl -> Optional.map MediaFacts.crc32 (bestByScore cl)
        None    -> None
    None   -> None
  build = cases
    (i, cluster) ->
      isStd = match stdIdx with
        Some s -> Universal.eq s i
        None   -> false
      rtSec = clusterRuntimeSec cluster
      key = "rt-" ++ Nat.toText (Versions.toMinutes rtSec)
      label = Versions.editionLabel cluster isStd rtSec stdRuntime
      members = List.map (assignMember defaultCrc) cluster
      Edition
        key label (getOrElse 0 (Float.toNat (Float.floor rtSec))) isStd members
  List.map build (Versions.withIndex clusters)

Versions.assignMember : Optional Text -> MediaFacts -> Assigned
Versions.assignMember defaultCrc f =
  isDef = match defaultCrc with
    Some c        -> Universal.eq c (MediaFacts.crc32 f)
    Optional.None -> false
  Assigned f (qualityScore f) (Versions.versionLabel f) isDef

Versions.bestByScore : [MediaFacts] -> Optional MediaFacts
Versions.bestByScore facts =
  use Nat >
  use Optional None
  step acc f =
    match acc with
      None -> Some f
      Some best ->
        if qualityScore f > qualityScore best then Some f else Some best
  List.foldLeft step None facts

Versions.canonicalMinFor :
  PreparedQuery r a Int -> Text ->{Postgres} Optional Nat
Versions.canonicalMinFor pq imdbId = match 
  catch do
    portal = bindQuery pq (pt imdbId)
    (rows, _) = executeQueryPortal portal 0
    rows
 with
  Left _   -> Optional.None
  Right rs ->
    match rs with
      sid +: _ -> Nat.fromInt sid
      []       -> Optional.None

Versions.canonicalMinSql : postgres.Query a (Text ->{g, g1} a) Int
Versions.canonicalMinSql =
  sql "SELECT m.runtime_min FROM movies m WHERE m.tmdb_id = CAST(NULLIF("
    %% StatementBuilder.var Codec.text
    %% sql ", '') AS INTEGER) AND m.runtime_min IS NOT NULL"
    |> typedQuery integer

Versions.clearAll : Config ->{IO, Exception} ()
Versions.clearAll cfg = myPg.singleIO (toClientConfig cfg) do
  pc = prepareCommand clearAllSql
  _ = catch do bindAndExecuteCommand pc []
  PreparedCommand.close pc

Versions.clearAllSql : Command a a
Versions.clearAllSql = sql "DELETE FROM movie_editions" |> buildCommand

Versions.clusterByCut : [MediaFacts] -> [[MediaFacts]]
Versions.clusterByCut facts =
  use List +: :+ map
  keyed = map (f -> (normalizedSeconds f, f)) facts
  sorted = map at2 (List.sort keyed)
  go acc f =
    match acc with
      [] -> [[f]]
      active +: rest ->
        match List.head active with
          Some anchor ->
            if relativeClose (normalizedSeconds anchor) (normalizedSeconds f) then
              active :+ f +: rest
            else [f] +: (active +: rest)
          Optional.None -> [f] +: rest
  List.reverse (List.foldLeft go [] sorted)

Versions.clusterRuntimeSec : [MediaFacts] -> Float
Versions.clusterRuntimeSec cluster =
  use Float + / <=
  total = List.foldLeft (acc f -> acc + normalizedSeconds f) 0.0 cluster
  n = Float.fromNat (List.size cluster)
  if n <= 0.0 then 0.0 else total / n

test> Versions.clusterSeparatesRealCut.test =
  use List size
  use Universal eq
  film = testFacts "AAA" 7200.0 23.976 1920 1080 8 "x264" "M.1999.1080p"
  pal = testFacts "BBB" 6900.0 25.0 1920 1080 8 "x264" "M.1999.PAL"
  ext = testFacts "CCC" 7680.0 23.976 1920 1080 8 "x264" "M.Extended"
  clusters = clusterByCut [film, pal, ext]
  sizes = List.sort (List.map size clusters)
  List.flatMap check [eq (size clusters) 2, eq sizes [1, 2]]

Versions.cutTokens : [(Text, Text)]
Versions.cutTokens =
  [ ("director", "Director's Cut")
  , ("extended", "Extended Cut")
  , ("unrated", "Unrated Cut")
  , ("theatrical", "Theatrical Cut")
  , ("ultimate", "Ultimate Cut")
  , ("final cut", "Final Cut")
  , ("remaster", "Remastered")
  , ("imax", "IMAX Edition")
  ]

test> Versions.defaultIsBestOfStandard.test =
  use List flatMap
  hd = testFacts "HD" 7200.0 23.976 1920 1080 8 "x264" "M.1080p"
  uhd = testFacts "UHD" 7200.0 23.976 3840 2160 10 "x265" "M.2160p"
  ext = testFacts "EXT" 7680.0 23.976 1920 1080 8 "x264" "M.Extended"
  editions = analyze (Some 120) [hd, uhd, ext]
  defaults =
    flatMap
      (e ->
        List.filterMap
          (a ->
            (if Assigned.isDefault a then Some (MediaFacts.crc32 (facts a))
            else Optional.None))
          (members e))
      editions
  flatMap check [Universal.eq defaults ["UHD"]]

Versions.editionLabel : [MediaFacts] -> Boolean -> Float -> Float -> Text
Versions.editionLabel cluster isStd rtSec stdRuntime =
  match editionTokenLabel cluster with
    Some t -> t
    Optional.None ->
      use Float >
      use Text ++
      mins = Nat.toText (Versions.toMinutes rtSec)
      if isStd then "Standard Cut (" ++ mins ++ "min)"
      else
        if rtSec > stdRuntime then "Extended Cut (" ++ mins ++ "min)"
        else "Alternate Cut (" ++ mins ++ "min)"

Versions.editionTokenLabel : [MediaFacts] -> Optional Text
Versions.editionTokenLabel cluster =
  names = List.map (f -> Text.toLowercase (MediaFacts.rawName f)) cluster
  hit = cases
    (needle, lbl) ->
      if List.any (n -> containsText needle n) names then Some lbl
      else Optional.None
  List.head (List.filterMap hit cutTokens)

Versions.factsForRow : LibRow -> Optional (Text, MediaFacts)
Versions.factsForRow row =
  pj = LibRow.probeJson row
  match catch do unison_json_1_4_2.Decoder.run ProbeResult.fromJson pj with
    Left _   -> Optional.None
    Right pr ->
      mf = factsFromProbe (LibRow.folderChecksum row) (LibRow.rawName row) pr
      Some (LibRow.tmdbId row, mf)

Versions.factsFromProbe : Text -> Text -> ProbeResult -> MediaFacts
Versions.factsFromProbe folderChecksum rawName pr =
  vid = ProbeResult.video pr
  (aCodec, aCh) =
    match ProbeResult.primaryAudio pr with
      Some a        -> (AudioInfo.codec a, AudioInfo.channels a)
      Optional.None -> ("", 0)
  MediaFacts
    folderChecksum
    (ProbeResult.crc32 pr)
    (ProbeResult.sizeBytes pr)
    (ProbeResult.durationSec pr)
    (VideoInfo.fps vid)
    (VideoInfo.width vid)
    (VideoInfo.height vid)
    (VideoInfo.bitDepth vid)
    (VideoInfo.codec vid)
    (VideoInfo.bitRate vid)
    aCodec
    aCh
    rawName

test> Versions.factsFromProbe.test =
  match catch do
    unison_json_1_4_2.Decoder.run RawProbe.fromJson exampleFfprobeJson with
    Left f -> [Fail (Failure.message f)]
    Right rp ->
      use Float < >
      use Universal eq
      pr = fromRaw "/movies/x.mkv" "ABCD1234" rp
      mf = factsFromProbe "FOLDERSUM" "M.1999.1080p" pr
      fps = MediaFacts.fps mf
      List.flatMap
        check
        [ eq (MediaFacts.folderChecksum mf) "FOLDERSUM"
        , eq (MediaFacts.crc32 mf) "ABCD1234"
        , eq (MediaFacts.sizeBytes mf) 2600000000
        , eq (MediaFacts.width mf) 1920
        , eq (MediaFacts.height mf) 1080
        , eq (MediaFacts.bitDepth mf) 10
        , eq (MediaFacts.videoCodec mf) "hevc"
        , eq (videoBitRate mf) (Some 5000000)
        , eq (audioCodec mf) "eac3"
        , eq (audioChannels mf) 6
        , eq (MediaFacts.rawName mf) "M.1999.1080p"
        , fps > 23.9
            && fps < 24.0
        ]

Versions.fallbackStandardIndex : [[MediaFacts]] -> Optional Nat
Versions.fallbackStandardIndex clusters =
  use Nat >
  use Optional None
  step acc = cases
    (i, cl) ->
      clScore = match bestByScore cl with
        Some f -> qualityScore f
        None   -> 0
      match acc with
        None -> Some (i, clScore)
        Some (bi, bs) ->
          if clScore > bs then Some (i, clScore) else Some (bi, bs)
  match List.foldLeft step None (Versions.withIndex clusters) with
    Some (i, _) -> Some i
    None        -> None

Versions.fetchMultiTmdbs : Config ->{IO, Exception} [Text]
Versions.fetchMultiTmdbs cfg = myPg.singleIO (toClientConfig cfg) do
  use Text ++
  pq = prepareQuery selectMultiTmdbSql
  tmdbsResult = catch do
    portal = bindQuery pq []
    (rs, _) = executeQueryPortal portal 0
    rs
  rs = match tmdbsResult with
    Left f   ->
      _ = printLine ("[versions] QUERY FAILED: " ++ Failure.message f)
      []
    Right rs -> rs
  _ = PreparedQuery.close pq
  rs

Versions.groupByTmdb : [(Text, MediaFacts)] -> [(Text, [MediaFacts])]
Versions.groupByTmdb pairs =
  step acc = cases (key, mf) -> upsertGroup key mf acc
  List.foldLeft step [] pairs

test> Versions.groupByTmdb.test =
  a = testFacts "A" 7200.0 23.976 1920 1080 8 "x264" "a"
  b = testFacts "B" 7200.0 23.976 1920 1080 8 "x264" "b"
  c = testFacts "C" 7200.0 23.976 3840 2160 10 "x265" "c"
  grouped = groupByTmdb [("100", a), ("200", b), ("100", c)]
  List.flatMap check [Universal.eq grouped [("100", [a, c]), ("200", [b])]]

