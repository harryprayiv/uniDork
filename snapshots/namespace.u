Db.upsertMovieSql :
  Command
    b
    (Text
    ->{g54, g55} Optional Text
    ->{g52, g53} Optional Int
    ->{g50, g51} Optional Text
    ->{g48, g49} Optional Text
    ->{g46, g47} Optional Text
    ->{g44, g45} Text
    ->{g42, g43} Text
    ->{g40, g41} Text
    ->{g38, g39} Optional Text
    ->{g36, g37} Optional Int
    ->{g34, g35} Float
    ->{g32, g33} Int
    ->{g30, g31} Text
    ->{g28, g29} Optional Int
    ->{g26, g27} Text
    ->{g24, g25} Text
    ->{g22, g23} Optional Text
    ->{g20, g21} Optional Text
    ->{g18, g19} Optional Text
    ->{g16, g17} Optional Int
    ->{g14, g15} Optional Text
    ->{g12, g13} Optional Text
    ->{g10, g11} Optional Text
    ->{g8, g9} Optional Text
    ->{g6, g7} Optional Int
    ->{g4, g5} Optional Int
    ->{g2, g3} Optional Int
    ->{g, g1} b)
