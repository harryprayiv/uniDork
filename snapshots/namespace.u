test> Resolve.resolveOne.search.test =
  use Optional None
  use Universal eq
  result =
    Tmdb.Result.Result 500 "The Matrix" "The Matrix" "en" "1999-03-31" 9.0 ""
  scriptedMeta = cases
    { r } -> r
    { movieDetails _ -> k } -> handle k (Right testDetails) with scriptedMeta
    { searchMovies _ _ -> k } ->
      handle k (Right (Tmdb.SearchResponse.SearchResponse [result]))
      with scriptedMeta
  recordingCatalog = cases
    { r }                                 -> (r, None)
    { recordMatch fid tid conf src -> k } ->
      (res, _) = handle k() with recordingCatalog
      (res, Some (fid, tid, conf, src))
  row =
    Resolve.FileRow.FileRow +9 "The.Matrix.1999.1080p.mkv" 0.0 None None None
  (outcome, written) =
    handle handle Resolve.resolveOne false "tok" row with recordingCatalog
    with scriptedMeta
  matched = match outcome with
    ResolvedBySearch fid tid _ -> eq fid +9 && eq tid 500
    _                          -> false
  wroteSomething = match written with
    Some (fid, tid, _, src) -> eq fid +9 && eq tid 500 && eq src "title_year"
    None                    -> false
  List.flatMap check [matched, wroteSomething]

Resolve.rowToFile :
  (((((Int, Text), Float), Optional Text), Optional Int), Optional Int)
  -> Resolve.FileRow
Resolve.rowToFile = cases
  (((((fid, oname), dur), ht), hy), htm) ->
    Resolve.FileRow.FileRow fid oname dur ht (optIntToNat hy) (optIntToNat htm)

Resolve.runWith : Boolean -> Config ->{IO, Exception} ()
Resolve.runWith dryRun cfg =
  use Nat +
  use Optional None
  use Text ++
  token = readTmdbToken cfg
  label = if dryRun then "[identify] " else "[resolve] "
  runChunk lastId = 
    myPg.singleIO (toClientConfig cfg) do
      pqFiles = prepareQuery selectUnresolvedChunkSql
      pqSearch = prepareQuery Tmdb.selectSearchSql
      pcSearch = prepareCommand Tmdb.upsertSearchSql
      pqDet = prepareQuery selectDetailsSql
      pcDet = prepareCommand upsertDetailsSql
      pcAssoc = prepareCommand upsertAssociationSql
      pcDelOther = prepareCommand deleteOtherAssociationsSql
      rowsResult = catch do
        portal = bindQuery pqFiles (pobi (Some lastId))
        (rs, _) = executeQueryPortal portal 0
        rs
      rows = match rowsResult with
        Left f   ->
          _ = printLine (label ++ "QUERY FAILED: " ++ Failure.message f)
          []
        Right rs -> List.map Resolve.rowToFile rs
      metaGo = cases
        { r } -> r
        { movieDetails tmdbId -> k } ->
          handle k (cachedDetailsWith pqDet pcDet token tmdbId) with metaGo
        { searchMovies title year -> k } ->
          handle k (Tmdb.cachedSearchWith pqSearch pcSearch token title year)
          with metaGo
      catalogGo = cases
        { r }                                          -> r
        { recordMatch fileId tmdbId conf source -> k } ->
          _ = Resolve.writeMatch pcAssoc pcDelOther fileId tmdbId conf source
          handle k() with catalogGo
      runOne row =
        outcome =
          handle handle Resolve.resolveOne dryRun token row with catalogGo
          with metaGo
        Resolve.printOutcome outcome
      _ = Db.foreach_ runOne rows
      _ = PreparedQuery.close pqFiles
      _ = PreparedQuery.close pqSearch
      _ = PreparedQuery.close pqDet
      _ = PreparedCommand.close pcSearch
      _ = PreparedCommand.close pcDet
      _ = PreparedCommand.close pcAssoc
      _ = PreparedCommand.close pcDelOther
      match lastOf rows with
        Some lastRow -> Some (Resolve.FileRow.fileId lastRow, List.size rows)
        None         -> None
  loop lastId done =
    match runChunk lastId with
      None -> done
      Some (nextId, n) ->
        _ =
          printLine
            (label
              ++ "chunk done ("
              ++ Nat.toText n
              ++ " file(s), cursor at file_id "
              ++ Int.toText nextId
              ++ ", rss "
              ++ Nat.toText rssMb()
              ++ " MB)")
        loop nextId (done + n)
  total = loop +0 0
  printLine
    (label
      ++ "done ("
      ++ Nat.toText total
      ++ " file(s)"
      ++ (if dryRun then ", no writes)" else ")"))

Resolve.selectUnresolvedChunkSql :
  postgres.Query
    r
    (Int ->{g, g1} r)
    (((((Int, Text), Float), Optional Text), Optional Int), Optional Int)
Resolve.selectUnresolvedChunkSql =
  use Codec optional text
  use Text ++
  sql
    "SELECT f.file_id, f.original_name, f.duration_sec, f.hint_title, f.hint_year, f.hint_tmdb_id FROM files f LEFT JOIN associations a ON a.file_id = f.file_id WHERE a.file_id IS NULL AND f.stage <> 'buffer' AND f.media_kind = 'movie' AND f.file_id > "
    %% StatementBuilder.var bigint
    %% sql (" ORDER BY f.file_id LIMIT " ++ Nat.toText resolveChunkSize)
    |> typedQuery
      (bigint
        ~ text
        ~ Codec.double
        ~ optional text
        ~ optional integer
        ~ optional integer)

Resolve.selectUnresolvedSql :
  postgres.Query
    r r (((((Int, Text), Float), Optional Text), Optional Int), Optional Int)
Resolve.selectUnresolvedSql =
  use Codec optional text
  sql
    "SELECT f.file_id, f.original_name, f.duration_sec, f.hint_title, f.hint_year, f.hint_tmdb_id FROM files f LEFT JOIN associations a ON a.file_id = f.file_id WHERE a.file_id IS NULL AND f.stage <> 'buffer' AND f.media_kind = 'movie'"
    |> typedQuery
      (bigint
        ~ text
        ~ Codec.double
        ~ optional text
        ~ optional integer
        ~ optional integer)

Resolve.upsertAssociationSql :
  Command b (Int ->{g6, g7} Int ->{g4, g5} Int ->{g2, g3} Text ->{g, g1} b)
Resolve.upsertAssociationSql =
  use StatementBuilder var
  sql
    "INSERT INTO associations (file_id, tmdb_id, confidence, match_source) VALUES ("
    %% var bigint
    %% sql ", "
    %% var integer
    %% sql ", "
    %% var integer
    %% sql ", "
    %% var Codec.text
    %% sql
         ") ON CONFLICT (file_id, tmdb_id) DO UPDATE SET confidence = EXCLUDED.confidence, match_source = EXCLUDED.match_source, associated_at = NOW()"
    |> buildCommand

Resolve.writeMatch :
  PreparedCommand r1 a1
  -> PreparedCommand r a
  -> Int
  -> Nat
  -> Nat
  -> Text
  ->{Postgres} ()
Resolve.writeMatch pcAssoc pcDelOther fileId tmdbId confidence source =
  use Db pi
  use List ++
  use Nat toInt
  _ = 
    catch do
      bindAndExecuteCommand
        pcDelOther (pobi (Some fileId) ++ pi (toInt tmdbId))
  _ = 
    catch do
      bindAndExecuteCommand
        pcAssoc
        (pobi (Some fileId)
          ++ pi (toInt tmdbId)
          ++ pi (toInt confidence)
          ++ pt source)
  ()

