Tv.Tmdb.ShowDetails.fromJson : '{unison_json_1_3_5.Decoder} ShowDetails
Tv.Tmdb.ShowDetails.fromJson =
  do
    use Decoder array nat optional! text
    use List find
    use Nat >
    use Optional None getOrElse
    use Text size
    use Universal eq
    use object at at!
    tmdbId = at! "id" nat
    name = at! "name" text
    originalName = getOrElse "" (optional! (at "original_name" text))
    originalLanguage = getOrElse "" (optional! (at "original_language" text))
    overview = getOrElse "" (optional! (at "overview" text))
    firstAirDate = getOrElse "" (optional! (at "first_air_date" text))
    status = getOrElse "" (optional! (at "status" text))
    numberOfSeasons = getOrElse 0 (optional! (at "number_of_seasons" nat))
    genres = getOrElse [] (optional! (at "genres" (array namedObjectFromJson)))
    ratings =
      getOrElse
        []
        (optional!
          (at "content_ratings" do at! "results" (array contentRatingFromJson)))
    hasRating = cases (_, r) -> size r > 0
    usRating = cases (c, r) -> eq c "US" && size r > 0
    rating = match find usRating ratings with
      Some (_, r) -> r
      None        ->
        match find hasRating ratings with
          Some (_, r) -> r
          None        -> ""
    rawImdb =
      getOrElse "" (optional! (at "external_ids" do at! "imdb_id" text))
    imdbId = if eq (size rawImdb) 0 then None else Some rawImdb
    tvdbId = optional! (at "external_ids" do at! "tvdb_id" nat)
    voteAverage = getOrElse 0.0 (optional! (at "vote_average" Decoder.float))
    voteCount = getOrElse 0 (optional! (at "vote_count" nat))
    networks =
      getOrElse [] (optional! (at "networks" (array namedObjectFromJson)))
    cast =
      getOrElse
        [] (optional! (at "credits" do at! "cast" (array CastMember.fromJson)))
    ShowDetails
      tmdbId
      name
      originalName
      originalLanguage
      overview
      firstAirDate
      status
      numberOfSeasons
      genres
      rating
      imdbId
      tvdbId
      voteAverage
      voteCount
      networks
      cast

Tv.Tmdb.ShowResult.fromJson : '{unison_json_1_3_5.Decoder} ShowResult
Tv.Tmdb.ShowResult.fromJson =
  do
    use Decoder optional! text
    use Optional getOrElse
    use object at at!
    tmdbId = at! "id" Decoder.nat
    name = at! "name" text
    originalName = getOrElse "" (optional! (at "original_name" text))
    originalLanguage = getOrElse "" (optional! (at "original_language" text))
    firstAirDate = getOrElse "" (optional! (at "first_air_date" text))
    popularity = getOrElse 0.0 (optional! (at "popularity" Decoder.float))
    overview = getOrElse "" (optional! (at "overview" text))
    ShowResult
      tmdbId
      name
      originalName
      originalLanguage
      firstAirDate
      popularity
      overview

Tv.Tmdb.ShowResult.toJson : ShowResult -> Json
Tv.Tmdb.ShowResult.toJson r =
  use Json text
  Json.object
    [ ("id", Json.nat (ShowResult.tmdbId r))
    , ("name", text (ShowResult.name r))
    , ("original_name", text (ShowResult.originalName r))
    , ("original_language", text (ShowResult.originalLanguage r))
    , ("first_air_date", text (ShowResult.firstAirDate r))
    , ("popularity", Json.float (ShowResult.popularity r))
    , ("overview", text (ShowResult.overview r))
    ]

