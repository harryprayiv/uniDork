Move.moveFolder : Boolean -> Text -> FilePath ->{IO, MovieMoveCatalog, Exception} ()   ~aau8q91ffs
  ! aborts (prints, does nothing) if the destination is not under the library root OR already exists; it can never overwrite an existing library folder.
  ! on a real (non-dry) run it transfers then DELETES the source folder from the buffer; on dry-run it prints the plan and touches nothing.
  ! runs under the MovieMoveCatalog ability: the files-row path update is an ability call interpreted at the run boundary, not a direct DB write here.

Move.partialRoot : Text -> Text   ~2va75luao3

Move.planOne : Text -> Optional a -> FilePath ->{IO, Exception} ()   ~dgq1rebcfa

Move.printProgress : Nat -> Nat -> Nat -> mutable.Ref g (Nat, Nat) ->{g, IO, Exception} ()   ~pkshru0r1r

Move.removeFolderTree : Text ->{IO} Either Text ()   ~hkp4ikr7ho
  ! shells out to `rm -rf --`; this is the one place the system recursively deletes a tree.
  ! refuses to run on '', '/', or any non-absolute path (must startWith '/'), returning Left rather than executing. This guard is the backstop against a catastrophic rm.
  ! a nonzero rm exit is returned as Left with the captured stderr, not raised.

Move.rmdirFolder : Text ->{IO} ()   ~ht3pscpian

Move.rowToIdentity : (((Int, Text), Int), Text) -> FileIdentity   ~h79f8ctm92

Move.rsyncFolder : Text -> Text ->{IO} Either Text ()   ~lh57b8sisj

Move.run : Config -> Optional Text -> Boolean ->{IO, Exception} ()   ~62hif2osdt
  ! processes buffer folders in chunks of moveChunkSize (25), opening a fresh prepared-statement set per chunk inside its own singleIO connection; a crash in one chunk does not corrupt the connection used by others.
  ! calls sweepPartial(libraryRoot) once before any real transfer to clear crashed-partial debris (skipped on dry-run).
  ! a single-folder name argument is validated against '', '.', '..' and refused if invalid; the no-argument form promotes every buffer subdirectory.

Move.sameDevice : Text -> Text ->{IO} Boolean   ~phl4vdn43c
  ! compares `stat %d` device numbers of the two paths; equal device -> true.
  ! if EITHER stat fails it returns false, deliberately choosing the safer cross-device (rsync-partial) path over risking a non-atomic rename.

Move.selectFileByPathSql : postgres.Query a (Text ->{g, g1} a) (((Int, Text), Int), Text)   ~9c3o518g4i

Move.sweepPartial : Text ->{IO, Exception} ()   ~hqr529bm0s

Move.transferFolder : Boolean -> Text -> Text -> Text ->{IO, Exception} Boolean   ~tvetsc0t9r
  ! branches on sameDev: same device -> atomic commitFolder; cross device -> rsync to partialRoot, then commitFolder, then removeFolderTree on the source.
  ! on a cross-device ABORT (rsync or commit fails) the source is LEFT INTACT and false is returned; only a fully successful commit triggers source deletion.
  ! source-cleanup failure after a successful commit is a WARN, not a failure: the file is already safely in the library, so a leftover source is logged and tolerated (returns true).

Move.updateFilePathSql : Command a (Text ->{g6, g7} Text ->{g4, g5} Text ->{g2, g3} Int ->{g, g1} a)   ~reqgc43nrl

Move.updateMovieFile : Text -> Text -> Text -> Boolean -> Optional FileIdentity ->{IO, MovieMoveCatalog, Exception} ()   ~n4qqos6hf7

Move.verifyFile : Text ->{IO, MovieMoveCatalog, Exception} (Text, Boolean, Optional FileIdentity)   ~8mmodrjaqp
  ! verified == (file exists in files table by path) AND (on-disk size == stored size_bytes). It does NOT re-hash; a size match means the stored CRC is trusted as-is (see decision IdentityVerifiedBySizeNotByRehash).
  ! a missing files row or a stat failure yields (path, false, ...) and routes the caller to a name-based update with a WARN.

